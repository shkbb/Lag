<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:Lag.Core"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="Lag.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <!-- Theme-invariant tokens (radii, fonts, logo geometry) -->
      <ResourceInclude Source="avares://Lag/Themes/Tokens.axaml" />
      <!-- Per-variant colour palette (Dark + warm "cream" Light) — consumed via {DynamicResource} -->
      <ResourceInclude Source="avares://Lag/Themes/Palette.axaml" />
    </ResourceDictionary.MergedDictionaries>
    <core:BoolToStringConverter x:Key="BoolToString" />
    <core:LanguageToFlagConverter x:Key="LangFlag" />

    <!-- ═══════════ Vector language flags (no emoji/bitmaps — crisp at any DPI) ═══════════ -->
    <!-- All drawn in a 30×20 coordinate space and stretched by the Image that hosts them. -->

    <!-- English — Union Jack (simplified: diagonals + cross via stroked lines) -->
    <DrawingImage x:Key="Flag_en">
      <DrawingGroup>
        <GeometryDrawing Brush="#012169" Geometry="M0,0 H30 V20 H0 Z" />
        <GeometryDrawing Geometry="M0,0 L30,20 M30,0 L0,20">
          <GeometryDrawing.Pen>
            <Pen Brush="White" Thickness="4.5" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M0,0 L30,20 M30,0 L0,20">
          <GeometryDrawing.Pen>
            <Pen Brush="#C8102E" Thickness="1.8" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M15,0 V20 M0,10 H30">
          <GeometryDrawing.Pen>
            <Pen Brush="White" Thickness="6" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M15,0 V20 M0,10 H30">
          <GeometryDrawing.Pen>
            <Pen Brush="#C8102E" Thickness="3.4" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage>

    <!-- Українська — blue over yellow -->
    <DrawingImage x:Key="Flag_uk">
      <DrawingGroup>
        <GeometryDrawing Brush="#0057B7" Geometry="M0,0 H30 V10 H0 Z" />
        <GeometryDrawing Brush="#FFD700" Geometry="M0,10 H30 V20 H0 Z" />
      </DrawingGroup>
    </DrawingImage>

    <!-- Deutsch — black / red / gold -->
    <DrawingImage x:Key="Flag_de">
      <DrawingGroup>
        <GeometryDrawing Brush="#000000" Geometry="M0,0 H30 V6.67 H0 Z" />
        <GeometryDrawing Brush="#DD0000" Geometry="M0,6.67 H30 V13.33 H0 Z" />
        <GeometryDrawing Brush="#FFCE00" Geometry="M0,13.33 H30 V20 H0 Z" />
      </DrawingGroup>
    </DrawingImage>

    <!-- Français — blue / white / red -->
    <DrawingImage x:Key="Flag_fr">
      <DrawingGroup>
        <GeometryDrawing Brush="#002395" Geometry="M0,0 H10 V20 H0 Z" />
        <GeometryDrawing Brush="#FFFFFF" Geometry="M10,0 H20 V20 H10 Z" />
        <GeometryDrawing Brush="#ED2939" Geometry="M20,0 H30 V20 H20 Z" />
      </DrawingGroup>
    </DrawingImage>

    <!-- Беларуская — white / red / white -->
    <DrawingImage x:Key="Flag_be">
      <DrawingGroup>
        <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H30 V6.67 H0 Z" />
        <GeometryDrawing Brush="#E10000" Geometry="M0,6.67 H30 V13.33 H0 Z" />
        <GeometryDrawing Brush="#FFFFFF" Geometry="M0,13.33 H30 V20 H0 Z" />
      </DrawingGroup>
    </DrawingImage>

    <!-- Lietuvių — yellow / green / red -->
    <DrawingImage x:Key="Flag_lt">
      <DrawingGroup>
        <GeometryDrawing Brush="#FDB913" Geometry="M0,0 H30 V6.67 H0 Z" />
        <GeometryDrawing Brush="#006A44" Geometry="M0,6.67 H30 V13.33 H0 Z" />
        <GeometryDrawing Brush="#C1272D" Geometry="M0,13.33 H30 V20 H0 Z" />
      </DrawingGroup>
    </DrawingImage>

    <!-- Eesti — blue / black / white -->
    <DrawingImage x:Key="Flag_et">
      <DrawingGroup>
        <GeometryDrawing Brush="#0072CE" Geometry="M0,0 H30 V6.67 H0 Z" />
        <GeometryDrawing Brush="#000000" Geometry="M0,6.67 H30 V13.33 H0 Z" />
        <GeometryDrawing Brush="#FFFFFF" Geometry="M0,13.33 H30 V20 H0 Z" />
      </DrawingGroup>
    </DrawingImage>

    <!-- Latviešu — carmine / white / carmine (2:1:2) -->
    <DrawingImage x:Key="Flag_lv">
      <DrawingGroup>
        <GeometryDrawing Brush="#9E3039" Geometry="M0,0 H30 V8 H0 Z" />
        <GeometryDrawing Brush="#FFFFFF" Geometry="M0,8 H30 V12 H0 Z" />
        <GeometryDrawing Brush="#9E3039" Geometry="M0,12 H30 V20 H0 Z" />
      </DrawingGroup>
    </DrawingImage>

    <!-- Suomi — white with blue Nordic cross -->
    <DrawingImage x:Key="Flag_fi">
      <DrawingGroup>
        <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H30 V20 H0 Z" />
        <GeometryDrawing Geometry="M11,0 V20 M0,10 H30">
          <GeometryDrawing.Pen>
            <Pen Brush="#002F6C" Thickness="5" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage>

    <!-- Svenska — blue with yellow Nordic cross -->
    <DrawingImage x:Key="Flag_sv">
      <DrawingGroup>
        <GeometryDrawing Brush="#006AA7" Geometry="M0,0 H30 V20 H0 Z" />
        <GeometryDrawing Geometry="M11,0 V20 M0,10 H30">
          <GeometryDrawing.Pen>
            <Pen Brush="#FECC00" Thickness="4" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage>

    <!-- Norsk — red with white-bordered blue Nordic cross -->
    <DrawingImage x:Key="Flag_no">
      <DrawingGroup>
        <GeometryDrawing Brush="#BA0C2F" Geometry="M0,0 H30 V20 H0 Z" />
        <GeometryDrawing Geometry="M11,0 V20 M0,10 H30">
          <GeometryDrawing.Pen>
            <Pen Brush="#FFFFFF" Thickness="5.5" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M11,0 V20 M0,10 H30">
          <GeometryDrawing.Pen>
            <Pen Brush="#00205B" Thickness="2.6" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage>

    <!-- Dansk — red with white Nordic cross -->
    <DrawingImage x:Key="Flag_da">
      <DrawingGroup>
        <GeometryDrawing Brush="#C8102E" Geometry="M0,0 H30 V20 H0 Z" />
        <GeometryDrawing Geometry="M11,0 V20 M0,10 H30">
          <GeometryDrawing.Pen>
            <Pen Brush="#FFFFFF" Thickness="4" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage>

    <!-- Nederlands — red / white / blue -->
    <DrawingImage x:Key="Flag_nl">
      <DrawingGroup>
        <GeometryDrawing Brush="#AE1C28" Geometry="M0,0 H30 V6.67 H0 Z" />
        <GeometryDrawing Brush="#FFFFFF" Geometry="M0,6.67 H30 V13.33 H0 Z" />
        <GeometryDrawing Brush="#21468B" Geometry="M0,13.33 H30 V20 H0 Z" />
      </DrawingGroup>
    </DrawingImage>

    <!-- Italiano — green / white / red (vertical) -->
    <DrawingImage x:Key="Flag_it">
      <DrawingGroup>
        <GeometryDrawing Brush="#008C45" Geometry="M0,0 H10 V20 H0 Z" />
        <GeometryDrawing Brush="#FFFFFF" Geometry="M10,0 H20 V20 H10 Z" />
        <GeometryDrawing Brush="#CD212A" Geometry="M20,0 H30 V20 H20 Z" />
      </DrawingGroup>
    </DrawingImage>

    <!-- Español — red / yellow / red (1:2:1) -->
    <DrawingImage x:Key="Flag_es">
      <DrawingGroup>
        <GeometryDrawing Brush="#AA151B" Geometry="M0,0 H30 V5 H0 Z" />
        <GeometryDrawing Brush="#F1BF00" Geometry="M0,5 H30 V15 H0 Z" />
        <GeometryDrawing Brush="#AA151B" Geometry="M0,15 H30 V20 H0 Z" />
      </DrawingGroup>
    </DrawingImage>

    <!-- Português — green / red (2:3) with the armillary disc hint -->
    <DrawingImage x:Key="Flag_pt">
      <DrawingGroup>
        <GeometryDrawing Brush="#006600" Geometry="M0,0 H12 V20 H0 Z" />
        <GeometryDrawing Brush="#FF0000" Geometry="M12,0 H30 V20 H12 Z" />
        <GeometryDrawing Brush="#FFE900">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="12,10" RadiusX="3.6" RadiusY="3.6" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage>

    <!-- 日本語 — white field, red sun disc -->
    <DrawingImage x:Key="Flag_ja">
      <DrawingGroup>
        <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H30 V20 H0 Z" />
        <GeometryDrawing Brush="#BC002D">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="15,10" RadiusX="6" RadiusY="6" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage>

    <!-- Extra UI converters for the Figma design -->
    <core:EqualsConverter x:Key="Eq" />
    <core:StringToUpperConverter x:Key="Upper" />
    <core:IntensityToBrushConverter x:Key="Intensity" />
    <core:LevelToWidthConverter x:Key="LevelWidth" />

    <!-- Popup overlay + slider SIZING (theme-invariant). The matching COLOURS — ToggleSwitch,
         ComboBox dropdown, menu, tooltip and SystemAccentColor — are themed per-variant in
         Themes/Palette.axaml (Fluent templates read those keys via DynamicResource). -->
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
    <Thickness x:Key="ComboBoxDropdownBorderPadding">4</Thickness>
    <Thickness x:Key="MenuFlyoutPresenterThemePadding">4</Thickness>

    <!-- Slider: reskin of the Fluent template (see DarkTheme.axaml, Slider section).
         Compact 20px control: 4px(top) + 12px thumb + 4px(bottom); white round thumb. -->
    <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
    <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
    <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
    <GridLength x:Key="SliderPreContentMargin">4</GridLength>
    <GridLength x:Key="SliderPostContentMargin">4</GridLength>
    <CornerRadius x:Key="SliderThumbCornerRadius">6</CornerRadius>
    <SolidColorBrush x:Key="SliderThumbBackground">White</SolidColorBrush>
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver">White</SolidColorBrush>
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed">White</SolidColorBrush>
    <SolidColorBrush x:Key="SliderThumbBackgroundDisabled">White</SolidColorBrush>
    <SolidColorBrush x:Key="SliderContainerBackground">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="SliderContainerBackgroundPressed">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="SliderContainerBackgroundDisabled">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="SliderTrackValueFillDisabled">#22D3EE</SolidColorBrush>
    <SolidColorBrush x:Key="SliderTrackFillDisabled">#24FFFFFF</SolidColorBrush>

    <!-- ToggleSwitch — custom animated template. Fluent 11.2.3's built-in knob slide does NOT fire in
         this app (every other transition animates — only the toggle knob snapped), so we own the
         template: a pill track + a round knob that SLIDES via translateX (TransformOperationsTransition,
         the same kind that animates fine on the chevron/segments) + a colour fade on the track. Colours
         come from the per-variant ToggleSwitch* keys, so Light/Dark theme automatically. A ControlTheme
         (not a Style Template setter) so it WINS over Fluent's. All app toggles are bare (no On/Off content). -->
    <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" BorderThickness="1"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Background="{DynamicResource ToggleSwitchFillOff}"
                  BorderBrush="{DynamicResource ToggleSwitchStrokeOff}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
            <Panel>
              <!-- Required ToggleSwitch parts, kept 0-size/hidden: the control sets Canvas.Left on
                   PART_MovingKnobs (Fluent's slide that doesn't fire here). Our Knob below does the
                   visible animated slide via translateX. -->
              <Canvas x:Name="PART_SwitchKnob" Width="0" Height="0">
                <Panel x:Name="PART_MovingKnobs" />
              </Canvas>
              <Ellipse x:Name="Knob" Width="16" Height="16" Margin="2,0,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{DynamicResource ToggleSwitchKnobFillOff}" RenderTransform="translateX(0px)">
                <Ellipse.Transitions>
                  <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <BrushTransition Property="Fill" Duration="0:0:0.16" />
                  </Transitions>
                </Ellipse.Transitions>
              </Ellipse>
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource ToggleSwitchFillOffPointerOver}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffPointerOver}" />
      </Style>
      <Style Selector="^:pointerover /template/ Ellipse#Knob">
        <Setter Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOffPointerOver}" />
      </Style>

      <Style Selector="^:checked /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource ToggleSwitchFillOn}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOn}" />
      </Style>
      <Style Selector="^:checked /template/ Ellipse#Knob">
        <Setter Property="RenderTransform" Value="translateX(18px)" />
        <Setter Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOn}" />
      </Style>
      <Style Selector="^:checked:pointerover /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource ToggleSwitchFillOnPointerOver}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOnPointerOver}" />
      </Style>
      <Style Selector="^:checked:pointerover /template/ Ellipse#Knob">
        <Setter Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOnPointerOver}" />
      </Style>

      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.45" />
      </Style>
    </ControlTheme>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <materialIcons:MaterialIconStyles />
    <StyleInclude Source="avares://Lag/Themes/DarkTheme.axaml" />
    <!-- Redesign reusable component styles (cyan; additive, prefixed "r") -->
    <StyleInclude Source="avares://Lag/Themes/Components.axaml" />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="avares://Lag/Assets/icon.ico"
                ToolTipText="Lag" Clicked="TrayIcon_OpenClicked">
        <TrayIcon.Menu>
          <!-- Headers are localized in code (App.LocalizeTrayMenu) — NativeMenuItem lives outside
               the logical tree, so DynamicResource bindings don't reach it. -->
          <NativeMenu>
            <NativeMenuItem Header="Save Replay" Click="TrayIcon_SaveReplayClicked" />
            <NativeMenuItem Header="Open Library" Click="TrayIcon_OpenLibraryClicked" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Open" Click="TrayIcon_OpenClicked" />
            <NativeMenuItem Header="Exit" Click="TrayIcon_ExitClicked" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>

</Application>
