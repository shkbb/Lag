<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════════════
       Lag redesign — reusable component styles (cyan accent). Used by the
       rebuilt Settings / Library / Audio views. Redesign classes are prefixed
       "r" so they never collide with the old cyan styles in DarkTheme.axaml,
       which stay until each view migrates. Tokens from Themes/Tokens.axaml.
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- Settings card (rounded surface holding divider-separated rows) -->
  <Style Selector="Border.rcard">
    <Setter Property="Background" Value="{StaticResource SurfaceCard}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadCard}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- Hairline divider between card rows -->
  <Style Selector="Border.rdivider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource BorderFaint}" />
  </Style>

  <!-- Section group label (mono, uppercase text supplied in markup) -->
  <Style Selector="TextBlock.rgroup">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource TextFaintest}" />
    <Setter Property="Margin" Value="2,0,0,11" />
  </Style>

  <!-- Card row primary label -->
  <Style Selector="TextBlock.rrow">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource TextRow}" />
  </Style>

  <!-- Card row secondary/description -->
  <Style Selector="TextBlock.rsub">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Mono numeric/path/tag text -->
  <Style Selector="TextBlock.rmono">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
  </Style>

  <!-- kbd chip (Alt / F10 / V …) -->
  <Style Selector="Border.rkbd">
    <Setter Property="Background" Value="{StaticResource SurfaceInput}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadKbd}" />
    <Setter Property="Padding" Value="9,4" />
  </Style>
  <Style Selector="Border.rkbd > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource TextKbd}" />
  </Style>

  <!-- Segmented control: a track Border holding Button.rseg items -->
  <Style Selector="Border.rsegtrack">
    <Setter Property="Background" Value="{StaticResource SurfaceInput}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadInput}" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="Button.rseg">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextMid}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadSeg}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.rseg /template/ ContentPresenter">
    <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions></Setter>
  </Style>
  <Style Selector="Button.rseg:pointerover">
    <Setter Property="Foreground" Value="{StaticResource TextHi}" />
  </Style>
  <Style Selector="Button.rseg.sel">
    <Setter Property="Foreground" Value="{StaticResource AccentText}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentRing}" />
  </Style>
  <Style Selector="Button.rseg.sel /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentDim}" />
  </Style>

  <!-- Dropdown pill look (value + chevron); used as the trigger surface -->
  <Style Selector="Border.rpill">
    <Setter Property="Background" Value="{StaticResource SurfaceInput}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderInput}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadInput}" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <!-- Small dark action button (Change / Check for Updates / Open folder …) -->
  <Style Selector="Button.rchip">
    <Setter Property="Background" Value="{StaticResource SurfaceInput}" />
    <Setter Property="Foreground" Value="{StaticResource TextHi}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadInput}" />
    <Setter Property="Padding" Value="15,8" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.rchip /template/ ContentPresenter">
    <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.14" /></Transitions></Setter>
  </Style>
  <Style Selector="Button.rchip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHover2}" />
  </Style>

  <!-- Button flyouts (export options, playback speed, clip picker …): match the dark theme
       instead of the default Fluent surface. -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceCard}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadGeneral}" />
    <Setter Property="Padding" Value="8" />
  </Style>

</Styles>
