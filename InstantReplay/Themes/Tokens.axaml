<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════════════
       Lag "Lag Studio" redesign — THEME-INVARIANT design tokens.
       Colours/brushes live in Themes/Palette.axaml (per-variant ThemeDictionaries:
       Dark + the warm "cream" Light theme). Everything here is identical across
       themes — radii, typography and the vector logo geometry — so it stays a
       plain merged dictionary referenced via {StaticResource}.
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- ── Typography (Inter approximation of Geist/Space Grotesk; mono = system monospace) ── -->
  <FontFamily x:Key="FontUi">Inter</FontFamily>
  <FontFamily x:Key="FontDisplay">Inter</FontFamily>            <!-- headings (Space Grotesk → Inter, heavy weight at use) -->
  <FontFamily x:Key="FontMono">Cascadia Code, Consolas, Courier New, monospace</FontFamily>

  <!-- ── Corner radii ── -->
  <CornerRadius x:Key="RadCard">15</CornerRadius>
  <CornerRadius x:Key="RadGeneral">13</CornerRadius>
  <CornerRadius x:Key="RadPill">11</CornerRadius>
  <CornerRadius x:Key="RadButton">10</CornerRadius>
  <CornerRadius x:Key="RadInput">9</CornerRadius>
  <CornerRadius x:Key="RadSeg">7</CornerRadius>
  <CornerRadius x:Key="RadKbd">6</CornerRadius>

  <!-- ── Brand mark — rewind-clock from the logo (22×22 viewbox, stroked). Theme-invariant
       geometry; the Stroke is supplied per-use from a themed brush. ── -->
  <StreamGeometry x:Key="LogoArcGeometry">M2.75 11C2.75 12.6317 3.23385 14.2267 4.14038 15.5835C5.0469 16.9402 6.33537 17.9976 7.84286 18.622C9.35035 19.2464 11.0092 19.4098 12.6095 19.0915C14.2098 18.7732 15.6798 17.9874 16.8336 16.8336C17.9874 15.6798 18.7732 14.2098 19.0915 12.6095C19.4098 11.0092 19.2464 9.35035 18.622 7.84286C17.9976 6.33537 16.9402 5.0469 15.5835 4.14038C14.2267 3.23385 12.6317 2.75 11 2.75C8.69362 2.75868 6.47989 3.65862 4.82167 5.26167L2.75 7.33333</StreamGeometry>
  <StreamGeometry x:Key="LogoCornerGeometry">M2.75 2.75V7.33333H7.33333</StreamGeometry>
  <StreamGeometry x:Key="LogoHandsGeometry">M11 6.41667V11L14.6667 12.8333</StreamGeometry>

</ResourceDictionary>
