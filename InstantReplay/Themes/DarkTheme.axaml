<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="using:Material.Icons.Avalonia">

  <!-- ═══════════════════════════════════════════════════════════════
       "Lag" theme — 1:1 port of the Figma file «Lag — UI mockup»
       (file VzxvjXtHHCysySbqehHoaf). Every color/size below is taken
       from the design tokens; do not "improve" values ad hoc.
       ═══════════════════════════════════════════════════════════════ -->

  <!-- Colours/brushes now live per-variant in Themes/Palette.axaml (Dark + cream Light),
       and the logo geometry in Tokens.axaml. Styles below reference brushes via
       {DynamicResource} so they re-resolve when the theme variant flips. -->

  <!-- ═══════════════ Global text ═══════════════ -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
  </Style>

  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Fg3Brush}" />
    <Setter Property="LetterSpacing" Value="0.7" />
  </Style>

  <!-- Hairline divider between settings rows -->
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Divider5Brush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- ═══════════════ Buttons (shared animated base) ═══════════════ -->
  <Style Selector="Button">
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <!-- Primary CTA (Start = cyan, gets .rec class when recording = red) -->
  <Style Selector="Button.cta">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.cta /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.cta:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.cta.rec">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.cta.rec:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
  </Style>

  <!-- Dark surface button (Save replay, h34) -->
  <Style Selector="Button.surface">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.surface /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.surface:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <!-- Small surface chip-button (Open folder / Change / Check updates; px12 py7) -->
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.chip /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <!-- Destructive chip variant (bulk delete in the library header) -->
  <Style Selector="Button.chip.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.chip.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
  </Style>

  <!-- ═══════════════ Sidebar navigation (classes managed by code-behind) ═══════════════ -->
  <Style Selector="Button.nav, Button.nav-active">
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.nav /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
  </Style>
  <Style Selector="Button.nav-active">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.nav mi|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nav-active mi|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <!-- Springy pop when a section becomes active -->
    <Style.Animations>
      <Animation Duration="0:0:0.25" Easing="CubicEaseOut" FillMode="None">
        <KeyFrame Cue="0%">
          <Setter Property="ScaleTransform.ScaleX" Value="0.7" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.7" />
        </KeyFrame>
        <KeyFrame Cue="60%">
          <Setter Property="ScaleTransform.ScaleX" Value="1.12" />
          <Setter Property="ScaleTransform.ScaleY" Value="1.12" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ═══════════════ Window controls (custom chrome) ═══════════════ -->
  <Style Selector="Button.winctl">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.winctl /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.winctl:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="Button.winctl:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="Button.winctl.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Button.winctl.close:pointerover">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- ═══════════════ Settings tabs (text + animated 2px underline) ═══════════════ -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.tab TextBlock.tabtxt">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.tab.sel TextBlock.tabtxt">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.tab Border.tabline">
    <Setter Property="Height" Value="2" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Margin" Value="0,7,0,0" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scaleX(0)" />
    <Setter Property="Transitions">
      <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.20" Easing="CubicEaseOut" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.tab.sel Border.tabline">
    <Setter Property="RenderTransform" Value="scaleX(1)" />
  </Style>

  <!-- ═══════════════ Segmented control ═══════════════ -->
  <Style Selector="Border.segment">
    <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="Button.seg">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- Replaces the base Button transitions, so re-declare the pressed-scale one too -->
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.seg /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.seg:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SegHoverBrush}" />
  </Style>
  <Style Selector="Button.seg.sel">
    <Setter Property="Background" Value="{DynamicResource SegSelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.seg.sel /template/ ContentPresenter">
    <!-- Same pop as the segctl pill when this side becomes selected -->
    <Style.Animations>
      <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="None">
        <KeyFrame Cue="0%">
          <Setter Property="ScaleTransform.ScaleX" Value="0.85" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.85" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ═══════════════ Segmented as ListBox (object-typed options: FPS, codec) ═══════════════ -->
  <Style Selector="ListBox.segctl">
    <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.segctl ListBoxItem">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.segctl ListBoxItem:pressed">
    <Setter Property="RenderTransform" Value="scale(0.95)" />
  </Style>
  <Style Selector="ListBox.segctl ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.segctl ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SegHoverBrush}" />
  </Style>
  <Style Selector="ListBox.segctl ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SegSelBrush}" />
    <!-- Pill "pop" each time the selection lands on this item (FPS/codec switch) -->
    <Style.Animations>
      <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="None">
        <KeyFrame Cue="0%">
          <Setter Property="ScaleTransform.ScaleX" Value="0.85" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.85" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="ListBox.segctl ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- App-list row label color follows the checkbox state -->
  <Style Selector="CheckBox.app TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="CheckBox.app:checked TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>

  <!-- ═══════════════ Kbd chip ═══════════════ -->
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Border.kbd TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <!-- "Bare" buttons wrap a kbd chip (hotkey / PTT capture). Fluent's :disabled state
       paints a square gray plate behind them — neutralize it and dim the chip instead. -->
  <Style Selector="Button.bare:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.bare:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Pulsing chip while waiting for a key press (hotkey / PTT capture) -->
  <Style Selector="Border.kbd.listening">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="Infinite" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.45" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ═══════════════ ComboBox (design dropdown) ═══════════════ -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="12,5,8,5" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource Fg2Brush}" />
  </Style>
  <Style Selector="ComboBox /template/ Border#Background">
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <!-- Chevron: dim, rotates 180° while the dropdown is open -->
  <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="ComboBox:dropdownopen /template/ PathIcon#DropDownGlyph">
    <Setter Property="RenderTransform" Value="rotate(180deg)" />
  </Style>

  <!-- Dropdown popup: colors/radius come from resource overrides in App.axaml
       (the Fluent template hardcodes DynamicResource keys there). No open animation:
       the popup's OS window becomes visible before the first animation frame paints,
       which reads as an ugly blink — instant open is the clean option. -->

  <Style Selector="ComboBoxItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SegSelBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource FgBrush}" />
  </Style>

  <!-- ═══════════════ Menus: library context menu + tray menu ═══════════════
       The tray menu on Windows is rendered by Avalonia itself (TrayIconMenuFlyoutPresenter
       extends MenuFlyoutPresenter), so MenuFlyoutPresenter/MenuItem styles cover it too.
       Hover/pressed colors come from resource overrides in App.axaml (the Fluent MenuItem
       template hardcodes those DynamicResource keys). -->
  <!-- No open animations on menus: like the ComboBox dropdown, the popup's OS window
       shows before the first animation frame, producing a blink instead of a fade. -->
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="MenuItem mi|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.12" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="MenuItem:selected mi|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!-- Menu separators (only menus use Separator in this app) -->
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource Divider6Brush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="8,4" />
  </Style>

  <!-- ═══════════════ ToolTip (design surface) ═══════════════
       NO keyframe animation here: the Fluent theme already has a DoubleTransition on
       Opacity, and combining a FillMode=Forward animation with a transition on the SAME
       property crashes Avalonia ("The observable can only be subscribed once"). -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ═══════════════ TextBox (custom fps/bitrate inputs) ═══════════════ -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
  </Style>
  <!-- Kill Fluent's light hover/focus chrome and animate ours (cyan focus ring) -->
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ═══════════════ App-audio checkbox (16px, design) ═══════════════ -->
  <Style Selector="CheckBox.app">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="10" Background="Transparent">
          <Border Width="16" Height="16" CornerRadius="4"
                  Background="{DynamicResource SurfaceBrush}"
                  VerticalAlignment="Center">
            <Border.Transitions>
              <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions>
            </Border.Transitions>
            <Path x:Name="PART_Check"
                  Data="M2 5.5 L4.2 8 L8.5 2.5"
                  Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.8"
                  StrokeLineCap="Round" StrokeJoin="Round"
                  Width="10" Height="10" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Opacity="0" RenderTransform="scale(0.4)">
              <Path.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
              </Path.Transitions>
            </Path>
          </Border>
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="CheckBox.app:checked /template/ Border">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="CheckBox.app:checked /template/ Path#PART_Check">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>

  <!-- ═══════════════ Slider (cyan fill, white 12px thumb, 4px track) ═══════════════
       Keeps the FLUENT template (its grid centers the thumb/track correctly) and only
       reskins it. In that template: filled part = Slider.Foreground, remaining track +
       backplate = Slider.Background; thumb size/shape/colors and the 20px compact
       height come from resource overrides in App.axaml. Replacing the template via
       styles is a trap: Fluent assigns it inside ^:horizontal (StyleTrigger priority).
       The :pointerover/:pressed styles below pin the colors that Fluent's own state
       styles would otherwise flip back to the accent palette. -->
  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource Track14Brush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Slider:horizontal">
    <Setter Property="Height" Value="20" />
    <Setter Property="MinHeight" Value="20" />
  </Style>
  <Style Selector="Slider:pointerover /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Slider:pressed /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Slider:pointerover /template/ RepeatButton#PART_IncreaseButton">
    <Setter Property="Background" Value="{DynamicResource Track14Brush}" />
  </Style>
  <Style Selector="Slider:pressed /template/ RepeatButton#PART_IncreaseButton">
    <Setter Property="Background" Value="{DynamicResource Track14Brush}" />
  </Style>
  <!-- ToggleSwitch is fully re-templated in App.axaml (Application.Resources) with an animated knob —
       Fluent 11.2.3's built-in knob slide does NOT fire here, so we own the template + the slide. -->

  <!-- Thumb grows slightly on hover -->
  <Style Selector="Slider /template/ Thumb">
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Slider:pointerover /template/ Thumb">
    <Setter Property="RenderTransform" Value="scale(1.25)" />
  </Style>
  <Style Selector="Slider:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <!-- Gray (volume) variant — the fill follows Foreground -->
  <Style Selector="Slider.volume">
    <Setter Property="Foreground" Value="{DynamicResource VolumeFillBrush}" />
  </Style>
  <Style Selector="Slider.volume:pointerover /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource VolumeFillBrush}" />
  </Style>
  <Style Selector="Slider.volume:pressed /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource VolumeFillBrush}" />
  </Style>

  <!-- ═══════════════ Player replay list ═══════════════ -->
  <Style Selector="ListBox.replays">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.replays ListBoxItem">
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.replays ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.replays ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
  </Style>
  <Style Selector="ListBox.replays ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <!-- ═══════════════ Library clip card (hover veil + delete reveal) ═══════════════ -->
  <Style Selector="Button.clipcard">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.clipcard /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.clipcard:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
  </Style>
  <Style Selector="Button.clipcard Border#HoverVeil">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.clipcard:pointerover Border#HoverVeil">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.clipcard Button#SelectBtn">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.clipcard:pointerover Button#SelectBtn">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
  <!-- A selected card keeps its toggle visible and gets an accent outline -->
  <Style Selector="Button.clipcard Button#SelectBtn.checked">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
  <Style Selector="Button.clipcard.selected /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Player transport icon buttons (borderless, subtle hover).
       Focusable=False: a focused button re-activates on SPACE, hijacking the
       view-level "Space = play/pause" key binding (e.g. fullscreen toggle loop). -->
  <Style Selector="Button.transport">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.transport /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TransportHoverBrush}" />
  </Style>

  <!-- ═══════════════ ScrollBar (custom slim: no track line; thumb only on hover) ═══════════════ -->
  <!-- Fluent's vertical scrollbar left a persistent grey track line on the right of scroll panels
       (AllowAutoHide + transparent background didn't remove it — it's baked into its template). A
       minimal custom template guarantees it's gone: a transparent track and a thin thumb that's
       invisible at rest and fades in only when you hover the edge or drag it. -->
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Track Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 ViewportSize="{TemplateBinding ViewportSize}">
            <Track.Thumb>
              <Thumb Width="6" MinHeight="28" HorizontalAlignment="Center">
                <Thumb.Template>
                  <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ScrollBar:vertical /template/ Thumb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
  </Style>
  <Style Selector="ScrollBar:vertical /template/ Thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource ScrollThumbPressedBrush}" />
  </Style>

  <!-- ═══════════════ ProgressBar (sidebar buffer track) ═══════════════ -->
  <Style Selector="ProgressBar.buffer">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <!-- The ticker updates once per second — glide between values instead of stepping -->
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Value" Duration="0:0:0.45" Easing="CubicEaseOut" /></Transitions>
    </Setter>
  </Style>

</Styles>
