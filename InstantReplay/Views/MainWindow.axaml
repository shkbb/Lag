<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lag.ViewModels"
        xmlns:views="using:Lag.Views"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="Lag.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Lag"
        Icon="avares://Lag/Assets/icon.ico"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="600"
        Background="#12151A"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterScreen">

  <!-- DataTemplates for view switching -->
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
      <views:LibraryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PlayerViewModel}">
      <views:PlayerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EditorViewModel}">
      <views:EditorView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="Auto,*">

    <!-- ═══════════════ Sidebar (220px, #0C0E11) ═══════════════ -->
    <Border Grid.Column="0" Width="220"
            Background="{StaticResource SidebarBrush}"
            IsVisible="{Binding !IsFullscreen}">
      <DockPanel Margin="16,18,16,16">

        <!-- Logo (drag zone) -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10"
                    Background="Transparent"
                    PointerPressed="OnTitleBarPointerPressed">
          <Canvas Width="22" Height="22">
            <Path Data="{StaticResource LogoArcGeometry}" Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
            <Path Data="{StaticResource LogoCornerGeometry}" Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
            <Path Data="{StaticResource LogoHandsGeometry}" Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
          </Canvas>
          <TextBlock Text="Lag" FontSize="16" FontWeight="Medium"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- CTA: Start (cyan) / Stop (red, class .rec via code-behind) -->
        <Button DockPanel.Dock="Top" Margin="0,22,0,0"
                x:Name="RecordCta" Classes="cta"
                Command="{Binding ToggleRecordingCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="{StaticResource OnAccentBrush}"
                     IsVisible="{Binding !IsRecording}" VerticalAlignment="Center" />
            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="White"
                       IsVisible="{Binding IsRecording}" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource Btn_StartRecording}"
                       IsVisible="{Binding !IsRecording}" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource Btn_StopRecording}"
                       IsVisible="{Binding IsRecording}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Save replay -->
        <Button DockPanel.Dock="Top" Margin="0,8,0,0" Classes="surface"
                Command="{Binding SaveReplayCommand}"
                IsEnabled="{Binding IsRecording}">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <mi:MaterialIcon Kind="TrayArrowDown" Width="15" Height="15" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource Btn_SaveReplay}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Pause / Resume the buffer feed (only shown while recording) -->
        <Button DockPanel.Dock="Top" Margin="0,8,0,0" Classes="surface"
                Command="{Binding TogglePauseRecordingCommand}"
                IsVisible="{Binding IsRecording}">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <mi:MaterialIcon Kind="Pause" Width="15" Height="15" VerticalAlignment="Center"
                             IsVisible="{Binding !IsPaused}" />
            <mi:MaterialIcon Kind="Play" Width="15" Height="15" VerticalAlignment="Center"
                             IsVisible="{Binding IsPaused}" />
            <TextBlock Text="{DynamicResource Btn_PauseRecording}" VerticalAlignment="Center"
                       IsVisible="{Binding !IsPaused}" />
            <TextBlock Text="{DynamicResource Btn_ResumeRecording}" VerticalAlignment="Center"
                       IsVisible="{Binding IsPaused}" />
          </StackPanel>
        </Button>

        <!-- Hotkey hint -->
        <TextBlock DockPanel.Dock="Top" Margin="0,8,0,0"
                   Text="{Binding Settings.HotkeyDisplayText}"
                   FontSize="11" Foreground="{StaticResource Fg3Brush}"
                   HorizontalAlignment="Center" />

        <!-- Live capture indicator: what's being recorded right now (game / desktop) -->
        <Border DockPanel.Dock="Top" Margin="0,14,0,0" Padding="11,8"
                Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                IsVisible="{Binding HasCaptureTarget}">
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <mi:MaterialIcon Width="17" Height="17" VerticalAlignment="Center"
                             Foreground="{StaticResource AccentBrush}"
                             Kind="Controller" IsVisible="{Binding CaptureTargetIsGame}" />
            <mi:MaterialIcon Width="17" Height="17" VerticalAlignment="Center"
                             Foreground="{StaticResource AccentBrush}"
                             Kind="Monitor" IsVisible="{Binding !CaptureTargetIsGame}" />
            <TextBlock Text="{Binding CaptureTargetName}" FontSize="12.5" FontWeight="Medium"
                       Foreground="{StaticResource Fg1Brush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="150" />
          </StackPanel>
        </Border>

        <!-- Navigation -->
        <StackPanel DockPanel.Dock="Top" Margin="0,26,0,0" Spacing="2">
          <Button x:Name="NavSettings" Classes="nav"
                  Command="{Binding NavigateToSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <mi:MaterialIcon Kind="CogOutline" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource Nav_Settings}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavLibrary" Classes="nav"
                  Command="{Binding NavigateToLibraryCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <mi:MaterialIcon Kind="ViewGridOutline" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource Nav_Library}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavPlayer" Classes="nav"
                  Command="{Binding NavigateToPlayerCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <mi:MaterialIcon Kind="PlayOutline" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource Nav_Player}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Buffer block (docked bottom, design order: status → labels → track) -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{StaticResource StatusReadyBrush}"
                     IsVisible="{Binding !IsRecording}" />
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{StaticResource StatusRecordingBrush}"
                     IsVisible="{Binding IsRecording}" />
            <TextBlock Text="{Binding StatusText}" FontSize="12"
                       Foreground="{StaticResource Fg2Brush}"
                       TextTrimming="CharacterEllipsis" MaxWidth="160"
                       ToolTip.Tip="{Binding StatusText}"
                       VerticalAlignment="Center" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" Text="{DynamicResource Sidebar_Buffer}"
                       FontSize="11" Foreground="{StaticResource Fg3Brush}" />
            <TextBlock Grid.Column="1" Text="{Binding BufferStatus}"
                       FontSize="11" Foreground="{StaticResource Fg3Brush}" />
          </Grid>
          <ProgressBar Classes="buffer" Margin="0,6,0,0"
                       Minimum="0" Maximum="100"
                       Value="{Binding BufferFillPercent}" />
        </StackPanel>

        <!-- flexible gap -->
        <Panel Background="Transparent" PointerPressed="OnTitleBarPointerPressed" />
      </DockPanel>
    </Border>

    <!-- ═══════════════ Main column ═══════════════ -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*" Background="{StaticResource MainBrush}">

      <!-- Titlebar (36px, drag + custom window controls) -->
      <Grid Grid.Row="0" Height="36"
            Background="Transparent"
            IsVisible="{Binding !IsFullscreen}"
            PointerPressed="OnTitleBarPointerPressed">
        <StackPanel Orientation="Horizontal" Spacing="2"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,6,0">
          <Button Classes="winctl" Click="OnMinimizeClick">
            <mi:MaterialIcon Kind="WindowMinimize" Width="14" Height="14" />
          </Button>
          <Button Classes="winctl" Click="OnMaximizeClick">
            <mi:MaterialIcon Kind="SquareRoundedOutline" Width="11" Height="11" />
          </Button>
          <Button Classes="winctl close" Click="OnCloseClick">
            <mi:MaterialIcon Kind="WindowClose" Width="14" Height="14" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Animated view host -->
      <TransitioningContentControl Grid.Row="1"
                                   x:Name="ContentHost"
                                   Content="{Binding CurrentView}">
        <TransitioningContentControl.PageTransition>
          <CrossFade Duration="0:0:0.18" />
        </TransitioningContentControl.PageTransition>
      </TransitioningContentControl>
    </Grid>

  </Grid>

</Window>
