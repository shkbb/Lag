<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lag.ViewModels"
        xmlns:views="using:Lag.Views"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="Lag.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Lag"
        Icon="avares://Lag/Assets/icon.ico"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="600"
        Background="#0C0D11"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterScreen">

  <!-- DataTemplates for view switching -->
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
      <views:LibraryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PlayerViewModel}">
      <views:PlayerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EditorViewModel}">
      <views:EditorView />
    </DataTemplate>
  </Window.DataTemplates>

  <!-- ═══════════════ Redesign shell styles (cyan accent) ═══════════════ -->
  <Window.Styles>

    <!-- Top-bar accent button (Record). Code-behind toggles .rec → red. -->
    <Style Selector="Button.tbar-accent">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tbar-accent /template/ ContentPresenter">
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions></Setter>
    </Style>
    <Style Selector="Button.tbar-accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.tbar-accent.rec">
      <Setter Property="Background" Value="{StaticResource DangerBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.tbar-accent.rec:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource DangerHoverBrush}" />
    </Style>

    <!-- Top-bar dark button (Save Replay / Pause) -->
    <Style Selector="Button.tbar">
      <Setter Property="Background" Value="{StaticResource SurfaceInput}" />
      <Setter Property="Foreground" Value="{StaticResource TextBtn}" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="15,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tbar /template/ ContentPresenter">
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions></Setter>
    </Style>
    <Style Selector="Button.tbar:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
    </Style>
    <Style Selector="Button.tbar:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Window controls (42px wide, full 58px bar) -->
    <Style Selector="Button.wctl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="58" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.wctl /template/ ContentPresenter">
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions></Setter>
    </Style>
    <Style Selector="Button.wctl:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BorderFaint}" />
    </Style>
    <Style Selector="Button.wctl.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource DangerClose}" />
    </Style>
    <Style Selector="Button.wctl.close:pointerover mi|MaterialIcon">
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Icon-rail item (vertical icon + tiny label). Code-behind sets .active. -->
    <Style Selector="Button.railitem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextMid}" />
      <Setter Property="Width" Value="62" />
      <Setter Property="Height" Value="56" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.railitem /template/ ContentPresenter">
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.14" /></Transitions></Setter>
    </Style>
    <Style Selector="Button.railitem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BorderFaint}" />
    </Style>
    <Style Selector="Button.railitem mi|MaterialIcon">
      <Setter Property="Foreground" Value="{StaticResource TextMid}" />
    </Style>
    <Style Selector="Button.railitem.active">
      <Setter Property="Background" Value="{StaticResource AccentDim}" />
      <Setter Property="Foreground" Value="{StaticResource TextHi}" />
    </Style>
    <Style Selector="Button.railitem.active mi|MaterialIcon">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <!-- Recording status dot: gentle pulse -->
    <Style Selector="Ellipse.recpulse">
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*" Background="{StaticResource SurfaceApp}">

    <!-- ═══════════════ TOP COMMAND BAR (58px) ═══════════════ -->
    <Border Grid.Row="0" Height="58" Background="{StaticResource SurfaceApp}"
            BorderBrush="{StaticResource BorderCard}" BorderThickness="0,0,0,1"
            IsVisible="{Binding !IsFullscreen}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="18,0,0,0">

        <!-- Logo (drag zone) -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                    Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
          <Border Width="28" Height="28" Background="{StaticResource Accent}" CornerRadius="8">
            <Canvas Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Data="{StaticResource LogoArcGeometry}" Stroke="{StaticResource OnAccent}"
                    StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
              <Path Data="{StaticResource LogoCornerGeometry}" Stroke="{StaticResource OnAccent}"
                    StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
              <Path Data="{StaticResource LogoHandsGeometry}" Stroke="{StaticResource OnAccent}"
                    StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
            </Canvas>
          </Border>
          <TextBlock Text="Lag" FontFamily="{StaticResource FontDisplay}" FontSize="18" FontWeight="Bold"
                     Foreground="{StaticResource TextHi}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Divider -->
        <Border Grid.Column="1" Width="1" Height="26" Margin="16,0"
                Background="{StaticResource BorderStrong}" VerticalAlignment="Center" />

        <!-- Record (cyan / red) -->
        <Button Grid.Column="2" x:Name="RecordCta" Classes="tbar-accent"
                Command="{Binding ToggleRecordingCommand}">
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <Ellipse Width="9" Height="9" Fill="{StaticResource OnAccent}"
                     IsVisible="{Binding !IsRecording}" VerticalAlignment="Center" />
            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="White"
                       IsVisible="{Binding IsRecording}" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource Btn_StartRecording}"
                       IsVisible="{Binding !IsRecording}" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource Btn_StopRecording}"
                       IsVisible="{Binding IsRecording}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Save Replay -->
        <Button Grid.Column="3" Classes="tbar" Margin="10,0,0,0"
                Command="{Binding SaveReplayCommand}" IsEnabled="{Binding IsRecording}">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <mi:MaterialIcon Kind="TrayArrowDown" Width="15" Height="15" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource Btn_SaveReplay}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Pause / Resume (only while recording) -->
        <Button Grid.Column="4" Classes="tbar" Margin="9,0,0,0"
                Command="{Binding TogglePauseRecordingCommand}"
                IsVisible="{Binding IsRecording}">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <mi:MaterialIcon Kind="Pause" Width="13" Height="13" VerticalAlignment="Center"
                             IsVisible="{Binding !IsPaused}" />
            <mi:MaterialIcon Kind="Play" Width="13" Height="13" VerticalAlignment="Center"
                             IsVisible="{Binding IsPaused}" />
            <TextBlock Text="{DynamicResource Btn_PauseRecording}" VerticalAlignment="Center"
                       IsVisible="{Binding !IsPaused}" />
            <TextBlock Text="{DynamicResource Btn_ResumeRecording}" VerticalAlignment="Center"
                       IsVisible="{Binding IsPaused}" />
          </StackPanel>
        </Button>

        <!-- Spacer (drag zone) -->
        <Panel Grid.Column="5" Background="Transparent" PointerPressed="OnTitleBarPointerPressed" />

        <!-- Status pill -->
        <Border Grid.Column="6" Background="{StaticResource SurfaceCard}"
                BorderBrush="{StaticResource BorderCard}" BorderThickness="1"
                CornerRadius="11" Padding="14,7" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="{StaticResource StatusIdle}"
                     IsVisible="{Binding !IsRecording}" VerticalAlignment="Center" />
            <Ellipse Width="8" Height="8" Classes="recpulse" Fill="{StaticResource RecDot}"
                     IsVisible="{Binding IsRecording}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{StaticResource TextKbd}" VerticalAlignment="Center"
                       MinWidth="62" TextTrimming="CharacterEllipsis" MaxWidth="160" />
            <ProgressBar Classes="buffer" Width="74" Height="5" VerticalAlignment="Center"
                         Minimum="0" Maximum="100" Value="{Binding BufferFillPercent}" />
            <TextBlock Text="{Binding BufferStatus}" FontFamily="{StaticResource FontMono}"
                       FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Window controls -->
        <StackPanel Grid.Column="7" Orientation="Horizontal" Margin="4,0,0,0">
          <Button Classes="wctl" Click="OnMinimizeClick">
            <mi:MaterialIcon Kind="WindowMinimize" Width="14" Height="14" />
          </Button>
          <Button Classes="wctl" Click="OnMaximizeClick">
            <mi:MaterialIcon Kind="SquareRoundedOutline" Width="11" Height="11" />
          </Button>
          <Button Classes="wctl close" Click="OnCloseClick">
            <mi:MaterialIcon Kind="WindowClose" Width="14" Height="14" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══════════════ BODY: icon rail + content ═══════════════ -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

      <!-- ICON RAIL (78px) -->
      <Border Grid.Column="0" Width="78" Background="{StaticResource SurfaceApp}"
              BorderBrush="{StaticResource BorderCard}" BorderThickness="0,0,1,0"
              IsVisible="{Binding !IsFullscreen}">
        <DockPanel Margin="0,14">
          <!-- Settings pinned to the bottom -->
          <Button DockPanel.Dock="Bottom" x:Name="RailSettings" Classes="railitem"
                  HorizontalAlignment="Center"
                  Command="{Binding NavigateToSettingsCommand}">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <mi:MaterialIcon Kind="Tune" Width="20" Height="20" HorizontalAlignment="Center" />
              <TextBlock Text="{DynamicResource Nav_Settings}" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>

          <StackPanel DockPanel.Dock="Top" Spacing="6" HorizontalAlignment="Center">
            <Button x:Name="RailLibrary" Classes="railitem" Command="{Binding NavigateToLibraryCommand}">
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <mi:MaterialIcon Kind="ViewGridOutline" Width="20" Height="20" HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource Nav_Library}" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="RailPlayer" Classes="railitem" Command="{Binding NavigateToPlayerCommand}">
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <mi:MaterialIcon Kind="Play" Width="20" Height="20" HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource Nav_Player}" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="RailEditor" Classes="railitem" Command="{Binding OpenEditorFromPlayerCommand}">
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <mi:MaterialIcon Kind="PencilOutline" Width="20" Height="20" HorizontalAlignment="Center" />
                <TextBlock Text="Editor" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Animated view host -->
      <TransitioningContentControl Grid.Column="1"
                                   x:Name="ContentHost"
                                   Background="{StaticResource SurfaceApp}"
                                   Content="{Binding CurrentView}">
        <TransitioningContentControl.PageTransition>
          <CrossFade Duration="0:0:0.18" />
        </TransitioningContentControl.PageTransition>
      </TransitioningContentControl>
    </Grid>
  </Grid>

</Window>
