<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lag.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:controls="using:Lag.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Lag.Views.EditorView"
             x:DataType="vm:EditorViewModel"
             Focusable="True">

  <!-- Spacebar toggles preview play/pause -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Space" Command="{Binding PlayPauseCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <!-- Timeline rows (video strip + audio tracks): Shift+click selects, accent outline -->
    <Style Selector="Border.trow">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.trow.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentDim}" />
    </Style>

    <!-- Crop-box resize handles (8 around the reframe rectangle) -->
    <Style Selector="Border.chandle">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="White" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Filter cards: vertical wrap grid in the tools panel -->
    <Style Selector="ListBox.filters">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.filters ListBoxItem">
      <Setter Property="Padding" Value="2" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.filters ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.filters ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#20262E" />
    </Style>
    <Style Selector="ListBox.filters ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ListBox.filters TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    </Style>
    <Style Selector="ListBox.filters ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Clip-picker card in the left sidebar -->
    <Style Selector="Button.clipitem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.clipitem /template/ ContentPresenter">
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions></Setter>
    </Style>
    <Style Selector="Button.clipitem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="24,20,24,24">

    <!-- ── Header: title/clip + export ── -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,14">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="{DynamicResource Editor_Title}" FontFamily="{StaticResource FontDisplay}"
                   FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextHi}" />
        <TextBlock Text="{Binding CurrentClip.DisplayName, FallbackValue=''}"
                   FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                   TextTrimming="CharacterEllipsis" MaxWidth="420" />
      </StackPanel>

      <TextBlock Grid.Column="2" Text="{Binding ExportStatus}"
                 FontSize="12" Foreground="{DynamicResource TextMuted}"
                 VerticalAlignment="Center" Margin="0,0,12,0"
                 MaxWidth="340" TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding ExportStatus}" />

      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="rchip"
                x:CompileBindings="False"
                Command="{Binding $parent[Window].DataContext.NavigateToPlayerCommand}"
                Content="{DynamicResource Editor_Back}" />

        <!-- Export button → opens a flyout with resolution / format / GIF + the Export action. -->
        <Button Classes="cta" MinWidth="140" IsVisible="{Binding !IsExporting}">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <mi:MaterialIcon Kind="MovieCheckOutline" Width="15" Height="15" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource Editor_Export}" VerticalAlignment="Center" />
            <mi:MaterialIcon Kind="ChevronDown" Width="14" Height="14" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="230" Spacing="14" Margin="4">
                <TextBlock Text="{DynamicResource Editor_ExportOptions}" FontWeight="Medium" FontSize="13" />
                <StackPanel Spacing="6">
                  <TextBlock Text="{DynamicResource Editor_ExportResolution}" FontSize="12"
                             Foreground="{DynamicResource Fg2Brush}" />
                  <ComboBox HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ExportResolutionOptions}"
                            SelectedItem="{Binding SelectedExportResolution}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:EditorExportRes">
                        <TextBlock Text="{Binding Display}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Spacing="6" IsVisible="{Binding !ExportAsGif}">
                  <TextBlock Text="{DynamicResource Editor_Format}" FontSize="12"
                             Foreground="{DynamicResource Fg2Brush}" />
                  <ComboBox HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ExportFormatOptions}"
                            SelectedItem="{Binding SelectedExportFormat}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding ExportAsGif}" Content="{DynamicResource Editor_ExportGif}" />
                <Button Classes="cta" HorizontalAlignment="Stretch"
                        Command="{Binding ExportCommand}"
                        Content="{DynamicResource Editor_Export}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <!-- While exporting: progress + cancel. -->
        <Button Classes="cta" MinWidth="140" IsVisible="{Binding IsExporting}"
                Command="{Binding CancelExportCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <mi:MaterialIcon Kind="Close" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ExportProgress, StringFormat='{}{0}%'}" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource Editor_CancelExport}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ── Workspace: preview + timeline | tools panel ── -->
    <Grid Grid.Row="1" ColumnDefinitions="240,*,286">

      <!-- ── Clip-picker sidebar: choose which video to edit ── -->
      <Border Grid.Column="0" Margin="0,0,14,0" Background="{DynamicResource SurfaceCard}"
              BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="14" Padding="0,14">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="{DynamicResource Editor_Clips}" Margin="16,0,16,10"
                     FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource TextFaintest}" />
          <ScrollViewer Grid.Row="1" Padding="8,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding $parent[Window].DataContext.EditableClips}" x:CompileBindings="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="clipitem" x:CompileBindings="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding $parent[Window].DataContext.OpenEditorForClipCommand}"
                          CommandParameter="{Binding}">
                    <!-- Fixed, slightly-narrower card centred in the 240px sidebar so the thumbnail never
                         reaches the right edge (and the overlay scrollbar can't clip it). -->
                    <StackPanel Spacing="6" Width="190" HorizontalAlignment="Center">
                      <Border Height="107" CornerRadius="8" ClipToBounds="True" Background="#16181E">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                      </Border>
                      <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextHi}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding ShortMeta}" FontFamily="{StaticResource FontMono}"
                                 FontSize="10" Foreground="{DynamicResource TextFaint}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="0,0,14,0">

        <!-- Video preview (#07090C, r12) — Avalonia-rendered frames, live-preview effects -->
        <Border Grid.Row="0" x:Name="VideoFrame"
                Background="#FF07090C" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
                CornerRadius="14" ClipToBounds="True" MinHeight="180">
          <Grid RowDefinitions="*,Auto">
            <Panel Grid.Row="0" x:Name="VideoSurface" Background="Transparent">
              <!-- Video + reframe overlay share ONE container so rotate/flip transforms them together
                   (handles stay aligned with the video); the deselect button stays upright outside it. -->
              <Grid x:Name="PreviewContent" RenderTransformOrigin="50%,50%">
                <!-- The video itself, free-positioned/scaled by the reframe transform
                     (Stretch=Fill lets it be stretched/narrowed non-uniformly). -->
                <Canvas x:Name="VideoCanvas" Background="Transparent">
                  <Image x:Name="VideoImage" Stretch="Fill"
                         RenderOptions.BitmapInterpolationMode="HighQuality" />
                </Canvas>

                <!-- Reframe overlay: drag the video to MOVE it, drag a handle to ZOOM/STRETCH, click
                     outside the video to play/pause, right-click to reset. The dim shades mark the area
                     OUTSIDE the output frame (cropped away on export). Laid out in code-behind. -->
                <Canvas x:Name="CropOverlay" Background="Transparent"
                        PointerPressed="OnCropPointerPressed"
                        PointerMoved="OnCropPointerMoved"
                        PointerReleased="OnCropPointerReleased">
                  <Border x:Name="CropShadeTop"    Background="#99000000" IsHitTestVisible="False" />
                  <Border x:Name="CropShadeBottom" Background="#99000000" IsHitTestVisible="False" />
                  <Border x:Name="CropShadeLeft"   Background="#99000000" IsHitTestVisible="False" />
                  <Border x:Name="CropShadeRight"  Background="#99000000" IsHitTestVisible="False" />
                  <Border x:Name="FrameOutline" BorderBrush="White" BorderThickness="1"
                          Opacity="0.55" Background="Transparent" IsHitTestVisible="False" />
                  <Border x:Name="CropRect" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                          Background="Transparent" IsHitTestVisible="False" />
                  <Border x:Name="HTL" Classes="chandle" /><Border x:Name="HTR" Classes="chandle" />
                  <Border x:Name="HBL" Classes="chandle" /><Border x:Name="HBR" Classes="chandle" />
                  <Border x:Name="HT"  Classes="chandle" /><Border x:Name="HB"  Classes="chandle" />
                  <Border x:Name="HL"  Classes="chandle" /><Border x:Name="HR"  Classes="chandle" />
                </Canvas>
              </Grid>

              <!-- Caption overlay: draggable text on the output frame (Background=null so empty
                   clicks fall through to the reframe overlay below; only captions are hit-testable). -->
              <Canvas x:Name="TextOverlay" Background="{x:Null}" />

              <!-- Empty state: no clip loaded — prompt to pick one from the sidebar -->
              <TextBlock Text="{DynamicResource Editor_PickClip}" IsHitTestVisible="False"
                         IsVisible="{Binding CurrentClip, Converter={x:Static conv:ObjectConverters.IsNull}}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontSize="14" Foreground="{DynamicResource TextFaint}" />

              <!-- Deselect button (top-right), shown only while the reframe box is selected. -->
              <Button x:Name="DeselectButton" Classes="chip" IsVisible="False"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                      Click="OnDeselectClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <mi:MaterialIcon Kind="Close" Width="13" Height="13" VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Editor_Deselect}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Panel>

            <!-- Control bar -->
            <Border Grid.Row="1" Margin="12" Background="#D10A0C0F" CornerRadius="10" Padding="14,10">
              <Grid ColumnDefinitions="Auto,Auto,*">
                <Button Grid.Column="0" Width="30" Height="30" CornerRadius="15" Padding="0"
                        Background="White" BorderThickness="0" Cursor="Hand"
                        Focusable="False"
                        Command="{Binding PlayPauseCommand}"
                        ToolTip.Tip="{DynamicResource Tooltip_PlayPause}">
                  <Panel>
                    <mi:MaterialIcon Kind="Play" Width="15" Height="15"
                                     Foreground="{DynamicResource OnAccentBrush}"
                                     IsVisible="{Binding !IsPlaying}" />
                    <mi:MaterialIcon Kind="Pause" Width="14" Height="14"
                                     Foreground="{DynamicResource OnAccentBrush}"
                                     IsVisible="{Binding IsPlaying}" />
                  </Panel>
                </Button>

                <TextBlock Grid.Column="1" Text="{Binding TimeDisplay}" Margin="12,0,0,0"
                           FontSize="11" Foreground="{DynamicResource Fg2Brush}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button Classes="chip" Focusable="False" Command="{Binding SetTrimStartHereCommand}"
                          ToolTip.Tip="{DynamicResource Editor_SetStart}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <mi:MaterialIcon Kind="ArrowCollapseLeft" Width="14" Height="14" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding TrimStartDisplay}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="chip" Focusable="False" Command="{Binding SetTrimEndHereCommand}"
                          ToolTip.Tip="{DynamicResource Editor_SetEnd}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding TrimEndDisplay}" FontSize="12" VerticalAlignment="Center" />
                      <mi:MaterialIcon Kind="ArrowCollapseRight" Width="14" Height="14" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="chip" Focusable="False" Command="{Binding ToggleCutCommand}"
                          ToolTip.Tip="{DynamicResource Editor_Cut}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <mi:MaterialIcon Kind="ContentCut" Width="14" Height="14" VerticalAlignment="Center" />
                      <TextBlock Text="{DynamicResource Editor_Cut}" FontSize="12" VerticalAlignment="Center"
                                 IsVisible="{Binding !IsMarkingCut}" />
                      <TextBlock Text="{DynamicResource Editor_CutEnd}" FontSize="12" VerticalAlignment="Center"
                                 Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsMarkingCut}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="transport" Command="{Binding ResetTrimCommand}"
                          ToolTip.Tip="{DynamicResource Editor_ResetTrim}">
                    <mi:MaterialIcon Kind="Restore" Width="16" Height="16" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <!-- Timeline: video strip + audio tracks right under it -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}"
                BorderThickness="1" CornerRadius="14"
                Padding="10,8,10,10" Margin="0,14,0,0">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,2">
              <TextBlock Grid.Column="0" Text="{Binding TrimStartDisplay}"
                         FontSize="11" Foreground="{DynamicResource Fg3Brush}" />
              <TextBlock Grid.Column="1" Text="{Binding TrimDurationDisplay}"
                         FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding TrimEndDisplay}"
                         FontSize="11" Foreground="{DynamicResource Fg3Brush}" />
            </Grid>

            <!-- Video row -->
            <Border Classes="trow" Classes.selected="{Binding IsVideoSelected}">
              <Panel x:Name="TimelinePanel" Height="56" Background="#10151B">
                <ItemsControl ItemsSource="{Binding TimelineThumbs}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Image Source="{Binding}" Stretch="UniformToFill" Height="56" ClipToBounds="True" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Canvas x:Name="TimelineOverlay" Background="Transparent">
                  <Border x:Name="LeftShade" Canvas.Left="0" Canvas.Top="0" Height="56"
                          Background="#B30A0C0F" IsHitTestVisible="False" />
                  <Border x:Name="RightShade" Canvas.Top="0" Height="56"
                          Background="#B30A0C0F" IsHitTestVisible="False" />
                  <Border x:Name="Playhead" Canvas.Top="0" Width="2" Height="56"
                          Background="White" Opacity="0.9" IsHitTestVisible="False" />
                  <Border x:Name="StartHandle" Canvas.Top="0" Width="10" Height="56"
                          Background="{DynamicResource AccentBrush}" CornerRadius="3,0,0,3"
                          Cursor="SizeWestEast" IsHitTestVisible="False">
                    <Border Width="2" Height="18" CornerRadius="1"
                            Background="{DynamicResource OnAccentBrush}" Opacity="0.65"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Border x:Name="EndHandle" Canvas.Top="0" Width="10" Height="56"
                          Background="{DynamicResource AccentBrush}" CornerRadius="0,3,3,0"
                          Cursor="SizeWestEast" IsHitTestVisible="False">
                    <Border Width="2" Height="18" CornerRadius="1"
                            Background="{DynamicResource OnAccentBrush}" Opacity="0.65"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Canvas>
              </Panel>
            </Border>

            <!-- Audio track lanes: full-width, same x-scale as the video strip above,
                 so the trim handles line up with the video timings 1:1. Name/mute and
                 volume float as chips OVER the lane (the lane stays draggable around
                 them and in the thin strips above/below). -->
            <ItemsControl ItemsSource="{Binding AudioTracks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EditorAudioTrack">
                  <Border Classes="trow" Classes.selected="{Binding IsSelected}"
                          PointerPressed="OnTrackRowPressed">
                    <Panel Height="32">
                      <controls:TrimRangeBar x:CompileBindings="False"
                                             Duration="{Binding ClipDurationSec}"
                                             RangeStart="{Binding StartSec, Mode=TwoWay}"
                                             RangeEnd="{Binding EndSec, Mode=TwoWay}"
                                             SnapA="{Binding $parent[UserControl].DataContext.TrimStartSec}"
                                             SnapB="{Binding $parent[UserControl].DataContext.TrimEndSec}"
                                             IsEnabled="{Binding !IsMuted}" />

                      <!-- Name + mute chip (kept clear of the left handle) -->
                      <Border Background="{DynamicResource Overlay85Brush}" CornerRadius="6"
                              Padding="8,3" Margin="16,0,0,0"
                              HorizontalAlignment="Left" VerticalAlignment="Center">
                        <CheckBox Classes="app" VerticalAlignment="Center"
                                  IsChecked="{Binding !IsMuted}">
                          <TextBlock Text="{Binding Name}" FontSize="11"
                                     TextTrimming="CharacterEllipsis" MaxWidth="130" />
                        </CheckBox>
                      </Border>

                      <!-- Volume chip (kept clear of the right handle) -->
                      <Border Background="{DynamicResource Overlay85Brush}" CornerRadius="6"
                              Padding="8,2" Margin="0,0,16,0"
                              HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Slider Width="72" Minimum="0" Maximum="100"
                                  TickFrequency="1" IsSnapToTickEnabled="True"
                                  Value="{Binding Volume}"
                                  IsEnabled="{Binding !IsMuted}"
                                  VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Volume, StringFormat='{}{0}%'}"
                                     FontSize="10" Foreground="{DynamicResource Fg2Brush}"
                                     Width="30" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ── Tools panel: tabs Clip | Filters ── -->
      <Border Grid.Column="2" Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderCard}"
              BorderThickness="1" CornerRadius="14" Padding="16,14">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Classes="rsegtrack" Margin="0,0,0,16">
            <UniformGrid Columns="3">
              <Button Classes="rseg" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Classes.sel="{Binding SelectedToolsTab, Converter={StaticResource Eq}, ConverterParameter=0}"
                      Click="OnToolsTabClick" Tag="0" Content="{DynamicResource Editor_TabClip}" />
              <Button Classes="rseg" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Classes.sel="{Binding SelectedToolsTab, Converter={StaticResource Eq}, ConverterParameter=1}"
                      Click="OnToolsTabClick" Tag="1" Content="{DynamicResource Editor_TabFilters}" />
              <Button Classes="rseg" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Classes.sel="{Binding SelectedToolsTab, Converter={StaticResource Eq}, ConverterParameter=2}"
                      Click="OnToolsTabClick" Tag="2" Content="{DynamicResource Editor_TabText}" />
            </UniformGrid>
          </Border>

          <Carousel Grid.Row="1" SelectedIndex="{Binding SelectedToolsTab}">
            <Carousel.PageTransition>
              <CrossFade Duration="0:0:0.15" />
            </Carousel.PageTransition>

            <!-- TAB 0 · CLIP -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="14">
                <StackPanel Spacing="6">
                  <TextBlock Text="{DynamicResource Editor_Format}" FontSize="12"
                             Foreground="{DynamicResource Fg2Brush}" />
                  <ComboBox HorizontalAlignment="Stretch"
                            ItemsSource="{Binding AspectOptions}"
                            SelectedItem="{Binding SelectedAspect}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:EditorAspectOption">
                        <TextBlock Text="{Binding Display}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <!-- Crop tool: a SEPARATE mode — toggles the preview box to select a sub-region of
                     the source to keep. Independent of Format/reframe (applied before them). -->
                <ToggleButton IsChecked="{Binding CropToolActive}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              Cursor="Hand" Padding="12,8">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="Crop" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Editor_Crop}" VerticalAlignment="Center" />
                  </StackPanel>
                </ToggleButton>

                <!-- Rotate / flip the final output -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="transport" Command="{Binding RotateLeftCommand}">
                    <mi:MaterialIcon Kind="RotateLeft" Width="16" Height="16" />
                  </Button>
                  <Button Classes="transport" Command="{Binding RotateRightCommand}">
                    <mi:MaterialIcon Kind="RotateRight" Width="16" Height="16" />
                  </Button>
                  <Button Classes="transport" Command="{Binding ToggleFlipHCommand}">
                    <mi:MaterialIcon Kind="FlipHorizontal" Width="16" Height="16" />
                  </Button>
                  <Button Classes="transport" Command="{Binding ToggleFlipVCommand}">
                    <mi:MaterialIcon Kind="FlipVertical" Width="16" Height="16" />
                  </Button>
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="{DynamicResource Editor_Speed}" FontSize="12"
                             Foreground="{DynamicResource Fg2Brush}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:SegmentedListBox Classes="segctl" VerticalAlignment="Center"
                                               ItemsSource="{Binding SpeedOptions}"
                                               SelectedItem="{Binding SelectedSpeed}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:EditorSpeedOption">
                          <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </controls:SegmentedListBox>
                    <TextBox Width="52" VerticalAlignment="Center"
                             Text="{Binding SpeedText}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <!-- TAB 1 · FILTERS -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="14">
                <ListBox Classes="filters"
                         ItemsSource="{Binding FilterOptions}"
                         SelectedItem="{Binding SelectedFilter}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EditorFilterOption">
                      <StackPanel Spacing="3" Width="78">
                        <Border Width="74" Height="42" CornerRadius="8" Background="#10151B"
                                ClipToBounds="True" HorizontalAlignment="Center">
                          <Panel>
                            <Panel.Clip>
                              <RectangleGeometry Rect="0,0,74,42" RadiusX="8" RadiusY="8" />
                            </Panel.Clip>
                            <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                          </Panel>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="10"
                                   HorizontalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <Border Height="1" Background="{DynamicResource Divider6Brush}" />

                <!-- Manual colour sliders (combine with the selected preset) -->
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Editor_Color}" FontSize="12"
                               Foreground="{DynamicResource Fg2Brush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="transport" Command="{Binding ResetColorCommand}">
                      <mi:MaterialIcon Kind="Restore" Width="14" Height="14" />
                    </Button>
                  </Grid>

                  <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{DynamicResource Editor_Brightness}" FontSize="11" Foreground="{DynamicResource Fg3Brush}" />
                      <TextBlock Grid.Column="1" Text="{Binding ColorBrightness, StringFormat='{}{0}%'}" FontSize="11" Foreground="{DynamicResource Fg3Brush}" />
                    </Grid>
                    <Slider Minimum="0" Maximum="200" Value="{Binding ColorBrightness}" PointerPressed="OnColorSliderPressed" />
                  </StackPanel>

                  <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{DynamicResource Editor_Contrast}" FontSize="11" Foreground="{DynamicResource Fg3Brush}" />
                      <TextBlock Grid.Column="1" Text="{Binding ColorContrast, StringFormat='{}{0}%'}" FontSize="11" Foreground="{DynamicResource Fg3Brush}" />
                    </Grid>
                    <Slider Minimum="0" Maximum="200" Value="{Binding ColorContrast}" PointerPressed="OnColorSliderPressed" />
                  </StackPanel>

                  <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{DynamicResource Editor_Saturation}" FontSize="11" Foreground="{DynamicResource Fg3Brush}" />
                      <TextBlock Grid.Column="1" Text="{Binding ColorSaturation, StringFormat='{}{0}%'}" FontSize="11" Foreground="{DynamicResource Fg3Brush}" />
                    </Grid>
                    <Slider Minimum="0" Maximum="200" Value="{Binding ColorSaturation}" PointerPressed="OnColorSliderPressed" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <!-- TAB 2 · TEXT -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="14">
                <Button Classes="cta" HorizontalAlignment="Stretch" Command="{Binding AddTextCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="Plus" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Editor_AddText}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <StackPanel Spacing="10"
                            IsVisible="{Binding SelectedText, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                  <TextBox Text="{Binding SelectedText.Text}" AcceptsReturn="False" />

                  <StackPanel Spacing="2">
                    <TextBlock Text="{DynamicResource Editor_TextSize}" FontSize="11"
                               Foreground="{DynamicResource Fg3Brush}" />
                    <Slider Minimum="3" Maximum="25" Value="{Binding SelectedText.FontPercent}" />
                  </StackPanel>

                  <ItemsControl ItemsSource="{Binding TextColors}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:EditorTextColor">
                        <Button Width="26" Height="26" Margin="0,0,6,6" CornerRadius="13" Padding="0"
                                x:CompileBindings="False" Cursor="Hand"
                                Background="{Binding Brush}" BorderBrush="#50FFFFFF" BorderThickness="1"
                                Command="{Binding $parent[ItemsControl].DataContext.SetTextColorCommand}"
                                CommandParameter="{Binding Hex}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button Classes="chip" HorizontalAlignment="Left" Command="{Binding RemoveSelectedTextCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <mi:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" VerticalAlignment="Center" />
                      <TextBlock Text="{DynamicResource Editor_DeleteText}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <TextBlock Text="{DynamicResource Editor_TextHint}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Fg3Brush}" IsVisible="{Binding !HasTexts}" />
              </StackPanel>
            </ScrollViewer>
          </Carousel>
        </Grid>
      </Border>
    </Grid>
  </Grid>

</UserControl>
