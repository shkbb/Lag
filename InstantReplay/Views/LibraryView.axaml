<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lag.ViewModels"
             xmlns:models="using:Lag.Models"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="Lag.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

  <Grid RowDefinitions="Auto,*">

    <!-- Header: title left, free-space indicator + "Open folder" right -->
    <DockPanel Grid.Row="0" Margin="30,22,30,0">

      <!-- Open Folder button (far right) -->
      <Button DockPanel.Dock="Right" Classes="btn-save"
              Command="{Binding OpenLibraryFolderCommand}"
              Height="36" Padding="14,0" VerticalAlignment="Center"
              HorizontalAlignment="Right" Margin="10,0,0,0">
        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
          <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15"
                                      VerticalAlignment="Center" />
          <TextBlock Text="{DynamicResource Library_OpenFolder}" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- Free space indicator (glass pill) -->
      <Border DockPanel.Dock="Right" VerticalAlignment="Center"
              Background="{StaticResource GlassFillBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
              CornerRadius="10" Padding="12,7">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <materialIcons:MaterialIcon Kind="HarddiskPlus" Width="14" Height="14"
                                      Foreground="{StaticResource AccentCyanBrush}"
                                      VerticalAlignment="Center" />
          <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="#8FFFFFFF">
            <Run Text="{DynamicResource Library_FreeSpace}" /><Run Text=": " />
            <Run Text="{Binding FreeSpaceDisplay}" Foreground="{StaticResource AccentCyanBrush}" />
          </TextBlock>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding UsedSpacePercent}"
                       Width="64" Height="4" VerticalAlignment="Center"
                       Foreground="{StaticResource AccentCyanBrush}" Background="#1FFFFFFF" />
        </StackPanel>
      </Border>

      <!-- Title -->
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Classes="page-title" Text="{DynamicResource Library_Title}" />
        <TextBlock Text="{DynamicResource Library_Subtitle}"
                   FontSize="12" Foreground="{StaticResource TextDimBrush}" />
      </StackPanel>
    </DockPanel>

    <!-- Loading indicator -->
    <ProgressBar Grid.Row="0" IsIndeterminate="True"
                 IsVisible="{Binding IsLoading}"
                 Height="2" Margin="24,0"
                 VerticalAlignment="Bottom"
                 Foreground="{StaticResource AccentPurpleBrush}" />

    <!-- Clip Gallery -->
    <ScrollViewer Grid.Row="1" Margin="18,16,18,0"
                  VerticalScrollBarVisibility="Auto">
      <Panel>
        <!-- Empty state -->
        <TextBlock Text="{DynamicResource Library_Empty}"
                   IsVisible="{Binding !Clips.Count}"
                   Foreground="{StaticResource TextDimBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                   Margin="0,80" FontSize="14" />

        <ItemsControl ItemsSource="{Binding Clips}"
                      IsVisible="{Binding Clips.Count}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:ReplayClip">
              <Button Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).PlayClipCommand}"
                      CommandParameter="{Binding}"
                      Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">

                <!-- Right-click actions. MenuItem clicks are routed through code-behind because
                     bindings inside a ContextMenu popup can't reliably reach the view-model. -->
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{DynamicResource Library_ShowInFolder}"
                              Click="OnShowInFolderClick">
                      <MenuItem.Icon>
                        <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="16" Height="16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Library_Delete}"
                              Click="OnDeleteClipClick">
                      <MenuItem.Icon>
                        <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" />
                      </MenuItem.Icon>
                    </MenuItem>
                  </ContextMenu>
                </Button.ContextMenu>

                <Border Classes="replay-card" Width="204" Margin="8">
                <StackPanel>

                  <!-- Thumbnail area -->
                  <Grid Height="108">
                    <Border CornerRadius="14,14,0,0" ClipToBounds="True">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                          <GradientStop Color="#0a1628" Offset="0" />
                          <GradientStop Color="#141a35" Offset="1" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <Image Source="{Binding Thumbnail}"
                             Stretch="UniformToFill" />
                    </Border>

                    <!-- Play icon -->
                    <materialIcons:MaterialIcon Kind="PlayCircleOutline" Width="32" Height="32"
                                                Opacity="0.65" Foreground="White"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />

                    <!-- Duration badge -->
                    <Border Background="#99000000" CornerRadius="3"
                            Padding="5,2" Margin="0,0,6,5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                      <TextBlock Text="{Binding DurationDisplay}"
                                 FontSize="10"
                                 Foreground="#A6FFFFFF" />
                    </Border>

                    <!-- Delete button (top-right). Binds to the VM via the ItemsControl ancestor,
                         which is reliably in the visual tree (popups/flyouts are not). -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,5,5,0" Width="26" Height="26" CornerRadius="13" Padding="0"
                            Background="#99000000" BorderThickness="0" Cursor="Hand"
                            ToolTip.Tip="{DynamicResource Library_Delete}"
                            Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).DeleteClipCommand}"
                            CommandParameter="{Binding}">
                      <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14"
                                                  Foreground="#E6FFFFFF"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                  </Grid>

                  <!-- Info area -->
                  <StackPanel Margin="10,8,10,8" Spacing="2">
                    <TextBlock Text="{Binding CreatedDate, StringFormat='{}{0:MMM dd, yyyy  HH:mm}'}"
                               FontSize="12" FontWeight="Medium"
                               Foreground="#BFFFFFFF" />
                    <TextBlock Text="{Binding FileSizeDisplay}"
                               FontSize="10"
                               Foreground="#4DFFFFFF" />
                  </StackPanel>

                </StackPanel>
              </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
    </ScrollViewer>

  </Grid>

</UserControl>
