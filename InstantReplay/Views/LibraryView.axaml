<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lag.ViewModels"
             xmlns:models="using:Lag.Models"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Lag.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

  <Grid RowDefinitions="Auto,*" Margin="24,20,24,0">

    <!-- ── Header: title + stats | Open folder ── -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="{DynamicResource Library_Title}" FontSize="16" FontWeight="Medium" />
        <TextBlock Text="{Binding LibraryStats}" FontSize="12"
                   Foreground="{StaticResource Fg2Brush}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <!-- Bulk delete — appears once any card is selected -->
        <Button Classes="chip danger" VerticalAlignment="Center"
                IsVisible="{Binding HasSelection}"
                Command="{Binding DeleteSelectedCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Text="{Binding DeleteSelectedLabel}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="chip" VerticalAlignment="Center"
                Command="{Binding OpenLibraryFolderCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="FolderOutline" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource Library_OpenFolder}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <ProgressBar Grid.Row="0" IsIndeterminate="True"
                 IsVisible="{Binding IsLoading}"
                 Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-10"
                 Foreground="{StaticResource AccentBrush}" Background="Transparent" />

    <!-- ── Clip grid ── -->
    <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
      <Panel>

        <!-- Empty state (frame 2:2) -->
        <StackPanel IsVisible="{Binding !Clips.Count}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="0,140,0,0" Spacing="14">
          <Viewbox Width="44" Height="44" HorizontalAlignment="Center">
            <Canvas Width="22" Height="22">
              <Path Data="{StaticResource LogoArcGeometry}" Stroke="{StaticResource EmptyIconBrush}"
                    StrokeThickness="0.8" StrokeLineCap="Round" StrokeJoin="Round" />
              <Path Data="{StaticResource LogoCornerGeometry}" Stroke="{StaticResource EmptyIconBrush}"
                    StrokeThickness="0.8" StrokeLineCap="Round" StrokeJoin="Round" />
              <Path Data="{StaticResource LogoHandsGeometry}" Stroke="{StaticResource EmptyIconBrush}"
                    StrokeThickness="0.8" StrokeLineCap="Round" StrokeJoin="Round" />
            </Canvas>
          </Viewbox>
          <TextBlock Text="{DynamicResource Library_EmptyTitle}" FontSize="16" FontWeight="Medium"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{DynamicResource Library_Empty}" FontSize="13" LineHeight="20"
                     Foreground="{StaticResource Fg2Brush}"
                     TextWrapping="Wrap" TextAlignment="Center" MaxWidth="430"
                     HorizontalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding $parent[Window].DataContext.Settings.HotkeyParts}"
                        x:CompileBindings="False"
                        HorizontalAlignment="Center" Margin="0,2,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="kbd"><TextBlock Text="{Binding}" /></Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Cards (frame 1:2): 300px, r12, preview 16:9, meta -->
        <ItemsControl ItemsSource="{Binding Clips}" IsVisible="{Binding Clips.Count}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:ReplayClip">
              <Button Classes="clipcard" Width="300" Margin="0,0,16,16"
                      Classes.selected="{Binding IsSelected}"
                      Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).PlayClipCommand}"
                      CommandParameter="{Binding}">

                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{DynamicResource Editor_Edit}" Click="OnEditClipClick">
                      <MenuItem.Icon>
                        <mi:MaterialIcon Kind="MovieEditOutline" Width="16" Height="16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Library_ShowInFolder}" Click="OnShowInFolderClick">
                      <MenuItem.Icon>
                        <mi:MaterialIcon Kind="FolderSearchOutline" Width="16" Height="16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Library_Delete}" Click="OnDeleteClipClick">
                      <MenuItem.Icon>
                        <mi:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" />
                      </MenuItem.Icon>
                    </MenuItem>
                  </ContextMenu>
                </Button.ContextMenu>

                <StackPanel>
                  <!-- Preview 300×169. The clip geometry is 12px taller than the preview,
                       so only the TOP corners are rounded (r12, like the card) while the
                       bottom edge stays square against the meta block. -->
                  <Grid Height="169" ClipToBounds="True">
                    <Grid.Clip>
                      <RectangleGeometry Rect="0,0,300,181" RadiusX="12" RadiusY="12" />
                    </Grid.Clip>
                    <Border Background="#232A33" />
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />

                    <!-- hover veil (4% white) -->
                    <Border x:Name="HoverVeil" Background="{StaticResource HoverVeilBrush}" />

                    <!-- duration chip (hidden for screenshots) -->
                    <Border Background="{StaticResource Overlay85Brush}" CornerRadius="6"
                            Padding="6,2" Margin="0,0,8,8"
                            IsVisible="{Binding !IsImage}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                      <TextBlock Text="{Binding DurationDisplay}" FontSize="11" FontWeight="Medium" />
                    </Border>

                    <!-- select toggle (reveals on hover, stays while selected) -->
                    <Button x:Name="SelectBtn" Width="28" Height="28" CornerRadius="8" Padding="0"
                            Classes.checked="{Binding IsSelected}"
                            Background="{StaticResource Overlay88Brush}" BorderThickness="0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                            Cursor="Hand"
                            Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).ToggleSelectCommand}"
                            CommandParameter="{Binding}">
                      <Panel>
                        <mi:MaterialIcon Kind="CheckboxBlankCircleOutline" Width="15" Height="15"
                                         Foreground="{StaticResource FgBrush}"
                                         IsVisible="{Binding !IsSelected}" />
                        <mi:MaterialIcon Kind="CheckCircle" Width="15" Height="15"
                                         Foreground="{StaticResource AccentBrush}"
                                         IsVisible="{Binding IsSelected}" />
                      </Panel>
                    </Button>
                  </Grid>

                  <!-- Meta -->
                  <StackPanel Margin="12,10,12,12" Spacing="3">
                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CreatedDate, StringFormat='{}{0:d MMM, HH:mm}'}"
                               FontSize="11" Foreground="{StaticResource Fg3Brush}" />
                  </StackPanel>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
    </ScrollViewer>

  </Grid>

</UserControl>
