<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lag.ViewModels"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="Lag.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="28,18,28,0">

    <!-- Page Title -->
    <StackPanel Grid.Row="0" Spacing="6" MaxWidth="860" HorizontalAlignment="Stretch">
      <TextBlock Classes="page-title" Text="{DynamicResource Settings_Title}" />

      <!-- Pending Changes Warning -->
      <TextBlock Text="{DynamicResource Settings_PendingChanges}"
                 Foreground="#FFA000" FontSize="13" FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasPendingChanges}" />
    </StackPanel>

    <!-- ═══════════════════ Category Tabs ═══════════════════ -->
    <TabControl Grid.Row="2" Margin="0,6,0,0">

      <!-- ════════════════ TAB: VIDEO ════════════════ -->
      <TabItem Header="{DynamicResource Tab_Video}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,14,0,28" Spacing="22" MaxWidth="820" HorizontalAlignment="Center">

            <StackPanel Spacing="8">
              <TextBlock Classes="group-label" Text="{DynamicResource Settings_Group_Recording}" />

              <Border Classes="card">
                <StackPanel>

                  <!-- Buffer Duration -->
                  <DockPanel Margin="16,11">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_BufferLength}"
                               FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                    <ComboBox DockPanel.Dock="Right"
                              ItemsSource="{Binding BufferOptions}"
                              SelectedItem="{Binding SelectedBuffer}"
                              HorizontalAlignment="Right" MinWidth="130" />
                  </DockPanel>

                  <Border Height="0.5" Background="#0DFFFFFF" />

                  <!-- Monitor -->
                  <DockPanel Margin="16,11">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_Display}"
                               FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                    <ComboBox DockPanel.Dock="Right"
                              ItemsSource="{Binding Monitors}"
                              SelectedItem="{Binding SelectedMonitor}"
                              HorizontalAlignment="Right" MinWidth="260" />
                  </DockPanel>

                  <Border Height="0.5" Background="#0DFFFFFF" />

                  <!-- Frame Rate: presets (24–360) + custom value -->
                  <DockPanel Margin="16,11">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_FrameRate}"
                               FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right">
                      <StackPanel Orientation="Horizontal" Spacing="6"
                                  IsVisible="{Binding IsCustomFps}">
                        <TextBox Text="{Binding CustomFps}" Width="56"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="fps" FontSize="12" Foreground="#8FFFFFFF"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                      <ComboBox ItemsSource="{Binding FpsOptions}"
                                SelectedItem="{Binding SelectedFps}"
                                MinWidth="96" />
                    </StackPanel>
                  </DockPanel>

                  <Border Height="0.5" Background="#0DFFFFFF" />

                  <!-- Output Resolution (render downscale; capture stays native) -->
                  <DockPanel Margin="16,11">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_OutputResolution}"
                               FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                    <ComboBox DockPanel.Dock="Right"
                              ItemsSource="{Binding ResolutionOptions}"
                              SelectedItem="{Binding SelectedResolution}"
                              HorizontalAlignment="Right" MinWidth="110" />
                  </DockPanel>

                  <Border Height="0.5" Background="#0DFFFFFF" />

                  <!-- Video Codec ("Auto" keeps the automatic hardware fallback) -->
                  <DockPanel Margin="16,11">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_Codec}"
                               FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                    <ComboBox DockPanel.Dock="Right"
                              ItemsSource="{Binding CodecOptions}"
                              SelectedItem="{Binding SelectedCodec}"
                              HorizontalAlignment="Right" MinWidth="160" />
                  </DockPanel>

                  <Border Height="0.5" Background="#0DFFFFFF" />

                  <!-- Bitrate: presets + custom Mbps input -->
                  <DockPanel Margin="16,11">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_Bitrate}"
                               FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right">
                      <StackPanel Orientation="Horizontal" Spacing="6"
                                  IsVisible="{Binding IsCustomBitrate}">
                        <TextBox Text="{Binding CustomBitrateMbps}" Width="64"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Settings_Bitrate_CustomSuffix}"
                                   FontSize="12" Foreground="#8FFFFFFF" VerticalAlignment="Center" />
                      </StackPanel>
                      <ComboBox ItemsSource="{Binding BitrateOptions}"
                                SelectedItem="{Binding SelectedBitrate}"
                                MinWidth="110" />
                    </StackPanel>
                  </DockPanel>

                  <Border Height="0.5" Background="#0DFFFFFF" />

                  <!-- Output file format (container) -->
                  <DockPanel Margin="16,11">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_Format}"
                               FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                    <ComboBox DockPanel.Dock="Right"
                              ItemsSource="{Binding FormatOptions}"
                              SelectedItem="{Binding SelectedFormat}"
                              HorizontalAlignment="Right" MinWidth="90" />
                  </DockPanel>

                  <Border Height="0.5" Background="#0DFFFFFF" />

                  <!-- Recording GPU (multi-GPU systems) -->
                  <DockPanel Margin="16,11">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_Gpu}"
                               FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                    <ComboBox DockPanel.Dock="Right"
                              ItemsSource="{Binding GpuOptions}"
                              SelectedItem="{Binding SelectedGpu}"
                              HorizontalAlignment="Right" MinWidth="240" />
                  </DockPanel>

                </StackPanel>
              </Border>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ════════════════ TAB: AUDIO ════════════════ -->
      <TabItem Header="{DynamicResource Tab_Audio}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,14,0,28" Spacing="22" MaxWidth="820" HorizontalAlignment="Center">

            <!-- ── Microphone ── -->
            <StackPanel Spacing="8">
              <TextBlock Classes="group-label" Text="{DynamicResource Settings_Group_Mic}" />

              <Border Classes="card">
                <StackPanel>

                  <!-- Device -->
                  <DockPanel Margin="16,11">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_Microphone}"
                               FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                    <ComboBox DockPanel.Dock="Right"
                              ItemsSource="{Binding Microphones}"
                              SelectedItem="{Binding SelectedMicrophone}"
                              HorizontalAlignment="Right" MinWidth="260">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </DockPanel>

                  <Border Height="0.5" Background="#0DFFFFFF" />

                  <!-- Volume -->
                  <DockPanel Margin="16,11">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_MicVolume}"
                               FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Width="42"
                               Text="{Binding MicVolume, StringFormat='{}{0}%'}"
                               FontSize="12" Foreground="{StaticResource AccentCyanBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Slider Minimum="0" Maximum="100"
                            Value="{Binding MicVolume, Mode=TwoWay}"
                            Margin="16,0,10,0" VerticalAlignment="Center"
                            Foreground="{StaticResource AccentCyanBrush}" />
                  </DockPanel>

                  <Border Height="0.5" Background="#0DFFFFFF" />

                  <!-- Channels: stereo / mono -->
                  <DockPanel Margin="16,11">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_MicChannels}"
                               FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                    <ComboBox DockPanel.Dock="Right"
                              SelectedIndex="{Binding MicChannelIndex}"
                              HorizontalAlignment="Right" MinWidth="110">
                      <ComboBoxItem Content="{DynamicResource Channels_Stereo}" />
                      <ComboBoxItem Content="{DynamicResource Channels_Mono}" />
                    </ComboBox>
                  </DockPanel>

                  <Border Height="0.5" Background="#0DFFFFFF" />

                  <!-- Push-to-talk toggle -->
                  <DockPanel Margin="16,11">
                    <ToggleSwitch DockPanel.Dock="Right"
                                  IsChecked="{Binding PushToTalkEnabled}"
                                  HorizontalAlignment="Right" />
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource Settings_Ptt}"
                                 FontSize="13" Foreground="#B3FFFFFF" />
                      <TextBlock Text="{DynamicResource Settings_Ptt_Desc}"
                                 FontSize="11" Foreground="#4DFFFFFF" TextWrapping="Wrap" />
                    </StackPanel>
                  </DockPanel>

                  <!-- Push-to-talk key (active only when PTT is on) -->
                  <DockPanel Margin="16,0,16,11" IsEnabled="{Binding PushToTalkEnabled}">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_PttKey}"
                               FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Border Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="0.5"
                              CornerRadius="6" Padding="10,5">
                        <TextBlock Text="{Binding PttKeyDisplayText}"
                                   FontFamily="Consolas, monospace"
                                   FontSize="12" FontWeight="Medium" Foreground="#99FFFFFF" />
                      </Border>
                      <Button Classes="accent" Command="{Binding CapturePttKeyCommand}">
                        <Panel>
                          <TextBlock Text="{DynamicResource Settings_Hotkey_Change}"
                                     IsVisible="{Binding !IsCapturingPttKey}" />
                          <TextBlock Text="{DynamicResource Settings_Hotkey_Listening}"
                                     IsVisible="{Binding IsCapturingPttKey}" />
                        </Panel>
                      </Button>
                    </StackPanel>
                  </DockPanel>

                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ── System sound (all PC / specific apps, Medal-style) ── -->
            <StackPanel Spacing="8">
              <TextBlock Classes="group-label" Text="{DynamicResource Settings_Group_SystemAudio}" />

              <Border Classes="card">
                <StackPanel>

                  <!-- Mode -->
                  <DockPanel Margin="16,11">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_AudioMode}"
                               FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                    <ComboBox DockPanel.Dock="Right"
                              SelectedIndex="{Binding AudioModeIndex}"
                              HorizontalAlignment="Right" MinWidth="170">
                      <ComboBoxItem Content="{DynamicResource AudioMode_All}" />
                      <ComboBoxItem Content="{DynamicResource AudioMode_Apps}" />
                    </ComboBox>
                  </DockPanel>

                  <!-- App list (Medal-style: checkbox + per-app volume) -->
                  <StackPanel IsVisible="{Binding IsAppsMode}">
                    <Border Height="0.5" Background="#0DFFFFFF" />

                    <ItemsControl ItemsSource="{Binding AudioApps}" Margin="8,6">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppAudioItem">
                          <Border CornerRadius="10" Padding="10,7" Margin="0,2"
                                  Background="#0AFFFFFF">
                            <DockPanel>
                              <CheckBox DockPanel.Dock="Left"
                                        IsChecked="{Binding IsEnabled}"
                                        VerticalAlignment="Center" />
                              <TextBlock DockPanel.Dock="Right" Width="42"
                                         Text="{Binding Volume, StringFormat='{}{0}%'}"
                                         FontSize="11" Foreground="{StaticResource AccentCyanBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                              <Slider DockPanel.Dock="Right" Width="140"
                                      Minimum="0" Maximum="100"
                                      Value="{Binding Volume, Mode=TwoWay}"
                                      IsEnabled="{Binding IsEnabled}"
                                      Margin="10,0" VerticalAlignment="Center"
                                      Foreground="{StaticResource AccentCyanBrush}" />
                              <TextBlock Text="{Binding DisplayName}"
                                         FontSize="13" Foreground="#CCFFFFFF"
                                         Margin="8,0,0,0" VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{DynamicResource Settings_AppsHint}"
                               FontSize="11" Foreground="#4DFFFFFF"
                               TextWrapping="Wrap" Margin="16,2,16,11" />
                  </StackPanel>

                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ── Separate audio tracks ── -->
            <Border Classes="card">
              <DockPanel Margin="16,11">
                <ToggleSwitch DockPanel.Dock="Right"
                              IsChecked="{Binding SeparateAudioTracks}"
                              HorizontalAlignment="Right" />
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Settings_SeparateTracks}"
                             FontSize="13" Foreground="#B3FFFFFF" />
                  <TextBlock Text="{DynamicResource Settings_SeparateTracks_Desc}"
                             FontSize="11" Foreground="#4DFFFFFF" TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ════════════════ TAB: GENERAL ════════════════ -->
      <TabItem Header="{DynamicResource Tab_General}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,14,0,28" Spacing="22" MaxWidth="820" HorizontalAlignment="Center">

            <!-- Language -->
            <StackPanel Spacing="8">
              <TextBlock Classes="group-label" Text="{DynamicResource Settings_Group_Language}" />

              <Border Classes="card">
                <DockPanel Margin="16,11">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_Language}"
                             FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                  <ComboBox DockPanel.Dock="Right"
                            ItemsSource="{Binding LanguageOptions}"
                            SelectedItem="{Binding SelectedLanguage}"
                            HorizontalAlignment="Right" MinWidth="190">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:LanguageOption">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                          <!-- Vector flag (DrawingImage resource picked by language code) -->
                          <Border CornerRadius="3" ClipToBounds="True"
                                  BorderBrush="#33FFFFFF" BorderThickness="0.5"
                                  VerticalAlignment="Center">
                            <Image Source="{Binding Code, Converter={StaticResource LangFlag}}"
                                   Width="23" Height="15" Stretch="Fill" />
                          </Border>
                          <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </DockPanel>
              </Border>
            </StackPanel>

            <!-- Hotkey -->
            <StackPanel Spacing="8">
              <TextBlock Classes="group-label" Text="{DynamicResource Settings_Group_Hotkey}" />

              <Border Classes="card">
                <DockPanel Margin="16,12">
                  <StackPanel DockPanel.Dock="Left" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Settings_Hotkey_SaveReplay}"
                               FontSize="13" FontWeight="Medium" Foreground="#BFFFFFFF" />
                    <TextBlock Text="{DynamicResource Settings_Hotkey_Desc}"
                               FontSize="11" Foreground="#4DFFFFFF" TextWrapping="Wrap" />
                  </StackPanel>

                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                              HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="0.5"
                            CornerRadius="6" Padding="10,5">
                      <TextBlock Text="{Binding HotkeyDisplayText}"
                                 FontFamily="Consolas, monospace"
                                 FontSize="12" FontWeight="Medium" Foreground="#99FFFFFF" />
                    </Border>
                    <Button Classes="accent" Command="{Binding CaptureHotkeyCommand}">
                      <Panel>
                        <TextBlock Text="{DynamicResource Settings_Hotkey_Change}"
                                   IsVisible="{Binding !IsCapturingHotkey}" />
                        <TextBlock Text="{DynamicResource Settings_Hotkey_Listening}"
                                   IsVisible="{Binding IsCapturingHotkey}" />
                      </Panel>
                    </Button>
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>

            <!-- Automation -->
            <StackPanel Spacing="8">
              <TextBlock Classes="group-label" Text="{DynamicResource Settings_Group_Automation}" />

              <Border Classes="card">
                <StackPanel>

                  <!-- Start with Windows -->
                  <DockPanel Margin="16,11">
                    <ToggleSwitch DockPanel.Dock="Right"
                                  IsChecked="{Binding StartWithWindows}"
                                  HorizontalAlignment="Right" />
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource Settings_StartWithWindows}"
                                 FontSize="13" Foreground="#B3FFFFFF" />
                      <TextBlock Text="{DynamicResource Settings_StartWithWindows_Desc}"
                                 FontSize="11" Foreground="#4DFFFFFF" TextWrapping="Wrap" />
                    </StackPanel>
                  </DockPanel>

                  <Border Height="0.5" Background="#0DFFFFFF" />

                  <!-- Auto-Start Recording -->
                  <DockPanel Margin="16,11">
                    <ToggleSwitch DockPanel.Dock="Right"
                                  IsChecked="{Binding AutoStartRecording}"
                                  HorizontalAlignment="Right" />
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource Settings_AutoStart}"
                                 FontSize="13" Foreground="#B3FFFFFF" />
                      <TextBlock Text="{DynamicResource Settings_AutoStart_Desc}"
                                 FontSize="11" Foreground="#4DFFFFFF" TextWrapping="Wrap" />
                    </StackPanel>
                  </DockPanel>

                  <Border Height="0.5" Background="#0DFFFFFF" />

                  <!-- Library Auto-Cleanup (opt-in) -->
                  <DockPanel Margin="16,11">
                    <ToggleSwitch DockPanel.Dock="Right"
                                  IsChecked="{Binding AutoCleanupEnabled}"
                                  HorizontalAlignment="Right" />
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource Settings_AutoCleanup}"
                                 FontSize="13" Foreground="#B3FFFFFF" />
                      <TextBlock Text="{DynamicResource Settings_AutoCleanup_Desc}"
                                 FontSize="11" Foreground="#4DFFFFFF" TextWrapping="Wrap" />
                    </StackPanel>
                  </DockPanel>

                  <!-- Storage limit (active only while auto-cleanup is enabled) -->
                  <DockPanel Margin="16,0,16,11"
                             IsEnabled="{Binding AutoCleanupEnabled}">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_StorageLimit}"
                               FontSize="13" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                    <ComboBox DockPanel.Dock="Right"
                              ItemsSource="{Binding StorageLimitOptions}"
                              SelectedItem="{Binding SelectedStorageLimit}"
                              HorizontalAlignment="Right" MinWidth="110" />
                  </DockPanel>

                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Paths -->
            <StackPanel Spacing="8">
              <TextBlock Classes="group-label" Text="{DynamicResource Settings_Group_Paths}" />

              <Border Classes="card">
                <StackPanel Margin="16,12" Spacing="8">
                  <TextBlock Text="{DynamicResource Settings_LibraryFolder}"
                             FontSize="13" Foreground="#B3FFFFFF" />
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="btn-save"
                            Command="{Binding BrowseFolderCommand}"
                            Height="34" Width="92" Margin="8,0,0,0"
                            HorizontalContentAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15"
                                                    VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Settings_Browse}" FontSize="12" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <TextBox Text="{Binding LibraryPath}" IsReadOnly="False" />
                  </DockPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- About / Updates -->
            <StackPanel Spacing="8">
              <TextBlock Classes="group-label" Text="{DynamicResource About_Group}" />

              <Border Classes="card">
                <StackPanel Margin="16,12" Spacing="10">

                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="accent"
                            Command="{Binding CheckForUpdatesCommand}"
                            IsEnabled="{Binding !IsCheckingForUpdate}"
                            VerticalAlignment="Center" Margin="8,0,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Update" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource About_CheckUpdates}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="Lag" FontSize="14" FontWeight="SemiBold" Foreground="#BFFFFFFF" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{DynamicResource About_Version}" FontSize="12" Foreground="#66FFFFFF" />
                        <TextBlock Text="{Binding AppVersion}" FontSize="12"
                                   Foreground="{StaticResource AccentCyanBrush}" />
                      </StackPanel>
                    </StackPanel>
                  </DockPanel>

                  <ProgressBar IsIndeterminate="True" Height="2"
                               IsVisible="{Binding IsCheckingForUpdate}"
                               Foreground="{StaticResource AccentCyanBrush}" />

                  <TextBlock Text="{Binding UpdateStatus}" FontSize="11"
                             Foreground="#8FFFFFFF" TextWrapping="Wrap"
                             IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                </StackPanel>
              </Border>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

  </Grid>

</UserControl>
