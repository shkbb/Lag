<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lag.ViewModels"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="Lag.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,20,28,28" Spacing="22"
                MaxWidth="820" HorizontalAlignment="Center">

      <!-- Page Title -->
      <TextBlock Classes="page-title" Text="{DynamicResource Settings_Title}" />

      <!-- Pending Changes Warning -->
      <TextBlock Text="{DynamicResource Settings_PendingChanges}"
                 Foreground="#FFA000" FontSize="13" FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasPendingChanges}" />

      <!-- ═══════════ Language Section (FIRST) ═══════════ -->
      <StackPanel Spacing="8">
        <TextBlock Classes="group-label" Text="{DynamicResource Settings_Group_Language}" />

        <Border Classes="card">
          <DockPanel Margin="16,11">
            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_Language}"
                       FontSize="13" Foreground="#B3FFFFFF"
                       VerticalAlignment="Center" />
            <ComboBox DockPanel.Dock="Right"
                      ItemsSource="{Binding LanguageOptions}"
                      SelectedItem="{Binding SelectedLanguage}"
                      HorizontalAlignment="Right"
                      MinWidth="170" />
          </DockPanel>
        </Border>
      </StackPanel>

      <!-- ═══════════ Recording Section ═══════════ -->
      <StackPanel Spacing="8">
        <TextBlock Classes="group-label" Text="{DynamicResource Settings_Group_Recording}" />

        <Border Classes="card">
          <StackPanel>

            <!-- Buffer Duration -->
            <DockPanel Margin="16,11">
              <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_BufferLength}"
                         FontSize="13" Foreground="#B3FFFFFF"
                         VerticalAlignment="Center" />
              <ComboBox DockPanel.Dock="Right"
                        ItemsSource="{Binding BufferOptions}"
                        SelectedItem="{Binding SelectedBuffer}"
                        HorizontalAlignment="Right"
                        MinWidth="130" />
            </DockPanel>

            <Border Height="0.5" Background="#0DFFFFFF" />

            <!-- Monitor -->
            <DockPanel Margin="16,11">
              <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_Display}"
                         FontSize="13" Foreground="#B3FFFFFF"
                         VerticalAlignment="Center" />
              <ComboBox DockPanel.Dock="Right"
                        ItemsSource="{Binding Monitors}"
                        SelectedItem="{Binding SelectedMonitor}"
                        HorizontalAlignment="Right"
                        MinWidth="260" />
            </DockPanel>

            <Border Height="0.5" Background="#0DFFFFFF" />

            <!-- Microphone -->
            <DockPanel Margin="16,11">
              <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_Microphone}"
                         FontSize="13" Foreground="#B3FFFFFF"
                         VerticalAlignment="Center" />
              <ComboBox DockPanel.Dock="Right"
                        ItemsSource="{Binding Microphones}"
                        SelectedItem="{Binding SelectedMicrophone}"
                        HorizontalAlignment="Right"
                        MinWidth="260">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </DockPanel>

            <Border Height="0.5" Background="#0DFFFFFF" />

            <!-- Frame Rate -->
            <DockPanel Margin="16,11">
              <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Settings_FrameRate}"
                         FontSize="13" Foreground="#B3FFFFFF"
                         VerticalAlignment="Center" />
              <ComboBox DockPanel.Dock="Right"
                        ItemsSource="{Binding FrameRateOptions}"
                        SelectedItem="{Binding SelectedFrameRate}"
                        HorizontalAlignment="Right"
                        MinWidth="80" />
            </DockPanel>

          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ═══════════ Automation Section ═══════════ -->
      <StackPanel Spacing="8">
        <TextBlock Classes="group-label" Text="{DynamicResource Settings_Group_Automation}" />

        <Border Classes="card">
          <StackPanel>

            <!-- Start with Windows -->
            <DockPanel Margin="16,11">
              <ToggleSwitch DockPanel.Dock="Right"
                            IsChecked="{Binding StartWithWindows}"
                            HorizontalAlignment="Right" />
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Settings_StartWithWindows}"
                           FontSize="13" Foreground="#B3FFFFFF" />
                <TextBlock Text="{DynamicResource Settings_StartWithWindows_Desc}"
                           FontSize="11" Foreground="#4DFFFFFF"
                           TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>

            <Border Height="0.5" Background="#0DFFFFFF" />

            <!-- Auto-Start Recording -->
            <DockPanel Margin="16,11">
              <ToggleSwitch DockPanel.Dock="Right"
                            IsChecked="{Binding AutoStartRecording}"
                            HorizontalAlignment="Right" />
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Settings_AutoStart}"
                           FontSize="13" Foreground="#B3FFFFFF" />
                <TextBlock Text="{DynamicResource Settings_AutoStart_Desc}"
                           FontSize="11" Foreground="#4DFFFFFF"
                           TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>

          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ═══════════ Hotkey Section ═══════════ -->
      <StackPanel Spacing="8">
        <TextBlock Classes="group-label" Text="{DynamicResource Settings_Group_Hotkey}" />

        <Border Classes="card">
          <DockPanel Margin="16,12">
            <StackPanel DockPanel.Dock="Left" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Settings_Hotkey_SaveReplay}"
                         FontSize="13" FontWeight="Medium"
                         Foreground="#BFFFFFFF" />
              <TextBlock Text="{DynamicResource Settings_Hotkey_Desc}"
                         FontSize="11" Foreground="#4DFFFFFF"
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">

              <!-- Hotkey badge -->
              <Border Background="#14FFFFFF"
                      BorderBrush="#24FFFFFF"
                      BorderThickness="0.5"
                      CornerRadius="6" Padding="10,5">
                <TextBlock Text="{Binding HotkeyDisplayText}"
                           FontFamily="Consolas, monospace"
                           FontSize="12" FontWeight="Medium"
                           Foreground="#99FFFFFF" />
              </Border>

              <!-- Change button (localized states) -->
              <Button Classes="accent" Command="{Binding CaptureHotkeyCommand}">
                <Panel>
                  <TextBlock Text="{DynamicResource Settings_Hotkey_Change}"
                             IsVisible="{Binding !IsCapturingHotkey}" />
                  <TextBlock Text="{DynamicResource Settings_Hotkey_Listening}"
                             IsVisible="{Binding IsCapturingHotkey}" />
                </Panel>
              </Button>
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>

      <!-- ═══════════ Paths Section ═══════════ -->
      <StackPanel Spacing="8">
        <TextBlock Classes="group-label" Text="{DynamicResource Settings_Group_Paths}" />

        <Border Classes="card">
          <StackPanel Margin="16,12" Spacing="8">
            <TextBlock Text="{DynamicResource Settings_LibraryFolder}"
                       FontSize="13" Foreground="#B3FFFFFF" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="btn-save"
                      Command="{Binding BrowseFolderCommand}"
                      Height="34" Width="92" Margin="8,0,0,0"
                      HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15"
                                              VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Settings_Browse}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBox Text="{Binding LibraryPath}"
                       IsReadOnly="False" />
            </DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ═══════════ About / Updates Section ═══════════ -->
      <StackPanel Spacing="8">
        <TextBlock Classes="group-label" Text="{DynamicResource About_Group}" />

        <Border Classes="card">
          <StackPanel Margin="16,12" Spacing="10">

            <DockPanel>
              <!-- Check for updates button -->
              <Button DockPanel.Dock="Right" Classes="accent"
                      Command="{Binding CheckForUpdatesCommand}"
                      IsEnabled="{Binding !IsCheckingForUpdate}"
                      VerticalAlignment="Center" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <materialIcons:MaterialIcon Kind="Update" Width="15" Height="15" VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource About_CheckUpdates}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <!-- App + version -->
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Lag" FontSize="14" FontWeight="SemiBold" Foreground="#BFFFFFFF" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{DynamicResource About_Version}" FontSize="12" Foreground="#66FFFFFF" />
                  <TextBlock Text="{Binding AppVersion}" FontSize="12"
                             Foreground="{StaticResource AccentCyanBrush}" />
                </StackPanel>
              </StackPanel>
            </DockPanel>

            <!-- Loading indicator while checking -->
            <ProgressBar IsIndeterminate="True" Height="2"
                         IsVisible="{Binding IsCheckingForUpdate}"
                         Foreground="{StaticResource AccentCyanBrush}" />

            <!-- Last update status -->
            <TextBlock Text="{Binding UpdateStatus}" FontSize="11"
                       Foreground="#8FFFFFFF" TextWrapping="Wrap"
                       IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          </StackPanel>
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>

</UserControl>
