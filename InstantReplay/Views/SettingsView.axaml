<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lag.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:controls="using:Lag.Controls"
             x:Class="Lag.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <!-- One card row: label/control split, comfortable padding -->
    <Style Selector="Grid.row">
      <Setter Property="Margin" Value="18,15" />
    </Style>

    <!-- Interactive overlay preview: a draggable element box + its resize grip -->
    <Style Selector="Border.ovbox">
      <Setter Property="Background" Value="{DynamicResource AccentDim}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="SizeAll" />
    </Style>

    <!-- ═══ Hardware preset cards ═══ -->
    <Style Selector="Border.presetcard">
      <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="15,13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.presetcard:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    </Style>
    <Style Selector="Border.presetcard.active">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <!-- "Recommended" badge -->
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Disk-low recommendation -->
    <Style Selector="Border.hint">
      <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="14,11" />
    </Style>

    <!-- Live audio level meter (mic / output) -->
    <Style Selector="Border.meter">
      <Setter Property="Width" Value="240" />
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.meterfill">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="#FF43B581" />
    </Style>
    <!-- Mic level below the gate threshold (not transmitting) → muted grey instead of green -->
    <Style Selector="Border.meterfill.gated">
      <Setter Property="Background" Value="#FF5A6472" />
    </Style>
    <!-- Gate threshold marker line on the mic meter -->
    <Style Selector="Border.metermarker">
      <Setter Property="Width" Value="2" />
      <Setter Property="Background" Value="{DynamicResource TextHi}" />
    </Style>

    <!-- Input-sensitivity bar (Discord-style level meter / threshold picker) -->
    <Style Selector="Border.gatebar">
      <Setter Property="Width" Value="480" />
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.gatehandle">
      <Setter Property="Width" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="White" />
    </Style>

    <!-- "Hear yourself" chip button, accent-filled while active (monitoring on) -->
    <Style Selector="Button.rchip.active">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.rchip.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.rchip.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>

    <!-- Mic boosted past 100%: amber percentage as a gentle "louder than unity" caution -->
    <Style Selector="TextBlock.boosted">
      <Setter Property="Foreground" Value="#E5B84C" />
    </Style>

    <!-- Preview elements pop in when the overlay tab builds -->
    <Style Selector="Border.ovbox">
      <Style.Animations>
        <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="None">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Grid Background="{DynamicResource SurfaceApp}">
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto">
      <!-- Fixed-width centered column (min window is 900, so 800 always fits). A MaxWidth + Center
           StackPanel shrinks to content, so tabs of different content width made the whole column
           (heading + tabs + cards) jump horizontally when switching. Fixed width = stable. -->
      <StackPanel Width="800" HorizontalAlignment="Center" Margin="0,34,0,64">

        <!-- Heading -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="{DynamicResource Settings_Title}" FontFamily="{StaticResource FontDisplay}"
                       FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextHi}" />
            <TextBlock Text="{DynamicResource Settings_Subtitle}" FontSize="13.5"
                       Foreground="{DynamicResource TextMuted}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{DynamicResource Settings_PendingChanges}"
                     FontSize="11" Foreground="#F0B45A" VerticalAlignment="Bottom"
                     TextWrapping="Wrap" MaxWidth="280" TextAlignment="Right"
                     IsVisible="{Binding HasPendingChanges}" />
        </Grid>

        <!-- Tab pills -->
        <controls:SegmentedListBox Classes="segctl" HorizontalAlignment="Left" Margin="0,26,0,0" SelectionChanged="OnTabsChanged"
                                   SelectedIndex="{Binding SelectedSettingsTab, Mode=TwoWay}">
          <ListBoxItem Content="{DynamicResource Tab_Video}" />
          <ListBoxItem Content="{DynamicResource Tab_Audio}" />
          <ListBoxItem Content="{DynamicResource Settings_Group_Overlay}" />
          <ListBoxItem Content="{DynamicResource Tab_General}" />
        </controls:SegmentedListBox>
        <Border IsVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <Button Classes="rseg" Classes.sel="{Binding SelectedSettingsTab, Converter={StaticResource Eq}, ConverterParameter=0}"
                    Click="OnTabClick" Tag="0" Content="{DynamicResource Tab_Video}" />
            <Button Classes="rseg" Classes.sel="{Binding SelectedSettingsTab, Converter={StaticResource Eq}, ConverterParameter=1}"
                    Click="OnTabClick" Tag="1" Content="{DynamicResource Tab_Audio}" />
            <Button Classes="rseg" Classes.sel="{Binding SelectedSettingsTab, Converter={StaticResource Eq}, ConverterParameter=2}"
                    Click="OnTabClick" Tag="2" Content="{DynamicResource Tab_General}" />
          </StackPanel>
        </Border>

        <!-- ════════════════ VIDEO ════════════════ -->
        <StackPanel Spacing="26" Margin="0,28,0,0"
                    IsVisible="{Binding SelectedSettingsTab, Converter={StaticResource Eq}, ConverterParameter=0}" x:Name="TabPanel0">

          <!-- ═══ Hardware-tailored presets ═══ -->
          <StackPanel Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Classes="rgroup" Margin="0" Text="{DynamicResource Preset_SectionTitle}" />
              <TextBlock Classes="rsub" Margin="0" Text="{DynamicResource Preset_Subtitle}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Presets}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PresetCard">
                  <Border Classes="presetcard" Classes.active="{Binding IsActive}" Margin="4" Tapped="OnPresetClick">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="15.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextHi}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Classes="badge" IsVisible="{Binding IsRecommended}">
                          <TextBlock Text="{DynamicResource Preset_RecommendedBadge}" FontSize="10"
                                     FontWeight="SemiBold" Foreground="White" />
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                      <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource Accent}"
                                 TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="hint" IsVisible="{Binding ShowCleanupHint}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <TextBlock Text="💡" FontSize="14" VerticalAlignment="Top" />
                <TextBlock Text="{Binding CleanupHintText}" FontSize="12.5"
                           Foreground="{DynamicResource TextHi}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ═══ Advanced: the manual controls, shown plainly under the presets ═══ -->
          <TextBlock Classes="rgroup" Text="{DynamicResource Preset_Advanced}" />
          <StackPanel Spacing="26">

          <StackPanel>
            <TextBlock Classes="rgroup" Text="{DynamicResource Settings_Group_Recording}" />
            <Border Classes="rcard">
              <StackPanel>
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_BufferLength}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" VerticalAlignment="Center"
                            ItemsSource="{Binding BufferOptions}" SelectedItem="{Binding SelectedBuffer}" />
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_Display}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" VerticalAlignment="Center"
                            ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" />
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_FrameRate}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBox Text="{Binding CustomFps}" Width="56" IsVisible="{Binding IsCustomFps}" />
                    <controls:SegmentedListBox Classes="segctl" ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding SelectedFps}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FpsOption">
                          <TextBlock Text="{Binding Display}" Foreground="{Binding Tier, Converter={StaticResource Intensity}}" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </controls:SegmentedListBox>
                  </StackPanel>
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_OutputResolution}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" VerticalAlignment="Center"
                            ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding SelectedResolution}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ResolutionOption">
                        <TextBlock Text="{Binding Display}" Foreground="{Binding Tier, Converter={StaticResource Intensity}}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel>
            <TextBlock Classes="rgroup" Text="{DynamicResource Settings_Group_Encoding}" />
            <Border Classes="rcard">
              <StackPanel>
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_Codec}" VerticalAlignment="Center" />
                  <controls:SegmentedListBox Grid.Column="1" Classes="segctl" VerticalAlignment="Center"
                                             ItemsSource="{Binding CodecOptions}" SelectedItem="{Binding SelectedCodec}" />
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_Bitrate}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ComboBox MinWidth="120" VerticalAlignment="Center"
                              ItemsSource="{Binding BitrateOptions}" SelectedItem="{Binding SelectedBitrate}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:BitrateOption">
                          <TextBlock Text="{Binding Display}" Foreground="{Binding Tier, Converter={StaticResource Intensity}}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Slider Width="120" Minimum="3" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Value="{Binding BitrateSliderValue}" IsVisible="{Binding IsCustomBitrate}" />
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsCustomBitrate}">
                      <TextBlock Text="{Binding BitrateDisplayMbps}" FontSize="13" Foreground="{DynamicResource TextHi}" />
                      <TextBlock Text="{DynamicResource Settings_Bitrate_CustomSuffix}" FontSize="13" Foreground="{DynamicResource TextHi}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_Gpu}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" VerticalAlignment="Center"
                            ItemsSource="{Binding GpuOptions}" SelectedItem="{Binding SelectedGpu}" />
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_Format}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" VerticalAlignment="Center"
                            ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedFormat}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Converter={StaticResource Upper}}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

            </StackPanel>
        </StackPanel>

        <!-- ════════════════ OVERLAY ════════════════ -->
        <StackPanel Spacing="26" Margin="0,28,0,0"
                    IsVisible="{Binding SelectedSettingsTab, Converter={StaticResource Eq}, ConverterParameter=2}" x:Name="TabPanel2">
          <!-- ── Overlay: Medal-style corner slots — pick WHAT goes into WHICH corner ── -->
          <StackPanel>
            <TextBlock Classes="rgroup" Text="{DynamicResource Settings_Group_Overlay}" />
            <Border Classes="rcard">
              <StackPanel>
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Classes="rrow" Text="{DynamicResource Overlay_Enable}" />
                    <TextBlock Classes="rsub" Text="{DynamicResource Overlay_Enable_Desc}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding OverlayEnabled}"
                                OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
                </Grid>

                <!-- Interactive preview: drag an element around the frame, resize by its corner grip -->
                <Border Margin="18,4,18,15" Background="{DynamicResource SurfaceInput}" CornerRadius="10"
                        Padding="10" IsVisible="{Binding OverlayEnabled}">
                  <StackPanel>
                  <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource VideoBrush}">
                    <Canvas x:Name="OverlayStage" Width="736" Height="414">

                      <Border x:Name="OvKeysBox" Classes="ovbox" IsVisible="{Binding KeysShown}"
                              PointerPressed="OnOvBoxPressed" PointerMoved="OnOvBoxMoved" PointerReleased="OnOvBoxReleased" PointerWheelChanged="OnOvBoxWheel">
                        <Panel>
                          <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <mi:MaterialIcon Kind="KeyboardOutline" Width="22" Height="22" Foreground="{DynamicResource TextMid}" />
                            <mi:MaterialIcon Kind="MouseOutline" Width="18" Height="18" Foreground="{DynamicResource TextMid}" />
                          </StackPanel>
                        </Panel>
                      </Border>

                      <Border x:Name="OvWebcamBox" Classes="ovbox" IsVisible="{Binding WebcamShown}"
                              PointerPressed="OnOvBoxPressed" PointerMoved="OnOvBoxMoved" PointerReleased="OnOvBoxReleased" PointerWheelChanged="OnOvBoxWheel">
                        <Panel>
                          <mi:MaterialIcon Kind="Webcam" Width="24" Height="24" Foreground="{DynamicResource TextMid}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                      </Border>

                      <Border x:Name="OvStatsBox" Classes="ovbox" IsVisible="{Binding StatsShown}"
                              PointerPressed="OnOvBoxPressed" PointerMoved="OnOvBoxMoved" PointerReleased="OnOvBoxReleased" PointerWheelChanged="OnOvBoxWheel">
                        <Panel>
                          <mi:MaterialIcon Kind="Speedometer" Width="16" Height="16" Foreground="{DynamicResource TextMid}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                      </Border>
                    </Canvas>
                  </Border>
                  <TextBlock Text="{DynamicResource Overlay_WheelHint}" FontSize="11" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" Margin="0,8,0,2" />
                  </StackPanel>
                </Border>

                <Border Classes="rdivider" IsVisible="{Binding OverlayEnabled}" />
                <Grid Classes="row" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding OverlayEnabled}">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Overlay_Camera}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="180" Margin="0,0,14,0"
                            ItemsSource="{Binding Webcams}" SelectedItem="{Binding SelectedWebcam}"
                            IsEnabled="{Binding WebcamShown}" />
                  <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" IsChecked="{Binding WebcamShown}"
                                OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
                </Grid>
                <Border Classes="rdivider" IsVisible="{Binding OverlayEnabled}" />
                <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding OverlayEnabled}">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Overlay_Keys}" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding KeysShown}"
                                OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
                </Grid>
                <Border Classes="rdivider" IsVisible="{Binding OverlayEnabled}" />
                <Grid Classes="row" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding OverlayEnabled}">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Overlay_Stats}" VerticalAlignment="Center" />
                  <!-- Detail levels use universal acronyms — no localization needed -->
                  <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="180" Margin="0,0,14,0"
                            SelectedIndex="{Binding StatsDetail, Mode=TwoWay}" IsEnabled="{Binding StatsShown}">
                    <ComboBoxItem Content="FPS" />
                    <ComboBoxItem Content="FPS + CPU/GPU" />
                    <ComboBoxItem Content="FPS + CPU/GPU + RAM" />
                  </ComboBox>
                  <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" IsChecked="{Binding StatsShown}"
                                OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- ════════════════ AUDIO ════════════════ -->
        <StackPanel Spacing="26" Margin="0,28,0,0"
                    IsVisible="{Binding SelectedSettingsTab, Converter={StaticResource Eq}, ConverterParameter=1}" x:Name="TabPanel1">

          <StackPanel>
            <TextBlock Classes="rgroup" Text="{DynamicResource Settings_Group_SystemAudio}" />
            <Border Classes="rcard">
              <StackPanel>
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_AudioMode}" VerticalAlignment="Center" />
                  <controls:SegmentedListBox Grid.Column="1" Classes="segctl" VerticalAlignment="Center"
                                             SelectedIndex="{Binding AudioModeIndex, Mode=TwoWay}">
                    <ListBoxItem Content="{DynamicResource AudioMode_All}" />
                    <ListBoxItem Content="{DynamicResource AudioMode_Apps}" />
                  </controls:SegmentedListBox>
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Classes="rrow" Text="{DynamicResource Settings_AudioModeByTarget}" />
                    <TextBlock Classes="rsub" Text="{DynamicResource Settings_AudioModeByTarget_Desc}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AudioModeByTarget}"
                                OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
                </Grid>
                <Border Classes="rdivider" />

                <!-- source list -->
                <Grid ColumnDefinitions="Auto,Auto,*,120,42" Margin="18,11" IsVisible="{Binding ShowSystemAudioRow}">
                  <CheckBox Grid.Column="0" IsChecked="{Binding SystemAudioEnabled}" VerticalAlignment="Center" />
                  <mi:MaterialIcon Grid.Column="1" Kind="VolumeHigh" Width="20" Height="20" Margin="6,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}" />
                  <TextBlock Grid.Column="2" Text="Звук системи" FontSize="14" Foreground="{DynamicResource TextRow}" VerticalAlignment="Center" />
                  <Slider Grid.Column="3" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                          Value="{Binding SystemAudioVolume}" IsEnabled="{Binding SystemAudioEnabled}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding SystemAudioVolume, StringFormat='{}{0}%'}" FontFamily="{StaticResource FontMono}"
                             FontSize="11" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,Auto,*,120,42" Margin="18,11">
                  <CheckBox Grid.Column="0" IsChecked="{Binding MicEnabled}" VerticalAlignment="Center" />
                  <mi:MaterialIcon Grid.Column="1" Kind="Microphone" Width="20" Height="20" Margin="6,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}" />
                  <TextBlock Grid.Column="2" Text="{DynamicResource Settings_Microphone}" FontSize="14" Foreground="{DynamicResource TextRow}" VerticalAlignment="Center" />
                  <Slider Grid.Column="3" Minimum="0" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                          Value="{Binding MicVolume}" IsEnabled="{Binding MicEnabled}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Classes.boosted="{Binding IsMicBoosted}" Text="{Binding MicVolume, StringFormat='{}{0}%'}" FontFamily="{StaticResource FontMono}"
                             FontSize="11" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,Auto,*,120,42" Margin="18,11" IsVisible="{Binding ShowAppsList}">
                  <CheckBox Grid.Column="0" IsChecked="{Binding GameAudioEnabled}" VerticalAlignment="Center" />
                  <mi:MaterialIcon Grid.Column="1" Kind="Gamepad" Width="20" Height="20" Margin="6,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}" />
                  <TextBlock Grid.Column="2" Text="Звук гри" FontSize="14" Foreground="{DynamicResource TextRow}" VerticalAlignment="Center" />
                  <Slider Grid.Column="3" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                          Value="{Binding GameAudioVolume}" IsEnabled="{Binding GameAudioEnabled}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding GameAudioVolume, StringFormat='{}{0}%'}" FontFamily="{StaticResource FontMono}"
                             FontSize="11" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding AudioApps}" IsVisible="{Binding ShowAppsList}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppAudioItem">
                      <Grid ColumnDefinitions="Auto,Auto,*,120,42" Margin="18,11">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                        <Image Grid.Column="1" Source="{Binding Icon}" Width="20" Height="20" Margin="6,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="14" Foreground="{DynamicResource TextRow}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Slider Grid.Column="3" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Volume}" IsEnabled="{Binding IsEnabled}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding Volume, StringFormat='{}{0}%'}" FontFamily="{StaticResource FontMono}"
                                   FontSize="11" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{DynamicResource Settings_AppsHint}" FontSize="11.5" Foreground="{DynamicResource TextFaintest}"
                           Margin="18,2,18,12" TextWrapping="Wrap" IsVisible="{Binding ShowAppsList}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel>
            <TextBlock Classes="rgroup" Text="{DynamicResource Settings_Group_Devices}" />
            <Border Classes="rcard">
              <StackPanel>
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_OutputDevice}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" VerticalAlignment="Center" MaxWidth="240"
                            ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_OutputLevel}" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="meter" VerticalAlignment="Center">
                    <Border Classes="meterfill" Width="{Binding OutputLevel, Converter={StaticResource LevelWidth}, ConverterParameter=240}" />
                  </Border>
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_Microphone}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" VerticalAlignment="Center"
                            ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto" Margin="18,15,18,4">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Classes="rrow" Text="{DynamicResource Settings_InputSensitivity}" />
                    <TextBlock Classes="rsub" Margin="0,1,0,0" Text="{DynamicResource Settings_InputSensitivityHint}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Settings_Auto}" FontSize="12.5"
                               Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                    <ToggleSwitch IsChecked="{Binding InputSensitivityAuto}" OnContent="{x:Null}"
                                  OffContent="{x:Null}" MinWidth="0" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
                <Grid Classes="row" ColumnDefinitions="*,Auto" Margin="18,2,18,15">
                  <!-- AUTO: a live level bar that fills green with your voice -->
                  <Border Grid.Column="0" Classes="gatebar" HorizontalAlignment="Left"
                          IsVisible="{Binding InputSensitivityAuto}">
                    <Border Classes="meterfill" CornerRadius="6"
                            Width="{Binding MicLevel, Converter={StaticResource LevelWidth}, ConverterParameter=480}" />
                  </Border>
                  <!-- MANUAL: dim amber (cut) | green (passes) zones, brightened up to the live level,
                       with a draggable threshold handle. Drag anywhere on the bar to set the threshold. -->
                  <Border Grid.Column="0" Classes="gatebar" HorizontalAlignment="Left"
                          IsVisible="{Binding !InputSensitivityAuto}"
                          PointerPressed="OnGatePressed" PointerMoved="OnGateMoved">
                    <Grid>
                      <Border Background="#3343B581" CornerRadius="6" />
                      <Border Background="#33CB8438" HorizontalAlignment="Left" CornerRadius="6,0,0,6"
                              Width="{Binding InputSensitivityThreshold, Converter={StaticResource LevelWidth}, ConverterParameter=4.8}" />
                      <Border HorizontalAlignment="Left" ClipToBounds="True"
                              Width="{Binding MicLevel, Converter={StaticResource LevelWidth}, ConverterParameter=480}">
                        <Grid Width="480" HorizontalAlignment="Left">
                          <Border Background="#FF43B581" CornerRadius="6" />
                          <Border Background="#FFCB8438" HorizontalAlignment="Left" CornerRadius="6,0,0,6"
                                  Width="{Binding InputSensitivityThreshold, Converter={StaticResource LevelWidth}, ConverterParameter=4.8}" />
                        </Grid>
                      </Border>
                      <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                        <Border Background="Transparent"
                                Width="{Binding InputSensitivityThreshold, Converter={StaticResource LevelWidth}, ConverterParameter=4.8}" />
                        <Border Classes="gatehandle" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding ThresholdDb}" Margin="12,0,0,0"
                             FontFamily="{StaticResource FontMono}" FontSize="11"
                             Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"
                             IsVisible="{Binding !InputSensitivityAuto}" />
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Classes="rrow" Text="{DynamicResource Settings_NoiseSuppression}" />
                    <TextBlock Classes="rsub" Margin="0,1,0,0" Text="{DynamicResource Settings_NoiseSuppressionHint}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding NoiseSuppression}" OnContent="{x:Null}"
                                OffContent="{x:Null}" MinWidth="0" VerticalAlignment="Center" /><TextBlock FontSize="10.5" Foreground="{DynamicResource TextFaint}" Text="Powered by RNNoise" HorizontalAlignment="Right" /></StackPanel>
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Classes="rrow" Text="{DynamicResource Settings_HearYourself}" />
                    <TextBlock Classes="rsub" Margin="0,1,0,0" Text="{DynamicResource Settings_HearYourselfHint}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="rchip" Classes.active="{Binding HearYourself}" VerticalAlignment="Center"
                          Command="{Binding ToggleHearYourselfCommand}" Content="{Binding HearYourselfButtonText}" />
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_MicChannels}" VerticalAlignment="Center" />
                  <!-- Visual order [Mono, Stereo] is the reverse of the setting (0 = stereo, 1 = mono),
                       hence the two-way 1−x converter on SelectedIndex. -->
                  <controls:SegmentedListBox Grid.Column="1" Classes="segctl" VerticalAlignment="Center"
                                             SelectedIndex="{Binding MicChannelIndex, Mode=TwoWay, Converter={StaticResource OneMinus}}">
                    <ListBoxItem Content="{DynamicResource Channels_Mono}" />
                    <ListBoxItem Content="{DynamicResource Channels_Stereo}" />
                  </controls:SegmentedListBox>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel>
            <TextBlock Classes="rgroup" Text="{DynamicResource Settings_Group_Advanced}" />
            <Border Classes="rcard">
              <StackPanel>
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Classes="rrow" Text="{DynamicResource Settings_Ptt}" />
                    <TextBlock Classes="rsub" Text="{DynamicResource Settings_Ptt_Desc}" Margin="0,2,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Classes="bare" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Command="{Binding CapturePttKeyCommand}" IsEnabled="{Binding PushToTalkEnabled}"
                            ToolTip.Tip="{DynamicResource Settings_Hotkey_Desc}">
                      <Panel>
                        <Border Classes="kbd" IsVisible="{Binding !IsCapturingPttKey}"><TextBlock Text="{Binding PttKeyDisplayText}" /></Border>
                        <Border Classes="kbd listening" IsVisible="{Binding IsCapturingPttKey}"><TextBlock Text="..." /></Border>
                      </Panel>
                    </Button>
                    <ToggleSwitch IsChecked="{Binding PushToTalkEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
                  </StackPanel>
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Classes="rrow" Text="{DynamicResource Settings_SeparateTracks}" />
                    <TextBlock Classes="rsub" Text="{DynamicResource Settings_SeparateTracks_Desc}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding SeparateAudioTracks}"
                                OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- ════════════════ GENERAL ════════════════ -->
        <StackPanel Spacing="26" Margin="0,28,0,0"
                    IsVisible="{Binding SelectedSettingsTab, Converter={StaticResource Eq}, ConverterParameter=3}" x:Name="TabPanel3">

          <Border Classes="rcard">
            <StackPanel>
              <!-- Colour theme: warm cream Light / original Dark / follow the OS -->
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Classes="rrow" Text="{DynamicResource Settings_Theme}" />
                  <TextBlock Classes="rsub" Text="{DynamicResource Settings_Theme_Desc}" Margin="0,2,0,0" />
                </StackPanel>
                <controls:SegmentedListBox Grid.Column="1" Classes="segctl" VerticalAlignment="Center"
                                           ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" />
              </Grid>
              <Border Classes="rdivider" />
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_Language}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" VerticalAlignment="Center"
                          ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LanguageOption">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border CornerRadius="3" ClipToBounds="True" VerticalAlignment="Center">
                          <Image Source="{Binding Code, Converter={StaticResource LangFlag}}" Width="17" Height="12" Stretch="Fill" />
                        </Border>
                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel>
            <TextBlock Classes="rgroup" Text="{DynamicResource Settings_Group_Hotkey}" />
            <Border Classes="rcard">
              <StackPanel>
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_Hotkey_SaveReplay}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="bare" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                          VerticalAlignment="Center" Command="{Binding CaptureHotkeyCommand}" ToolTip.Tip="{DynamicResource Settings_Hotkey_Desc}">
                    <Panel>
                      <ItemsControl ItemsSource="{Binding HotkeyParts}" IsVisible="{Binding !IsCapturingHotkey}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Border Classes="kbd"><TextBlock Text="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Classes="kbd listening" IsVisible="{Binding IsCapturingHotkey}"><TextBlock Text="{DynamicResource Settings_Hotkey_Listening}" /></Border>
                    </Panel>
                  </Button>
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_Hotkey_Screenshot}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="bare" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                          VerticalAlignment="Center" Command="{Binding CaptureScreenshotHotkeyCommand}" ToolTip.Tip="{DynamicResource Settings_Hotkey_Desc}">
                    <Panel>
                      <ItemsControl ItemsSource="{Binding ScreenshotHotkeyParts}" IsVisible="{Binding !IsCapturingScreenshotKey}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Border Classes="kbd"><TextBlock Text="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Classes="kbd listening" IsVisible="{Binding IsCapturingScreenshotKey}"><TextBlock Text="{DynamicResource Settings_Hotkey_Listening}" /></Border>
                    </Panel>
                  </Button>
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_Hotkey_Pause}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="bare" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                          VerticalAlignment="Center" Command="{Binding CapturePauseHotkeyCommand}" ToolTip.Tip="{DynamicResource Settings_Hotkey_Desc}">
                    <Panel>
                      <ItemsControl ItemsSource="{Binding PauseHotkeyParts}" IsVisible="{Binding !IsCapturingPauseKey}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Border Classes="kbd"><TextBlock Text="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Classes="kbd listening" IsVisible="{Binding IsCapturingPauseKey}"><TextBlock Text="{DynamicResource Settings_Hotkey_Listening}" /></Border>
                    </Panel>
                  </Button>
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_Hotkey_Record}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="bare" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                          VerticalAlignment="Center" Command="{Binding CaptureRecordHotkeyCommand}" ToolTip.Tip="{DynamicResource Settings_Hotkey_Desc}">
                    <Panel>
                      <ItemsControl ItemsSource="{Binding RecordHotkeyParts}" IsVisible="{Binding !IsCapturingRecordKey}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Border Classes="kbd"><TextBlock Text="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Classes="kbd listening" IsVisible="{Binding IsCapturingRecordKey}"><TextBlock Text="{DynamicResource Settings_Hotkey_Listening}" /></Border>
                    </Panel>
                  </Button>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel>
            <TextBlock Classes="rgroup" Text="{DynamicResource Settings_Group_Startup}" />
            <Border Classes="rcard">
              <StackPanel>
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_StartWithWindows}" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding StartWithWindows}" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Classes="rrow" Text="{DynamicResource Settings_StartMinimized}" />
                    <TextBlock Classes="rsub" Text="{DynamicResource Settings_StartMinimized_Desc}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding StartMinimized}" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_AutoStart}" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AutoStartRecording}" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Classes="rrow" Text="{DynamicResource Settings_DisableGameMode}" />
                    <TextBlock Classes="rsub" Text="{DynamicResource Settings_DisableGameMode_Desc}" Margin="0,2,0,0" MaxWidth="560" HorizontalAlignment="Left" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DisableGameMode}" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel>
            <TextBlock Classes="rgroup" Text="{DynamicResource Settings_Group_Storage}" />
            <Border Classes="rcard">
              <StackPanel>
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Classes="rrow" Text="{DynamicResource Settings_AutoCleanup}" />
                    <TextBlock Classes="rsub" Text="{DynamicResource Settings_AutoCleanup_Desc}" Margin="0,2,0,0" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AutoCleanupEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding AutoCleanupEnabled}">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_StorageLimit}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding StorageLimitOptions}" SelectedItem="{Binding SelectedStorageLimit}" />
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_LibraryFolder}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LibraryPath}" Classes="rmono" FontSize="11.5" MaxWidth="300" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding LibraryPath}" VerticalAlignment="Center" />
                    <Button Classes="rchip" Content="{DynamicResource Settings_Hotkey_Change}" Command="{Binding BrowseFolderCommand}" />
                  </StackPanel>
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Classes="rrow" Text="{DynamicResource About_Group}" />
                    <Panel Margin="0,2,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                        <TextBlock Classes="rsub" Text="{DynamicResource About_Version}" />
                        <TextBlock Classes="rsub" Text="{Binding AppVersion}" />
                      </StackPanel>
                      <TextBlock Classes="rsub" Text="{Binding UpdateStatus}" IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </Panel>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="rchip" VerticalAlignment="Center" Content="{DynamicResource About_CheckUpdates}"
                          Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding !IsCheckingForUpdate}" />
                </Grid>
                <Border Classes="rdivider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="rrow" Text="{DynamicResource Settings_Logs}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="rchip" VerticalAlignment="Center" Margin="0,0,6,0"
                          Content="{DynamicResource Settings_OpenLogs}" Command="{Binding OpenLogsFolderCommand}" />
                  <Button Grid.Column="2" Classes="rchip" VerticalAlignment="Center"
                          Content="{DynamicResource Settings_SaveDiagnostics}" Command="{Binding SaveDiagnosticsZipCommand}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Intensive-quality disclaimer overlay -->
    <Border ZIndex="100" Background="#B0000000" IsVisible="{Binding ShowIntensiveWarning}">
      <Border Width="560" MaxWidth="560" Padding="28" CornerRadius="14"
              Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 12 40 0 #80000000">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding IntensiveWarnTitle}" FontFamily="{StaticResource FontDisplay}" FontSize="18" FontWeight="Bold"
                     Foreground="{DynamicResource TextHi}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding IntensiveWarnSummary}" FontSize="13" FontWeight="Medium" Foreground="#E5B84C" TextWrapping="Wrap" />
          <TextBlock Text="{Binding IntensiveWarnBody}" FontSize="13" Foreground="{DynamicResource TextMid}" TextWrapping="Wrap" LineHeight="20" />
          <Button Content="{Binding IntensiveWarnOk}" Classes="rchip" HorizontalAlignment="Right" Click="OnIntensiveUnderstood" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>

</UserControl>
