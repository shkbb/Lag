<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lag.ViewModels"
             xmlns:models="using:Lag.Models"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Lag.Views.PlayerView"
             x:DataType="vm:PlayerViewModel"
             Focusable="True">

  <!-- Keyboard shortcuts while the player view is focused: Space = play/pause, ←/→ = seek ∓10 s
       (same as the rewind/forward buttons), M = mute/unmute. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Space" Command="{Binding PlayPauseCommand}" />
    <KeyBinding Gesture="Left" Command="{Binding SeekBackwardCommand}" />
    <KeyBinding Gesture="Right" Command="{Binding SeekForwardCommand}" />
    <KeyBinding Gesture="M" Command="{Binding ToggleMuteCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <!-- Player control icon button (stop / rewind / forward / next / edit / fullscreen / speed) -->
    <Style Selector="Button.pbtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pbtn /template/ ContentPresenter">
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions></Setter>
    </Style>
    <Style Selector="Button.pbtn:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextHi}" />
    </Style>
    <Style Selector="Button.pbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BorderFaint}" />
    </Style>

    <!-- Accent play/pause buttons (big centre overlay + the transport one) -->
    <Style Selector="Button.playbtn">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Replays list: row look + selected highlight (the dimmed accent, per the mockup) -->
    <Style Selector="ListBox.replays">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.replays ListBoxItem">
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="ListBox.replays ListBoxItem /template/ ContentPresenter">
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions></Setter>
    </Style>
    <Style Selector="ListBox.replays ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
    </Style>
    <Style Selector="ListBox.replays ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentDim}" />
    </Style>

    <!-- Playback-speed flyout list: on-theme rows, accent-dim selection (not a solid block) -->
    <Style Selector="ListBox.speedlist">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.speedlist ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.speedlist ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions></Setter>
    </Style>
    <Style Selector="ListBox.speedlist ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
    </Style>
    <Style Selector="ListBox.speedlist ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentDim}" />
    </Style>
    <Style Selector="ListBox.speedlist ListBoxItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Floating control bar: slides/fades away in fullscreen until the cursor
         approaches the bottom edge (class "hidden" is toggled in code-behind). -->
    <Style Selector="Border#ControlsBar">
      <Setter Property="RenderTransform" Value="translateY(0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#ControlsBar.hidden">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateY(20px)" />
    </Style>

    <!-- Replays side panel: in fullscreen it overlays the right edge and slides in
         when the cursor approaches it (class "hiddenR" toggled in code-behind). -->
    <Style Selector="Border#ReplayPanel">
      <Setter Property="RenderTransform" Value="translateX(0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#ReplayPanel.hiddenR">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateX(24px)" />
    </Style>

    <!-- Screenshot mode: the bar shrinks to a compact pill holding only the fullscreen button -->
    <Style Selector="Border#ControlsBar.compact">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="PlayerArea" RowDefinitions="*" Margin="24,20,24,24" Background="{DynamicResource SurfaceApp}">

    <!-- ── Player row: video column | replay panel ── -->
    <Grid ColumnDefinitions="*,Auto">

      <!-- Video column: title + meta, then the video frame, then the control strip -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*">

        <!-- Clip title + meta (hidden in fullscreen) -->
        <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,16"
                    x:Name="HeaderBlock"
                    x:CompileBindings="False"
                    IsVisible="{Binding !DataContext.IsFullscreen, RelativeSource={RelativeSource AncestorType=Window}}">
          <TextBlock Text="{Binding CurrentClip.DisplayName, FallbackValue=''}"
                     FontFamily="{StaticResource FontDisplay}" FontSize="22" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextHi}" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{Binding CurrentClip.CreatedDate, StringFormat='{}{0:d MMM, HH:mm}', FallbackValue=''}"
                       FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{DynamicResource TextFaint}" />
            <TextBlock Text="·" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{DynamicResource TextFaint}"
                       IsVisible="{Binding CurrentClip, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding CurrentClip.DurationDisplay, FallbackValue=''}"
                       FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{DynamicResource TextFaint}" />
          </StackPanel>
        </StackPanel>

        <!-- Video frame (#07090C, r16). The control bar OVERLAYS the video bottom; the big
             play sits centred over the picture (shown while paused). -->
        <Border x:Name="VideoFrame" Grid.Row="1"
                Background="#FF07090C" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
                CornerRadius="12" ClipToBounds="True">
          <Panel>

            <!-- Video surface: decoded frames land in an Avalonia bitmap, so this is a plain
                 Image — clipping/overlays work, and click-to-pause is a normal pointer event. -->
            <Panel x:Name="VideoSurface" Background="Transparent"
                   PointerPressed="OnVideoSurfacePressed">
              <Panel.ContextMenu>
                <!-- Right-click the playing video → same actions as the Library, on the current clip. -->
                <ContextMenu IsVisible="{Binding CurrentClip, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <MenuItem Header="{DynamicResource Editor_Edit}" Click="OnReplayEditClick">
                    <MenuItem.Icon><mi:MaterialIcon Kind="MovieEditOutline" Width="16" Height="16" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="{DynamicResource Library_ShowInFolder}" Click="OnReplayShowInFolderClick">
                    <MenuItem.Icon><mi:MaterialIcon Kind="FolderSearchOutline" Width="16" Height="16" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="{DynamicResource Library_Delete}" Click="OnReplayDeleteClick">
                    <MenuItem.Icon><mi:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" /></MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </Panel.ContextMenu>
              <Image x:Name="VideoImage" Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Panel>

            <!-- Placeholder when no clip is loaded -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="10" IsHitTestVisible="False"
                        IsVisible="{Binding CurrentClip, Converter={x:Static ObjectConverters.IsNull}}">
              <Viewbox Width="44" Height="44" HorizontalAlignment="Center">
                <Canvas Width="22" Height="22">
                  <Path Data="{StaticResource LogoArcGeometry}" Stroke="{DynamicResource EmptyIconBrush}"
                        StrokeThickness="0.8" StrokeLineCap="Round" StrokeJoin="Round" />
                  <Path Data="{StaticResource LogoCornerGeometry}" Stroke="{DynamicResource EmptyIconBrush}"
                        StrokeThickness="0.8" StrokeLineCap="Round" StrokeJoin="Round" />
                  <Path Data="{StaticResource LogoHandsGeometry}" Stroke="{DynamicResource EmptyIconBrush}"
                        StrokeThickness="0.8" StrokeLineCap="Round" StrokeJoin="Round" />
                </Canvas>
              </Viewbox>
              <TextBlock Text="{DynamicResource Player_Placeholder}"
                         FontSize="13" Foreground="{DynamicResource TextFaint}"
                         HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Mute flash: a speaker badge that POPS up briefly on each mute/unmute toggle, then fades
                 out (not persistent). Opacity is driven from code-behind (FlashMuteOverlay). -->
            <Border x:Name="MuteOverlay" IsHitTestVisible="False" IsVisible="{Binding !IsViewingImage}"
                    Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="96" Height="96" CornerRadius="48" Background="#8C000000">
              <Border.Transitions>
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.3" /></Transitions>
              </Border.Transitions>
              <Panel>
                <mi:MaterialIcon Kind="VolumeOff" Width="46" Height="46" Foreground="White"
                                 IsVisible="{Binding IsMuted}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                <mi:MaterialIcon Kind="VolumeHigh" Width="46" Height="46" Foreground="White"
                                 IsVisible="{Binding !IsMuted}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Panel>
            </Border>

            <!-- Thin loading strip while a clip is opening (big HDD files take seconds) -->
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsClipLoading}"
                         Height="3" MinHeight="3" VerticalAlignment="Top" Margin="1,1,1,0"
                         Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0" />

            <!-- Big centre play (mockup): shown while paused, over the picture -->
            <Button Classes="playbtn" Width="66" Height="66" CornerRadius="33"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Focusable="False" Command="{Binding PlayPauseCommand}"
                    IsVisible="{Binding !IsPlaying}">
              <mi:MaterialIcon Kind="Play" Width="26" Height="26" Foreground="{DynamicResource OnAccent}"
                               Margin="3,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>

            <!-- Control bar (floating over the video). Screenshot mode hides all but fullscreen. -->
            <Border x:Name="ControlsBar" Margin="12" VerticalAlignment="Bottom"
                    Classes.compact="{Binding IsViewingImage}"
                    Background="{DynamicResource PlayerBarBrush}" CornerRadius="12" Padding="14,12,14,10">
              <StackPanel Spacing="10">

                <!-- Progress: time + timeline -->
                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !IsViewingImage}">
                  <TextBlock x:Name="TimeText" Grid.Column="0" Text="0:00.000 / 0:00.000"
                             FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{DynamicResource TextMid}"
                             VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="120" />
                  <Slider Grid.Column="1" Minimum="0" Maximum="1"
                          Value="{Binding Position, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>

                <!-- Buttons row: transport centred, right cluster pinned right -->
                <Grid Height="40">

                  <!-- Transport (centred, hidden for screenshots) -->
                  <StackPanel Orientation="Horizontal" Spacing="6"
                              IsVisible="{Binding !IsViewingImage}"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Classes="pbtn" Command="{Binding StopCommand}"
                            ToolTip.Tip="{DynamicResource Tooltip_Stop}">
                      <mi:MaterialIcon Kind="Stop" Width="17" Height="17" />
                    </Button>
                    <Button Classes="pbtn" Command="{Binding SeekBackwardCommand}"
                            ToolTip.Tip="{DynamicResource Tooltip_Rewind}">
                      <mi:MaterialIcon Kind="RotateLeft" Width="18" Height="18" />
                    </Button>
                    <Button Classes="playbtn" Width="48" Height="48" CornerRadius="24" Margin="4,0"
                            Focusable="False" Command="{Binding PlayPauseCommand}"
                            ToolTip.Tip="{DynamicResource Tooltip_PlayPause}">
                      <Panel>
                        <mi:MaterialIcon Kind="Play" Width="19" Height="19" Foreground="{DynamicResource OnAccent}"
                                         Margin="2,0,0,0" IsVisible="{Binding !IsPlaying}" />
                        <mi:MaterialIcon Kind="Pause" Width="18" Height="18" Foreground="{DynamicResource OnAccent}"
                                         IsVisible="{Binding IsPlaying}" />
                      </Panel>
                    </Button>
                    <Button Classes="pbtn" Command="{Binding SeekForwardCommand}"
                            ToolTip.Tip="{DynamicResource Tooltip_Forward}">
                      <mi:MaterialIcon Kind="RotateRight" Width="18" Height="18" />
                    </Button>
                    <Button Classes="pbtn" Command="{Binding PlayNextCommand}"
                            ToolTip.Tip="{DynamicResource Tooltip_Next}">
                      <mi:MaterialIcon Kind="SkipNext" Width="18" Height="18" />
                    </Button>
                  </StackPanel>

                  <!-- Right cluster: speed · edit · volume · fullscreen -->
                  <StackPanel Orientation="Horizontal" Spacing="6"
                              HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Playback speed (deep slow-mo via the flyout list) -->
                    <Button x:Name="SpeedButton" Classes="pbtn" Width="NaN" MinWidth="40" Padding="9,0"
                            IsVisible="{Binding !IsViewingImage}">
                      <TextBlock Text="{Binding SpeedLabel}" FontFamily="{StaticResource FontMono}" FontSize="12" />
                      <Button.Flyout>
                        <Flyout Placement="Top">
                          <ListBox Classes="speedlist" x:CompileBindings="False" Width="96" MaxHeight="320"
                                   ItemsSource="{Binding SpeedOptions}"
                                   SelectedItem="{Binding PlaybackSpeed, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding, StringFormat='{}{0}x'}" FontSize="12.5" />
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <Button Classes="pbtn" Width="34" Height="34" CornerRadius="9"
                            x:CompileBindings="False"
                            IsVisible="{Binding !IsViewingImage}"
                            Command="{Binding DataContext.OpenEditorFromPlayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip.Tip="{DynamicResource Editor_Edit}">
                      <mi:MaterialIcon Kind="MovieEditOutline" Width="16" Height="16" />
                    </Button>
                    <!-- Click the icon (or press M) to mute/unmute — pops on click (OnVolumeIconPressed). -->
                    <Panel x:Name="VolumeIcon" IsVisible="{Binding !IsViewingImage}" VerticalAlignment="Center"
                           Cursor="Hand" Background="Transparent" PointerPressed="OnVolumeIconPressed"
                           RenderTransformOrigin="50%,50%" RenderTransform="scale(1)"
                           ToolTip.Tip="{DynamicResource Tooltip_Volume}">
                      <Panel.Transitions>
                        <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.13" Easing="CubicEaseOut" /></Transitions>
                      </Panel.Transitions>
                      <mi:MaterialIcon Kind="VolumeHigh" Width="16" Height="16" IsVisible="{Binding !IsMuted}"
                                       Foreground="{DynamicResource TextMid}" VerticalAlignment="Center" />
                      <mi:MaterialIcon Kind="VolumeOff" Width="16" Height="16" IsVisible="{Binding IsMuted}"
                                       Foreground="{DynamicResource DangerStop}" VerticalAlignment="Center" />
                    </Panel>
                    <Slider Classes="volume" Width="56" Minimum="0" Maximum="100"
                            Value="{Binding Volume, Mode=TwoWay}"
                            IsVisible="{Binding !IsViewingImage}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource Tooltip_Volume}" />
                    <Button Classes="pbtn" Width="34" Height="34" CornerRadius="9"
                            x:CompileBindings="False"
                            Command="{Binding DataContext.ToggleFullscreenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip.Tip="{DynamicResource Tooltip_Fullscreen}">
                      <mi:MaterialIcon Kind="Fullscreen" Width="16" Height="16" />
                    </Button>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </Panel>
        </Border>
      </Grid>

      <!-- ── Replay panel (w300). In fullscreen the code-behind turns it into a right-edge
           overlay revealed by cursor proximity. ── -->
      <Border Grid.Column="1" Width="300" Margin="16,0,0,0"
              x:Name="ReplayPanel"
              Background="{DynamicResource SurfaceApp}" BorderBrush="{DynamicResource BorderCard}"
              BorderThickness="1" CornerRadius="14">
        <Grid RowDefinitions="Auto,*,Auto">

          <!-- Thin strip while the replay LIST is being scanned (same as the Library's) -->
          <ProgressBar Grid.Row="0" IsIndeterminate="True" IsVisible="{Binding Library.IsLoading}"
                       Height="3" MinHeight="3" VerticalAlignment="Top" Margin="1,1,1,0"
                       Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0" />

          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="18,18,18,12">
            <TextBlock Grid.Column="0" Text="{DynamicResource Player_Replays}"
                       FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource TextFaintest}" />
            <TextBlock Grid.Column="1" Text="{Binding TotalClips}"
                       FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource TextFaintest}" />
          </Grid>

          <ListBox Grid.Row="1" Classes="replays" Margin="10,0"
                   ItemsSource="{Binding Clips}"
                   SelectedItem="{Binding ActiveSidebarClip, Mode=TwoWay}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:ReplayClip">
                <!-- Background=Transparent so the WHOLE row is hit-testable for the right-click menu
                     (not just the thumbnail, which was the only part with a brush). -->
                <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{DynamicResource Editor_Edit}" Click="OnReplayEditClick">
                        <MenuItem.Icon><mi:MaterialIcon Kind="MovieEditOutline" Width="16" Height="16" /></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="{DynamicResource Library_ShowInFolder}" Click="OnReplayShowInFolderClick">
                        <MenuItem.Icon><mi:MaterialIcon Kind="FolderSearchOutline" Width="16" Height="16" /></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="{DynamicResource Library_Delete}" Click="OnReplayDeleteClick">
                        <MenuItem.Icon><mi:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" /></MenuItem.Icon>
                      </MenuItem>
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <Border Grid.Column="0" Width="64" Height="36" CornerRadius="7"
                          ClipToBounds="True" Background="#16181E">
                    <Panel>
                      <Panel.Clip>
                        <RectangleGeometry Rect="0,0,64,36" RadiusX="7" RadiusY="7" />
                      </Panel.Clip>
                      <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="11,0,0,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHi}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ShortMeta}" FontFamily="{StaticResource FontMono}"
                               FontSize="10" Foreground="{DynamicResource TextFaint}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Stats footer -->
          <StackPanel Grid.Row="2" Spacing="8" Margin="18,14">
            <Border Height="1" Background="{DynamicResource BorderCard}" Margin="0,0,0,2" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{DynamicResource Player_Clips}"
                         FontSize="12.5" Foreground="{DynamicResource TextMuted}" />
              <TextBlock Grid.Column="1" Text="{Binding TotalClips}"
                         FontFamily="{StaticResource FontMono}" FontSize="12.5" Foreground="{DynamicResource TextHi}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{DynamicResource Player_Duration}"
                         FontSize="12.5" Foreground="{DynamicResource TextMuted}" />
              <TextBlock Grid.Column="1" Text="{Binding TotalDurationDisplay}"
                         FontFamily="{StaticResource FontMono}" FontSize="12.5" Foreground="{DynamicResource TextHi}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{DynamicResource Player_Used}"
                         FontSize="12.5" Foreground="{DynamicResource TextMuted}" />
              <TextBlock Grid.Column="1" Text="{Binding TotalSizeDisplay}"
                         FontFamily="{StaticResource FontMono}" FontSize="12.5" Foreground="{DynamicResource TextHi}" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>

</UserControl>
