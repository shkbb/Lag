<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lag.ViewModels"
             xmlns:models="using:Lag.Models"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Lag.Views.PlayerView"
             x:DataType="vm:PlayerViewModel"
             Focusable="True">

  <!-- Spacebar toggles play/pause while the player view is focused. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Space" Command="{Binding PlayPauseCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <!-- Cyan play marker on the selected replay thumb -->
    <Style Selector="ListBox.replays ListBoxItem mi|MaterialIcon.selplay">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.replays ListBoxItem:selected mi|MaterialIcon.selplay">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Floating control bar: slides/fades away in fullscreen until the cursor
         approaches the bottom edge (class "hidden" is toggled in code-behind). -->
    <Style Selector="Border#ControlsBar">
      <Setter Property="RenderTransform" Value="translateY(0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#ControlsBar.hidden">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateY(20px)" />
    </Style>

    <!-- Replays side panel: in fullscreen it overlays the right edge and slides in
         when the cursor approaches it (class "hiddenR" toggled in code-behind). -->
    <Style Selector="Border#ReplayPanel">
      <Setter Property="RenderTransform" Value="translateX(0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#ReplayPanel.hiddenR">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateX(24px)" />
    </Style>

    <!-- Screenshot mode: the bar shrinks to a compact pill holding only the fullscreen button -->
    <Style Selector="Border#ControlsBar.compact">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="PlayerArea" RowDefinitions="Auto,*" Margin="24,20,24,24">

    <!-- ── Clip title + meta ── -->
    <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,14"
                x:Name="HeaderBlock"
                x:CompileBindings="False"
                IsVisible="{Binding !DataContext.IsFullscreen, RelativeSource={RelativeSource AncestorType=Window}}">
      <TextBlock Text="{Binding CurrentClip.DisplayName, FallbackValue=''}"
                 FontSize="16" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="{Binding CurrentClip.CreatedDate, StringFormat='{}{0:d MMM, HH:mm}', FallbackValue=''}"
                   FontSize="12" Foreground="{StaticResource Fg2Brush}" />
        <TextBlock Text="·" FontSize="12" Foreground="{StaticResource Fg2Brush}"
                   IsVisible="{Binding CurrentClip, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{Binding CurrentClip.DurationDisplay, FallbackValue=''}"
                   FontSize="12" Foreground="{StaticResource Fg2Brush}" />
      </StackPanel>
    </StackPanel>

    <!-- ── Player row: video | replay list ── -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

      <!-- Video container (#07090C, r12). The control bar OVERLAYS the video (no native
           HWND anymore), so the picture gets the full height — like the Figma frame. -->
      <Border x:Name="VideoFrame" Grid.Column="0"
              Background="{StaticResource VideoBrush}"
              CornerRadius="12" ClipToBounds="True">
        <Panel>

          <!-- Video surface: decoded frames land in an Avalonia bitmap, so this is a plain
               Image — clipping/overlays work, and click-to-pause is a normal pointer event. -->
          <Panel x:Name="VideoSurface" Background="Transparent"
                 PointerPressed="OnVideoSurfacePressed">
            <Image x:Name="VideoImage" Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
          </Panel>

          <!-- Placeholder when no clip is loaded -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                      Spacing="10" IsHitTestVisible="False"
                      IsVisible="{Binding CurrentClip, Converter={x:Static ObjectConverters.IsNull}}">
            <Viewbox Width="44" Height="44" HorizontalAlignment="Center">
              <Canvas Width="22" Height="22">
                <Path Data="{StaticResource LogoArcGeometry}" Stroke="{StaticResource EmptyIconBrush}"
                      StrokeThickness="0.8" StrokeLineCap="Round" StrokeJoin="Round" />
                <Path Data="{StaticResource LogoCornerGeometry}" Stroke="{StaticResource EmptyIconBrush}"
                      StrokeThickness="0.8" StrokeLineCap="Round" StrokeJoin="Round" />
                <Path Data="{StaticResource LogoHandsGeometry}" Stroke="{StaticResource EmptyIconBrush}"
                      StrokeThickness="0.8" StrokeLineCap="Round" StrokeJoin="Round" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="{DynamicResource Player_Placeholder}"
                       FontSize="13" Foreground="{StaticResource Fg3Brush}"
                       HorizontalAlignment="Center" />
          </StackPanel>

          <!-- Control bar (design: rgba(10,12,15,.82), r10, floating over the video).
               Screenshot mode hides everything except the fullscreen toggle. -->
          <Border x:Name="ControlsBar" Margin="12" VerticalAlignment="Bottom"
                  Classes.compact="{Binding IsViewingImage}"
                  Background="#D10A0C0F" CornerRadius="10"
                  Padding="14,12,14,10">
            <StackPanel Spacing="10">

              <!-- Timeline (hidden while a screenshot is displayed) -->
              <Slider Minimum="0" Maximum="1"
                      Value="{Binding Position, Mode=TwoWay}"
                      IsVisible="{Binding !IsViewingImage}"
                      VerticalAlignment="Center" />

              <!-- Buttons row -->
              <Grid ColumnDefinitions="Auto,*,Auto" Height="30">

                <TextBlock Grid.Column="0" Text="{Binding TimeDisplay, FallbackValue='0:00 / 0:00'}"
                           FontSize="11" Foreground="{StaticResource Fg2Brush}"
                           IsVisible="{Binding !IsViewingImage}"
                           VerticalAlignment="Center" />

                <!-- Transport (centered, hidden for screenshots) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16"
                            IsVisible="{Binding !IsViewingImage}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Button Classes="transport" Command="{Binding StopCommand}"
                          ToolTip.Tip="{DynamicResource Tooltip_Stop}">
                    <mi:MaterialIcon Kind="Stop" Width="17" Height="17" />
                  </Button>
                  <Button Classes="transport" Command="{Binding SeekBackwardCommand}"
                          ToolTip.Tip="{DynamicResource Tooltip_Rewind}">
                    <mi:MaterialIcon Kind="RotateLeft" Width="17" Height="17" />
                  </Button>
                  <Button Width="30" Height="30" CornerRadius="15" Padding="0"
                          Background="White" BorderThickness="0" Cursor="Hand"
                          Focusable="False"
                          Command="{Binding PlayPauseCommand}"
                          ToolTip.Tip="{DynamicResource Tooltip_PlayPause}">
                    <Panel>
                      <mi:MaterialIcon Kind="Play" Width="15" Height="15"
                                       Foreground="{StaticResource OnAccentBrush}"
                                       IsVisible="{Binding !IsPlaying}" />
                      <mi:MaterialIcon Kind="Pause" Width="14" Height="14"
                                       Foreground="{StaticResource OnAccentBrush}"
                                       IsVisible="{Binding IsPlaying}" />
                    </Panel>
                  </Button>
                  <Button Classes="transport" Command="{Binding SeekForwardCommand}"
                          ToolTip.Tip="{DynamicResource Tooltip_Forward}">
                    <mi:MaterialIcon Kind="RotateRight" Width="17" Height="17" />
                  </Button>
                  <Button Classes="transport" Command="{Binding PlayNextCommand}"
                          ToolTip.Tip="{DynamicResource Tooltip_Next}">
                    <mi:MaterialIcon Kind="SkipNext" Width="17" Height="17" />
                  </Button>
                </StackPanel>

                <!-- Speed + edit + volume + fullscreen (right; screenshots keep only fullscreen) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                  <!-- Playback speed: deep slow-mo down to 0.05x -->
                  <Button Classes="transport" MinWidth="40"
                          IsVisible="{Binding !IsViewingImage}">
                    <TextBlock Text="{Binding SpeedLabel}" FontSize="12" FontWeight="Medium" />
                    <Button.Flyout>
                      <Flyout Placement="Top">
                        <ListBox x:CompileBindings="False" Width="80" MaxHeight="300"
                                 ItemsSource="{Binding SpeedOptions}"
                                 SelectedItem="{Binding PlaybackSpeed, Mode=TwoWay}">
                          <ListBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding, StringFormat='{}{0}x'}" FontSize="12" />
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <Button Classes="transport"
                          x:CompileBindings="False"
                          IsVisible="{Binding !IsViewingImage}"
                          Command="{Binding DataContext.OpenEditorFromPlayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          ToolTip.Tip="{DynamicResource Editor_Edit}">
                    <mi:MaterialIcon Kind="MovieEditOutline" Width="16" Height="16" />
                  </Button>
                  <mi:MaterialIcon Kind="VolumeHigh" Width="16" Height="16"
                                   IsVisible="{Binding !IsViewingImage}"
                                   Foreground="{StaticResource Fg2Brush}" VerticalAlignment="Center" />
                  <Slider Classes="volume" Width="56" Minimum="0" Maximum="100"
                          Value="{Binding Volume, Mode=TwoWay}"
                          IsVisible="{Binding !IsViewingImage}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="{DynamicResource Tooltip_Volume}" />
                  <Button Classes="transport"
                          x:CompileBindings="False"
                          Command="{Binding DataContext.ToggleFullscreenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          ToolTip.Tip="{DynamicResource Tooltip_Fullscreen}">
                    <mi:MaterialIcon Kind="Fullscreen" Width="16" Height="16" />
                  </Button>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </Panel>
      </Border>

      <!-- ── Replay list (w248, design card). In fullscreen the code-behind turns it
           into a right-edge overlay revealed by cursor proximity. ── -->
      <Border Grid.Column="1" Width="248" Margin="16,0,0,0"
              x:Name="ReplayPanel"
              Background="{StaticResource CardBrush}" CornerRadius="12"
              Padding="10,12">
        <Grid RowDefinitions="Auto,*,Auto">

          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,4,8">
            <TextBlock Grid.Column="0" Text="{DynamicResource Player_Replays}"
                       FontSize="13" FontWeight="Medium" />
            <TextBlock Grid.Column="1" Text="{Binding TotalClips}"
                       FontSize="12" Foreground="{StaticResource Fg3Brush}" />
          </Grid>

          <ListBox Grid.Row="1" Classes="replays"
                   ItemsSource="{Binding Clips}"
                   SelectedItem="{Binding ActiveSidebarClip, Mode=TwoWay}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:ReplayClip">
                <Grid ColumnDefinitions="Auto,*" >
                  <Border Grid.Column="0" Width="64" Height="36" CornerRadius="6"
                          ClipToBounds="True" Background="#232A33">
                    <!-- Border.ClipToBounds clips to the rectangle, not the corner radius —
                         a rounded Clip geometry is what actually rounds the thumbnail. -->
                    <Panel>
                      <Panel.Clip>
                        <RectangleGeometry Rect="0,0,64,36" RadiusX="6" RadiusY="6" />
                      </Panel.Clip>
                      <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                      <mi:MaterialIcon Classes="selplay" Kind="Play" Width="12" Height="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ShortMeta}" FontSize="11"
                               Foreground="{StaticResource Fg3Brush}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Stats footer -->
          <StackPanel Grid.Row="2" Spacing="8">
            <Border Height="1" Background="{StaticResource Divider6Brush}" Margin="0,2,0,2" />
            <Grid ColumnDefinitions="*,Auto" Margin="4,0">
              <TextBlock Grid.Column="0" Text="{DynamicResource Player_Clips}"
                         FontSize="12" Foreground="{StaticResource Fg2Brush}" />
              <TextBlock Grid.Column="1" Text="{Binding TotalClips}"
                         FontSize="12" FontWeight="Medium" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Margin="4,0">
              <TextBlock Grid.Column="0" Text="{DynamicResource Player_Duration}"
                         FontSize="12" Foreground="{StaticResource Fg2Brush}" />
              <TextBlock Grid.Column="1" Text="{Binding TotalDurationDisplay}"
                         FontSize="12" FontWeight="Medium" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Margin="4,0">
              <TextBlock Grid.Column="0" Text="{DynamicResource Player_Used}"
                         FontSize="12" Foreground="{StaticResource Fg2Brush}" />
              <TextBlock Grid.Column="1" Text="{Binding TotalSizeDisplay}"
                         FontSize="12" FontWeight="Medium" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>

</UserControl>
