<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Compile against the Windows 11 (22621) WinRT projection so we can reach the newer
         Graphics.Capture knobs — GraphicsCaptureSession.IsBorderRequired (kill the
         yellow capture border) and MinUpdateInterval (cap WGC frame rate). We still RUN on
         Windows 10 1903+: SupportedOSPlatformVersion stays 19041 and every 22621-only call is
         guarded at runtime (ApiInformation / OperatingSystem.IsWindowsVersionAtLeast). -->
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Rebrand: assembly is named "Lag" so avares://Lag/... resource URIs resolve. -->
    <AssemblyName>Lag</AssemblyName>
    <RootNamespace>Lag</RootNamespace>
  </PropertyGroup>

  <!-- Windows-specific build settings -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Custom branding icon embedded into the .exe -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Linux-specific build settings -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <!-- Windows: bundle our own FFmpeg 7.1 (shared, GPL) — the native VFR engine binds these libs
       (avcodec-61/avformat-61/avutil-59/swresample-5) and the editor export calls ffmpeg.exe. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="ffmpeg\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- RNNoise model (BSD-3, Xiph) for the arnndn mic noise-suppression filter — see rnnoise/LICENSE-rnnoise.txt. -->
    <Content Include="rnnoise\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Branding assets -->
  <ItemGroup>
    <!-- Embed assets (icon) as Avalonia resources so avares:// URIs resolve. -->
    <AvaloniaResource Include="Assets\**" />
    <!-- Also copy the sound file to the output dir so System.Media.SoundPlayer can load it from disk. -->
    <None Update="Assets\save.wav" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\screenshot.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia UI -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />

    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="FFMpegCore" Version="5.4.0" />
    <PackageReference Include="Material.Icons.Avalonia" Version="2.1.10" />

    <!-- DI -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />

    <!-- Cross-platform global hotkeys -->
    <PackageReference Include="SharpHook" Version="5.3.9" />

    <!-- Video playback -->
    <PackageReference Include="LibVLCSharp" Version="3.9.2" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.9.2" />
    <!-- LibVLCSharp drags in Microsoft.WindowsAppSDK (WinUI) once we target a versioned Windows
         TFM. We render video through vmem callbacks into Avalonia, never WinUI, so cut it out —
         its legacy win10-* RID native assets otherwise break framework resolution on the .NET 10
         SDK (NETSDK1083). ExcludeAssets=all keeps it fully out of the graph. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240627000" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Velopack" Version="1.1.1" />
  </ItemGroup>

  <!-- Windows-only dependencies: NAudio (WASAPI), SharpDX (DXGI), VLC native binaries -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="NAudio.Core" Version="2.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <!-- Direct2D + DirectWrite: the in-frame overlay compositor (webcam PiP, keystroke badges) -->
    <PackageReference Include="SharpDX.Direct2D1" Version="4.2.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <!-- Native VFR capture engine: binds to the bundled FFmpeg 7.1 libs in ffmpeg/
         (avcodec-61/avformat-61/avutil-59) for hardware/CPU encode + mp4 mux with real
         per-frame timestamps. Version must match libavcodec major 61 (FFmpeg 7.x). -->
    <PackageReference Include="FFmpeg.AutoGen" Version="7.0.0" />
    <!-- Provides System.Media.SoundPlayer (not in the base net8.0-windows SDK) -->
    <PackageReference Include="System.Windows.Extensions" Version="8.0.0" />
    <!-- GDI screenshot capture (Bitmap/Graphics.CopyFromScreen) -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

</Project>
