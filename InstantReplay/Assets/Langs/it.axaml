<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

  <!-- ════════ Shell / Navigation ════════ -->
  <sys:String x:Key="App_Tagline">Registrazione dello schermo in background</sys:String>
  <sys:String x:Key="Nav_Header">NAVIGAZIONE</sys:String>
  <sys:String x:Key="Nav_Settings">Impostazioni</sys:String>
  <sys:String x:Key="Nav_Library">Libreria</sys:String>
  <sys:String x:Key="Nav_Player">Lettore</sys:String>
  <sys:String x:Key="Btn_StartRecording">Avvia registrazione</sys:String>
  <sys:String x:Key="Btn_StopRecording">Ferma registrazione</sys:String>
  <sys:String x:Key="Btn_SaveReplay">Salva replay</sys:String>

  <!-- ════════ Settings ════════ -->
  <sys:String x:Key="Settings_Title">Impostazioni</sys:String>
  <sys:String x:Key="Settings_PendingChanges">Le modifiche avranno effetto dopo il riavvio della registrazione.</sys:String>
  <sys:String x:Key="Settings_Group_Language">LINGUA</sys:String>
  <sys:String x:Key="Settings_Language">Lingua</sys:String>
  <sys:String x:Key="Settings_Group_Recording">REGISTRAZIONE</sys:String>
  <sys:String x:Key="Settings_BufferLength">Durata del buffer di replay</sys:String>
  <sys:String x:Key="Settings_Display">Schermo</sys:String>
  <sys:String x:Key="Settings_Microphone">Microfono</sys:String>
  <sys:String x:Key="Settings_FrameRate">Frequenza fotogrammi (FPS)</sys:String>
  <sys:String x:Key="Settings_MicVolume">Volume del microfono</sys:String>
  <sys:String x:Key="Settings_OutputResolution">Risoluzione di uscita</sys:String>
  <sys:String x:Key="Settings_Codec">Codec video</sys:String>
  <sys:String x:Key="Settings_AutoCleanup">Pulizia automatica della libreria</sys:String>
  <sys:String x:Key="Settings_AutoCleanup_Desc">Elimina automaticamente i clip più vecchi quando la libreria supera il limite</sys:String>
  <sys:String x:Key="Settings_StorageLimit">Limite di dimensione della libreria</sys:String>
  <sys:String x:Key="Tab_Video">Video</sys:String>
  <sys:String x:Key="Tab_Audio">Audio</sys:String>
  <sys:String x:Key="Tab_General">Generale</sys:String>
  <sys:String x:Key="Settings_Bitrate">Bitrate</sys:String>
  <sys:String x:Key="Settings_Bitrate_CustomSuffix">Mbps</sys:String>
  <sys:String x:Key="Settings_Gpu">GPU di registrazione</sys:String>
  <sys:String x:Key="Settings_Format">Formato file</sys:String>
  <sys:String x:Key="Settings_Group_Mic">MICROFONO</sys:String>
  <sys:String x:Key="Settings_Group_SystemAudio">AUDIO DI SISTEMA</sys:String>
  <sys:String x:Key="Settings_AudioMode">Modalità di registrazione</sys:String>
  <sys:String x:Key="AudioMode_All">Tutto l'audio del PC</sys:String>
  <sys:String x:Key="AudioMode_Apps">App specifiche</sys:String>
  <sys:String x:Key="Settings_AppsHint">Le app appariranno qui quando inizieranno a riprodurre audio.</sys:String>
  <sys:String x:Key="Settings_MicChannels">Canali</sys:String>
  <sys:String x:Key="Channels_Stereo">Stereo</sys:String>
  <sys:String x:Key="Channels_Mono">Mono</sys:String>
  <sys:String x:Key="Settings_Ptt">Push-to-talk</sys:String>
  <sys:String x:Key="Settings_Ptt_Desc">Il microfono è attivo solo mentre il tasto è premuto</sys:String>
  <sys:String x:Key="Settings_PttKey">Tasto push-to-talk</sys:String>
  <sys:String x:Key="Settings_SeparateTracks">Tracce audio separate</sys:String>
  <sys:String x:Key="Settings_SeparateTracks_Desc">L'audio di sistema e il microfono vengono salvati come tracce separate nel file</sys:String>
  <sys:String x:Key="Settings_Group_Automation">AUTOMAZIONE</sys:String>
  <sys:String x:Key="Settings_StartWithWindows">Avvia con Windows</sys:String>
  <sys:String x:Key="Settings_StartWithWindows_Desc">Aggiunge l'app all'avvio del sistema</sys:String>
  <sys:String x:Key="Settings_AutoStart">Avvia registrazione automaticamente</sys:String>
  <sys:String x:Key="Settings_AutoStart_Desc">Il buffer di replay si avvia subito dopo l'apertura del programma</sys:String>
  <sys:String x:Key="Settings_Group_Hotkey">TASTO DI SCELTA RAPIDA</sys:String>
  <sys:String x:Key="Settings_Hotkey_SaveReplay">Salva replay</sys:String>
  <sys:String x:Key="Settings_Hotkey_Desc">Fai clic sul pulsante, quindi premi la combinazione di tasti desiderata</sys:String>
  <sys:String x:Key="Settings_Hotkey_Change">Cambia</sys:String>
  <sys:String x:Key="Settings_Hotkey_Listening">In ascolto...</sys:String>
  <sys:String x:Key="Settings_Group_Paths">PERCORSI</sys:String>
  <sys:String x:Key="Settings_LibraryFolder">Cartella della libreria</sys:String>
  <sys:String x:Key="Settings_Browse">Sfoglia</sys:String>
  <sys:String x:Key="About_Group">INFORMAZIONI</sys:String>
  <sys:String x:Key="About_Version">Versione</sys:String>
  <sys:String x:Key="About_CheckUpdates">Controlla aggiornamenti</sys:String>
  <sys:String x:Key="Update_Checking">Ricerca aggiornamenti...</sys:String>
  <sys:String x:Key="Update_UpToDate">Hai l'ultima versione.</sys:String>
  <sys:String x:Key="Update_Downloading">Download dell'aggiornamento...</sys:String>
  <sys:String x:Key="Update_DevMode">Gli aggiornamenti non sono disponibili in modalità sviluppo.</sys:String>
  <sys:String x:Key="Update_Failed">Aggiornamento non riuscito: {0}</sys:String>

  <!-- ════════ Library ════════ -->
  <sys:String x:Key="Library_Title">Libreria</sys:String>
  <sys:String x:Key="Library_Subtitle">I tuoi momenti salvati</sys:String>
  <sys:String x:Key="Library_Empty">Nessun replay ancora. Avvia la registrazione e premi il tasto di scelta rapida per salvare un replay!</sys:String>
  <sys:String x:Key="Library_Delete">Elimina</sys:String>
  <sys:String x:Key="Library_OpenFolder">Apri cartella</sys:String>
  <sys:String x:Key="Library_ShowInFolder">Mostra nella cartella</sys:String>
  <sys:String x:Key="Library_FreeSpace">Spazio libero</sys:String>

  <!-- ════════ Player ════════ -->
  <sys:String x:Key="Player_Replays">REPLAY</sys:String>
  <sys:String x:Key="Player_Clips">Clip</sys:String>
  <sys:String x:Key="Player_Duration">Durata</sys:String>
  <sys:String x:Key="Player_Placeholder">Lettore video</sys:String>
  <sys:String x:Key="Player_NowPlaying">In riproduzione: </sys:String>
  <sys:String x:Key="Player_ReplayBadge">REPLAY</sys:String>
  <sys:String x:Key="Tooltip_Stop">Ferma</sys:String>
  <sys:String x:Key="Tooltip_Rewind">Indietro 10 s</sys:String>
  <sys:String x:Key="Tooltip_PlayPause">Riproduci / Pausa</sys:String>
  <sys:String x:Key="Tooltip_Forward">Avanti 10 s</sys:String>
  <sys:String x:Key="Tooltip_Next">Replay successivo</sys:String>
  <sys:String x:Key="Tooltip_Fullscreen">Schermo intero (ESC per uscire)</sys:String>
  <sys:String x:Key="Tooltip_Volume">Volume</sys:String>

  <!-- ════════ Runtime status (ViewModels) ════════ -->
  <sys:String x:Key="Status_Ready">Pronto</sys:String>
  <sys:String x:Key="Status_Starting">Avvio registrazione (OBS)...</sys:String>
  <sys:String x:Key="Status_Recording">Registrazione...</sys:String>
  <sys:String x:Key="Status_NoMonitor">Nessuno schermo selezionato per la registrazione.</sys:String>
  <sys:String x:Key="Status_ObsError">Errore OBS: {0}</sys:String>
  <sys:String x:Key="Status_Stopping">Arresto...</sys:String>
  <sys:String x:Key="Status_Stopped">Fermato</sys:String>
  <sys:String x:Key="Status_StopError">Errore di arresto: {0}</sys:String>
  <sys:String x:Key="Status_SaveError">Errore di salvataggio: {0}</sys:String>
  <sys:String x:Key="Status_ReplaySaved">Replay salvato: {0}</sys:String>
  <sys:String x:Key="Status_Saving">Salvataggio del replay...</sys:String>
  <sys:String x:Key="Status_NotRecording">La registrazione non è attiva — premi prima "Avvia registrazione".</sys:String>
  <sys:String x:Key="Hotkey_PressCombo">Premi una combinazione di tasti...</sys:String>
  <sys:String x:Key="Browse_Title">Seleziona una cartella per salvare i replay</sys:String>

  <!-- ════════ Tray menu ════════ -->
  <sys:String x:Key="Tray_SaveReplay">Salva replay</sys:String>
  <sys:String x:Key="Tray_OpenLibrary">Apri libreria</sys:String>
  <sys:String x:Key="Tray_Open">Apri</sys:String>
  <sys:String x:Key="Tray_Exit">Esci</sys:String>

  <!-- ════════ Shared option labels (dropdowns) ════════ -->
  <sys:String x:Key="Time_SecShort">{0} sec</sys:String>
  <sys:String x:Key="Time_MinShort">{0} min</sys:String>
  <sys:String x:Key="Time_HourMinShort">{0} h {1} min</sys:String>
  <sys:String x:Key="Option_Native">Nativa</sys:String>
  <sys:String x:Key="Option_Auto">Auto</sys:String>
  <sys:String x:Key="Option_Custom">Personalizzato</sys:String>

</ResourceDictionary>