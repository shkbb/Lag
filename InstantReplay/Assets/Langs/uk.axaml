<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

  <!-- ════════ Shell / Navigation ════════ -->
  <sys:String x:Key="App_Tagline">Фоновий запис екрану</sys:String>
  <sys:String x:Key="Nav_Header">НАВІГАЦІЯ</sys:String>
  <sys:String x:Key="Nav_Settings">Налаштування</sys:String>
  <sys:String x:Key="Nav_Library">Бібліотека</sys:String>
  <sys:String x:Key="Nav_Player">Програвач</sys:String>
  <sys:String x:Key="Btn_StartRecording">Почати запис</sys:String>
  <sys:String x:Key="Btn_StopRecording">Зупинити запис</sys:String>
  <sys:String x:Key="Btn_SaveReplay">Зберегти повтор</sys:String>

  <!-- ════════ Settings ════════ -->
  <sys:String x:Key="Settings_Title">Налаштування</sys:String>
  <sys:String x:Key="Settings_PendingChanges">Зміни набудуть чинності після перезапуску запису.</sys:String>
  <sys:String x:Key="Settings_Group_Language">МОВА</sys:String>
  <sys:String x:Key="Settings_Language">Мова</sys:String>
  <sys:String x:Key="Settings_Group_Recording">ЗАПИС</sys:String>
  <sys:String x:Key="Settings_BufferLength">Довжина буфера повтору</sys:String>
  <sys:String x:Key="Settings_Display">Екран</sys:String>
  <sys:String x:Key="Settings_Microphone">Мікрофон</sys:String>
  <sys:String x:Key="Settings_FrameRate">Частота кадрів (FPS)</sys:String>
  <sys:String x:Key="Settings_MicVolume">Гучність мікрофона</sys:String>
  <sys:String x:Key="Settings_OutputResolution">Роздільність виводу</sys:String>
  <sys:String x:Key="Settings_Codec">Відеокодек</sys:String>
  <sys:String x:Key="Settings_AutoCleanup">Автоочищення бібліотеки</sys:String>
  <sys:String x:Key="Settings_AutoCleanup_Desc">Автоматично видаляти найстаріші кліпи, коли бібліотека перевищує ліміт</sys:String>
  <sys:String x:Key="Settings_StorageLimit">Ліміт розміру бібліотеки</sys:String>
  <sys:String x:Key="Tab_Video">Відео</sys:String>
  <sys:String x:Key="Tab_Audio">Аудіо</sys:String>
  <sys:String x:Key="Tab_General">Загальні</sys:String>
  <sys:String x:Key="Settings_Bitrate">Бітрейт</sys:String>
  <sys:String x:Key="Settings_Bitrate_CustomSuffix">Мбіт/с</sys:String>
  <sys:String x:Key="Settings_Gpu">GPU для запису</sys:String>
  <sys:String x:Key="Settings_Format">Формат файлу</sys:String>
  <sys:String x:Key="Settings_Group_Mic">МІКРОФОН</sys:String>
  <sys:String x:Key="Settings_Group_SystemAudio">СИСТЕМНИЙ ЗВУК</sys:String>
  <sys:String x:Key="Settings_AudioMode">Режим запису</sys:String>
  <sys:String x:Key="AudioMode_All">Весь звук ПК</sys:String>
  <sys:String x:Key="AudioMode_Apps">Обрані програми</sys:String>
  <sys:String x:Key="Settings_AppsHint">Програми з'являться тут, коли почнуть відтворювати звук.</sys:String>
  <sys:String x:Key="Settings_MicChannels">Канали</sys:String>
  <sys:String x:Key="Channels_Stereo">Стерео</sys:String>
  <sys:String x:Key="Channels_Mono">Моно</sys:String>
  <sys:String x:Key="Settings_Ptt">Push-to-talk</sys:String>
  <sys:String x:Key="Settings_Ptt_Desc">Мікрофон активний лише доки затиснута клавіша</sys:String>
  <sys:String x:Key="Settings_PttKey">Клавіша push-to-talk</sys:String>
  <sys:String x:Key="Settings_SeparateTracks">Окремі аудіодоріжки</sys:String>
  <sys:String x:Key="Settings_SeparateTracks_Desc">Системний звук і мікрофон зберігаються окремими доріжками у файлі</sys:String>
  <sys:String x:Key="Settings_Group_Automation">АВТОМАТИЗАЦІЯ</sys:String>
  <sys:String x:Key="Settings_StartWithWindows">Запускати разом із Windows</sys:String>
  <sys:String x:Key="Settings_StartWithWindows_Desc">Додає застосунок до автозавантаження системи</sys:String>
  <sys:String x:Key="Settings_StartMinimized">Запускати згорнутим</sys:String>
  <sys:String x:Key="Settings_StartMinimized_Desc">Застосунок стартує прихованим у треї</sys:String>
  <sys:String x:Key="Settings_DisableGameMode">Вимикати ігровий режим Windows</sys:String>
  <sys:String x:Key="Settings_DisableGameMode_Desc">Ігровий режим Windows пригнічує фонові програми: запис у грі може падати до 1–2 кадрів/с, а збереження повтору — не спрацьовувати до alt-tab. Lag вимикатиме його автоматично. Наполегливо радимо лишити увімкненим.</sys:String>
  <sys:String x:Key="Settings_GameCapture">Захоплення ігор (хук)</sys:String>
  <sys:String x:Key="Settings_GameCapture_Desc">Потрібно для ігор в ЕКСКЛЮЗИВНОМУ повноекранному режимі. Для CS2 додатково потрібен параметр запуску Steam "-allow_third_party_software", інакше гра відхиляє хук і повторні спроби марнують CPU. Якщо граєте у віконному/безрамковому режимі — лишіть вимкненим.</sys:String>
  <sys:String x:Key="Editor_Title">Редактор</sys:String>
  <sys:String x:Key="Editor_Edit">Редагувати</sys:String>
  <sys:String x:Key="Editor_Back">Назад</sys:String>
  <sys:String x:Key="Editor_Export">Експортувати</sys:String>
  <sys:String x:Key="Editor_Exporting">Експорт… {0}%</sys:String>
  <sys:String x:Key="Editor_ExportDone">Збережено: {0}</sys:String>
  <sys:String x:Key="Editor_ExportError">Помилка експорту: {0}</sys:String>
  <sys:String x:Key="Editor_Speed">Швидкість</sys:String>
  <sys:String x:Key="Editor_Format">Формат</sys:String>
  <sys:String x:Key="Editor_TabClip">Кліп</sys:String>
  <sys:String x:Key="Editor_TabFilters">Фільтри</sys:String>
  <sys:String x:Key="Editor_Tracks">АУДІОДОРІЖКИ</sys:String>
  <sys:String x:Key="Editor_TrackSystem">Системний звук</sys:String>
  <sys:String x:Key="Editor_TrackMic">Мікрофон</sys:String>
  <sys:String x:Key="Editor_TrackAudio">Звук</sys:String>
  <sys:String x:Key="Editor_SetStart">Встановити початок кліпу на поточний момент</sys:String>
  <sys:String x:Key="Editor_SetEnd">Встановити кінець кліпу на поточний момент</sys:String>
  <sys:String x:Key="Editor_ResetTrim">Скинути обрізку</sys:String>
  <sys:String x:Key="Settings_Hotkey_Screenshot">Скріншот</sys:String>
  <sys:String x:Key="Toast_ReplaySaved">Повтор збережено</sys:String>
  <sys:String x:Key="Toast_ScreenshotSaved">Скріншот збережено</sys:String>
  <sys:String x:Key="Settings_AutoStart">Автоматично починати запис</sys:String>
  <sys:String x:Key="Settings_AutoStart_Desc">Запис у буфер повтору стартує одразу після запуску</sys:String>
  <sys:String x:Key="Settings_Group_Hotkey">ГАРЯЧІ КЛАВІШІ</sys:String>
  <sys:String x:Key="Settings_Hotkey_SaveReplay">Зберегти повтор</sys:String>
  <sys:String x:Key="Settings_Hotkey_Desc">Натисніть кнопку, а потім потрібну комбінацію клавіш</sys:String>
  <sys:String x:Key="Settings_Hotkey_Change">Змінити</sys:String>
  <sys:String x:Key="Settings_Hotkey_Listening">Слухаю...</sys:String>
  <sys:String x:Key="Settings_Group_Paths">ШЛЯХИ</sys:String>
  <sys:String x:Key="Settings_LibraryFolder">Папка бібліотеки</sys:String>
  <sys:String x:Key="Settings_Browse">Огляд</sys:String>
  <sys:String x:Key="About_Group">ПРО ПРОГРАМУ</sys:String>
  <sys:String x:Key="About_Version">Версія</sys:String>
  <sys:String x:Key="About_CheckUpdates">Перевірити оновлення</sys:String>
  <sys:String x:Key="Update_Checking">Перевірка оновлень...</sys:String>
  <sys:String x:Key="Update_UpToDate">У вас найновіша версія.</sys:String>
  <sys:String x:Key="Update_Downloading">Завантаження оновлення...</sys:String>
  <sys:String x:Key="Update_DevMode">Оновлення недоступні в режимі розробки.</sys:String>
  <sys:String x:Key="Update_Failed">Помилка оновлення: {0}</sys:String>

