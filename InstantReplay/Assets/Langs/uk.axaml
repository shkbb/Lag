  <sys:String x:Key="Option_Auto">Авто</sys:String>
  <sys:String x:Key="Option_Custom">Власний</sys:String>

  <sys:String x:Key="Sidebar_Buffer">Буфер</sys:String>
  <sys:String x:Key="Library_Stats">{0} кліпів · вільно {1}</sys:String>
  <sys:String x:Key="Player_Used">Зайнято</sys:String>

  <sys:String x:Key="Library_EmptyTitle">Поки що немає повторів</sys:String>
