  <sys:String x:Key="Settings_Bitrate_CustomSuffix">Mbps</sys:String>
  <sys:String x:Key="Settings_Gpu">録画用GPU</sys:String>
  <sys:String x:Key="Settings_Format">ファイル形式</sys:String>
  <sys:String x:Key="Settings_Group_Mic">マイク</sys:String>
  <sys:String x:Key="Settings_Group_SystemAudio">システム音声</sys:String>
  <sys:String x:Key="Settings_AudioMode">録音モード</sys:String>
  <sys:String x:Key="AudioMode_All">PCの全音声</sys:String>
  <sys:String x:Key="AudioMode_Apps">特定のアプリ</sys:String>
  <sys:String x:Key="Settings_AppsHint">アプリが音声を再生し始めると、ここに表示されます。</sys:String>
  <sys:String x:Key="Settings_MicChannels">チャンネル</sys:String>
  <sys:String x:Key="Channels_Stereo">ステレオ</sys:String>
  <sys:String x:Key="Channels_Mono">モノラル</sys:String>
  <sys:String x:Key="Settings_Ptt">プッシュトゥトーク</sys:String>
  <sys:String x:Key="Settings_Ptt_Desc">キーを押している間のみマイクが有効になります</sys:String>
  <sys:String x:Key="Settings_PttKey">プッシュトゥトークキー</sys:String>
  <sys:String x:Key="Settings_SeparateTracks">オーディオトラックを分離</sys:String>
  <sys:String x:Key="Settings_SeparateTracks_Desc">システム音声とマイクをファイル内の別々のトラックとして保存します</sys:String>
  <sys:String x:Key="Settings_Group_Automation">自動化</sys:String>
  <sys:String x:Key="Settings_StartWithWindows">Windowsと同時に起動</sys:String>
  <sys:String x:Key="Settings_StartWithWindows_Desc">アプリをシステムのスタートアップに追加します</sys:String>
  <sys:String x:Key="Settings_StartMinimized">最小化して起動</sys:String>
  <sys:String x:Key="Settings_StartMinimized_Desc">システムトレイに隠れた状態で起動します</sys:String>
  <sys:String x:Key="Settings_DisableGameMode">Windowsゲームモードを無効化</sys:String>
  <sys:String x:Key="Settings_DisableGameMode_Desc">Windowsのゲームモードはバックグラウンドアプリを制限します。ゲーム中の録画が1～2FPSまで低下したり、リプレイ保存がalt-tabするまで動作しないことがあります。Lagが自動的に無効化します。オンのままにすることを強く推奨します。</sys:String>
  <sys:String x:Key="Settings_GameCapture">ゲームキャプチャ（フック）</sys:String>
  <sys:String x:Key="Settings_GameCapture_Desc">排他的フルスクリーンのゲームに必要です。CS2ではさらにSteam起動オプション「-allow_third_party_software」が必要で、ないとフックが拒否され再試行でCPUを浪費します。ウィンドウ／ボーダーレスでプレイする場合はオフのままにしてください。</sys:String>
