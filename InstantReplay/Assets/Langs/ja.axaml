<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

  <!-- ════════ Shell / Navigation ════════ -->
  <sys:String x:Key="App_Tagline">バックグラウンド画面録画</sys:String>
  <sys:String x:Key="Nav_Header">ナビゲーション</sys:String>
  <sys:String x:Key="Nav_Settings">設定</sys:String>
  <sys:String x:Key="Nav_Library">ライブラリ</sys:String>
  <sys:String x:Key="Nav_Player">プレーヤー</sys:String>
  <sys:String x:Key="Btn_StartRecording">録画を開始</sys:String>
  <sys:String x:Key="Btn_StopRecording">録画を停止</sys:String>
  <sys:String x:Key="Btn_SaveReplay">リプレイを保存</sys:String>

  <!-- ════════ Settings ════════ -->
  <sys:String x:Key="Settings_Title">設定</sys:String>
  <sys:String x:Key="Settings_PendingChanges">変更は録画の再開後に有効になります。</sys:String>
  <sys:String x:Key="Settings_Group_Language">言語</sys:String>
  <sys:String x:Key="Settings_Language">言語</sys:String>
  <sys:String x:Key="Settings_Group_Recording">録画</sys:String>
  <sys:String x:Key="Settings_BufferLength">リプレイバッファの長さ</sys:String>
  <sys:String x:Key="Settings_Display">ディスプレイ</sys:String>
  <sys:String x:Key="Settings_Microphone">マイク</sys:String>
  <sys:String x:Key="Settings_FrameRate">フレームレート（FPS）</sys:String>
  <sys:String x:Key="Settings_MicVolume">マイク音量</sys:String>
  <sys:String x:Key="Settings_OutputResolution">出力解像度</sys:String>
  <sys:String x:Key="Settings_Codec">ビデオコーデック</sys:String>
  <sys:String x:Key="Settings_AutoCleanup">ライブラリの自動クリーンアップ</sys:String>
  <sys:String x:Key="Settings_AutoCleanup_Desc">ライブラリが上限を超えたとき、最も古いクリップを自動的に削除します</sys:String>
  <sys:String x:Key="Settings_StorageLimit">ライブラリのサイズ上限</sys:String>
  <sys:String x:Key="Tab_Video">ビデオ</sys:String>
  <sys:String x:Key="Tab_Audio">オーディオ</sys:String>
