  <sys:String x:Key="Editor_Edit">編集</sys:String>
  <sys:String x:Key="Editor_Back">戻る</sys:String>
  <sys:String x:Key="Editor_Export">エクスポート</sys:String>
  <sys:String x:Key="Editor_Exporting">エクスポート中… {0}%</sys:String>
