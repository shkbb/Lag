  <sys:String x:Key="Settings_Group_Automation">АЎТАМАТЫЗАЦЫЯ</sys:String>
  <sys:String x:Key="Settings_StartWithWindows">Запускаць разам з Windows</sys:String>
  <sys:String x:Key="Settings_StartWithWindows_Desc">Дадае праграму ў аўтазагрузку сістэмы</sys:String>
