  <sys:String x:Key="Settings_SeparateTracks">Separate lydspor</sys:String>
  <sys:String x:Key="Settings_SeparateTracks_Desc">Systemlyd og mikrofon gemmes som separate spor i filen</sys:String>
  <sys:String x:Key="Settings_Group_Automation">AUTOMATISERING</sys:String>
