export component MaterialIcon {
    in property <image> source;
    in property <brush> tint: Theme.fg-brush;
    in property <length> size: 20px;

    width: size;
    height: size;

    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        colorize: root.tint;
        image-fit: contain;
    }
}

// Rewind-clock brand mark from Tokens.axaml:28-30 (22x22 viewbox, stroked).
export component LagLogoMark {
    in property <brush> stroke: Theme.on-accent;
    in property <length> size: 22px;

    width: size;
    height: size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 22;
        viewbox-height: 22;
        commands: "M2.75 11C2.75 12.6317 3.23385 14.2267 4.14038 15.5835C5.0469 16.9402 6.33537 17.9976 7.84286 18.622C9.35035 19.2464 11.0092 19.4098 12.6095 19.0915C14.2098 18.7732 15.6798 17.9874 16.8336 16.8336C17.9874 15.6798 18.7732 14.2098 19.0915 12.6095C19.4098 11.0092 19.2464 9.35035 18.622 7.84286C17.9976 6.33537 16.9402 5.0469 15.5835 4.14038C14.2267 3.23385 12.6317 2.75 11 2.75C8.69362 2.75868 6.47989 3.65862 4.82167 5.26167L2.75 7.33333";
        stroke: root.stroke;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 22;
        viewbox-height: 22;
        commands: "M2.75 2.75V7.33333H7.33333";
        stroke: root.stroke;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 22;
        viewbox-height: 22;
        commands: "M11 6.41667V11L14.6667 12.8333";
        stroke: root.stroke;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
