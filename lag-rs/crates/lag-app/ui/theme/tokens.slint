    out property <length> shadow-modal-blur: 40px;
    out property <color> shadow-modal-color: #00000080;

    // ═══════════════════════════════════════════════════════════════════════
    // Animation Durations (App.axaml, Components.axaml, DarkTheme.axaml, Views)
    // ═══════════════════════════════════════════════════════════════════════
    out property <duration> dur-press: 80ms;
    out property <duration> dur-fast: 120ms;
    out property <duration> dur-chip: 140ms;
    out property <duration> dur-base: 150ms;
    out property <duration> dur-toggle: 160ms;
    out property <duration> dur-flyout: 180ms;
    out property <duration> dur-tabline: 200ms;
    out property <duration> dur-pill: 220ms;
    out property <duration> dur-slide-fade: 240ms;
    out property <duration> dur-panel: 250ms;
    out property <duration> dur-toast-out: 260ms;
    out property <duration> dur-theme-fade: 280ms;
    out property <duration> dur-overlay-fade: 300ms;
    out property <duration> dur-buffer: 450ms;
    out property <duration> dur-kbd-pulse: 1000ms;
    out property <duration> dur-rec-blink: 1100ms;
    out property <duration> dur-rec-dot: 1400ms;
    out property <duration> dur-capture-pulse: 1800ms;
    out property <duration> dur-toast-visible: 2400ms;
}
