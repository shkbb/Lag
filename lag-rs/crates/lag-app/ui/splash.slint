// Startup splash (owner, 2026-11-16: "like Discord's"): the app's background with the brand-coloured Lag
// rewind-clock mark animated: the rewind arrow circles backwards, the minute and hour hands run forward at
// their own speeds. Geometry is computed (sin/cos), not transformed, so every renderer draws it identically.
// Shown only on a manual launch (not when starting minimized into the tray). It also carries an update: the
// download's progress (Lag), then the install (the LagUpdate.exe helper shows this same window, crates/lag-update).
import { Theme } from "theme/tokens.slint";
export { Theme }

export component SplashWindow inherits Window {
    title: "Lag";
    no-frame: true;
    background: transparent;
    width: 300px;
    height: 340px;
    in property <string> theme-mode: "dark";
    in property <string> text: "Starting...";
    // an update: the bar under the text (progress 0..1, or `busy` = running with no known end), and a hint under it
    in property <bool> show-progress: false;
    in property <float> progress: 0;
    in property <bool> busy: false;
    in property <string> hint;
    // a click on the window while `hint` is shown (open Lag now; the update waits for the next start)
    callback skip();
    changed theme-mode => { Theme.mode = root.theme-mode; }
    init => { Theme.mode = root.theme-mode; }

    property <bool> dark: Theme.is-dark;
    // the app's own brand pairs: dark = near-black background + cyan mark; light = warm cream + bronze mark
    property <color> card: Theme.surface-app;
    // GTA VI theme: the mark in the sunset gradient over the palm backdrop (owner, 2026-11-18)
    property <bool> gta: Theme.is-neon;
    property <brush> ink: root.gta ? @linear-gradient(135deg, #FF4FA3 0%, #FF8A4C 100%) : Theme.accent;
    property <color> label: Theme.text-hi;
    property <length> mark: 104px;
    property <float> t: animation-tick() / 1ms;
    // rewind arrow: one turn backwards per 1.6 s; minute hand 1.2 s; hour hand 12x slower
    property <angle> rho: -360deg * mod(root.t, 1600) / 1600;
    property <angle> minute: -90deg + 360deg * mod(root.t, 1200) / 1200;
    property <angle> hour: 26.5deg + 360deg * mod(root.t, 14400) / 14400;

    // rotate point (x, y) of the 22x22 mark about its centre (11, 11)
    pure function rx(x: float, y: float, a: angle) -> float { return 11 + (x - 11) * cos(a) - (y - 11) * sin(a); }
    pure function ry(x: float, y: float, a: angle) -> float { return 11 + (x - 11) * sin(a) + (y - 11) * cos(a); }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 18px;
        background: root.card;
        border-width: 1px;
        border-color: root.gta ? #FF4FA366 : root.dark ? #FFFFFF14 : #00000018;
        clip: true;

        // GTA VI: the palm sunset drifts slowly behind the mark, under a veil that keeps the mark and text clear
        if root.gta: Image {
            // card height, 16:9 wide, panned left-right over 12 s (no transforms: FemtoVG shifts them at 125 %)
            height: parent.height;
            width: self.height * 16 / 9;
            x: -(self.width - parent.width) * (0.5 + 0.5 * sin(360deg * mod(root.t, 12000) / 12000));
            y: 0px;
            source: @image-url("theme/neon-backdrop.jpg");
            image-fit: cover;
        }
        if root.gta: Rectangle {
            background: @linear-gradient(180deg, #120B1EE6 0%, #120B1EB0 55%, #120B1E66 100%);
        }
        // soft glow behind the mark
        if root.gta: Rectangle {
            x: (parent.width - 190px) / 2;
            y: 92px + root.mark / 2 - 95px;
            width: 190px;
            height: 190px;
            border-radius: 95px;
            background: @radial-gradient(circle, #FF4FA355 0%, #FF4FA300 70%);
        }

        Rectangle {
            x: (parent.width - root.mark) / 2;
            y: 92px;
            width: root.mark;
            height: root.mark;

            // rewind arc (315 degrees, counter-clockwise from the left) + its tail
            Path {
                width: 100%; height: 100%;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 22; viewbox-height: 22;
                stroke: root.ink; stroke-width: root.mark * 2 / 22; stroke-line-cap: round; stroke-line-join: round; fill: transparent;
                MoveTo { x: root.rx(2.75, 11, root.rho); y: root.ry(2.75, 11, root.rho); }
                ArcTo {
                    x: root.rx(5.166, 5.166, root.rho); y: root.ry(5.166, 5.166, root.rho);
                    radius-x: 8.25; radius-y: 8.25; large-arc: true; sweep: false;
                }
                LineTo { x: root.rx(2.75, 7.333, root.rho); y: root.ry(2.75, 7.333, root.rho); }
            }
            // arrow head
            Path {
                width: 100%; height: 100%;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 22; viewbox-height: 22;
                stroke: root.ink; stroke-width: root.mark * 2 / 22; stroke-line-cap: round; stroke-line-join: round; fill: transparent;
                MoveTo { x: root.rx(2.75, 2.75, root.rho); y: root.ry(2.75, 2.75, root.rho); }
                LineTo { x: root.rx(2.75, 7.333, root.rho); y: root.ry(2.75, 7.333, root.rho); }
                LineTo { x: root.rx(7.333, 7.333, root.rho); y: root.ry(7.333, 7.333, root.rho); }
            }
            // hands
            Path {
                width: 100%; height: 100%;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 22; viewbox-height: 22;
                stroke: root.ink; stroke-width: root.mark * 2 / 22; stroke-line-cap: round; stroke-line-join: round; fill: transparent;
                MoveTo { x: 11 + 4.583 * cos(root.minute); y: 11 + 4.583 * sin(root.minute); }
                LineTo { x: 11; y: 11; }
                LineTo { x: 11 + 4.1 * cos(root.hour); y: 11 + 4.1 * sin(root.hour); }
            }
        }

        Text {
            x: 0;
            y: 92px + root.mark + 40px;
            width: parent.width;
            text: root.text;
            color: root.label;
            font-family: Theme.font-ui;
            font-size: 15px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        if root.show-progress: Rectangle {
            x: (parent.width - 180px) / 2;
            y: 92px + root.mark + 40px + 32px;
            width: 180px;
            height: 4px;
            border-radius: 2px;
            clip: true;
            background: root.dark ? #FFFFFF1F : #0000001F;
            // known progress: filled from the left; busy: a segment sweeping across
            Rectangle {
                x: root.busy ? (parent.width + self.width) * mod(root.t, 1400) / 1400 - self.width : 0px;
                width: root.busy ? 60px : parent.width * clamp(root.progress, 0, 1);
                height: 100%;
                border-radius: 2px;
                background: root.ink;
            }
        }
        if root.hint != "": Text {
            x: 20px;
            y: 92px + root.mark + 40px + 48px;
            width: parent.width - 40px;
            text: root.hint;
            color: Theme.text-faint;
            font-family: Theme.font-ui;
            font-size: 11.5px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        if root.hint != "": TouchArea {
            mouse-cursor: pointer;
            clicked => { root.skip(); }
        }
    }
}
