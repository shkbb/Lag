// The Lag theme API, version 1 (docs/spec/themes.md §4, reference: docs/themes/API.md). A theme imports what it
// needs from "@lag/api.slint":
//   import { MainVM, LibraryVM, Tr } from "@lag/api.slint";
// Lag fills these globals and listens to their callbacks; the theme draws them however it likes. Lag's own
// building blocks (buttons, cards, the settings rows...) can be imported too, e.g. "@lag/components/buttons.slint",
// and the design tokens from "@lag/theme/tokens.slint". Names here only grow; nothing is renamed or removed
// within an API version.
export { Tr, MainVM, WindowMetrics, SettingsVM, LibraryVM, PlayerVM, EditorVM, PlayerOverlayVM, EditorOverlayVM, AutoScroll } from "api/globals.slint";
export {
    Page, ComboBoxItemData, SegmentedOption, OverlayBoxData, EditorClipItem, EditorSegmentData, EditorAudioTrackData,
    EditorFilterData, EditorCutBand, EditorTextOverlayData, EditorColorSwatch, LibraryCardData, SettingsRowData,
    SettingsGroup, PresetData, GameChipData, LibraryRowData, PlayerClip
} from "api/types.slint";
// moving pictures and video: AnimatedImage { source: @image-url("girl.gif"); } (GIF, WebP, APNG),
// Video { source: "videos/rain.mp4"; } (MP4, WebM; from the theme's top folder)
export { Media, AnimatedImage, Video } from "api/media.slint";
