// Library page (Views/LibraryView.axaml). Owned by the library work package (docs/AGENTS.md, docs/WORKPACKAGES.md).
import { Theme } from "../theme/tokens.slint";
import { Icons, MaterialIcon, LagLogoMark } from "../theme/icons.slint";
import { Tr, MainVM, Page } from "../globals.slint";
import { RChipButton, GameChipButton, PressFx } from "../components/buttons.slint";
import { LagSearchBox } from "../components/text_input.slint";
import { RKbdChip } from "../components/badges.slint";
import { LagScrollView } from "../components/scrollbar.slint";
import { LagContextMenuContainer, LagMenuItem } from "../components/menu.slint";
import { LagCheckBox } from "../components/checkbox.slint";
import { LibraryClipTile, LibraryCardData } from "../components/library/clip_card.slint";
import { IndeterminateBar } from "../components/library/indeterminate_bar.slint";
import { GameChipData, LibraryRowData } from "../api/types.slint";
export { GameChipData, LibraryRowData }
import { LibraryVM } from "../api/globals.slint";
export { LibraryVM }

// Round scroll button at an end of the game-chip row (shown only when chips are hidden on that side).
component LibChipArrow {
    in property <image> icon;
    callback clicked();
    width: 30px;
    height: 30px;
    fx := PressFx { down: ta.pressed; extent: root.width; }
    Rectangle {
        width: 100%;
        height: 100%;
        transform-scale: fx.scale;
        border-radius: self.height / 2;
        background: ta.has-hover ? Theme.surface-hover-brush : Theme.surface-card;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000040;
        animate background { duration: Theme.dur-fast; }
        MaterialIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            size: 18px;
            tint: ta.has-hover ? Theme.text-hi : Theme.text-muted;
        }
        Rectangle {
            border-radius: parent.border-radius;
            background: Theme.press-veil;
            opacity: fx.active ? 0.5 : 0;
            animate opacity { duration: 90ms; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component LibraryPage inherits Rectangle {
    background: Theme.page-bg;

    // Context menu overlay state
    property <bool> context-menu-open: false;
    property <string> context-clip-path: "";
    property <int> context-cloud-state: 0;
    property <bool> context-cloud-only: false;
    property <bool> delete-remember: false;
    property <length> context-menu-x: 0px;
    property <length> context-menu-y: 0px;

    // LibraryView.axaml.cs:25-33: keep body hidden for 240ms on attach, then SlideFadeIn(+12 -> 0, 220ms).
    property <bool> body-shown: false;
    property <bool> body-anim: false;

    attach-delay-timer := Timer {
        interval: 240ms;
        running: !root.body-shown;
        triggered => {
            self.running = false;
            root.body-shown = true;
            anim-kick-timer.running = true;
        }
    }

    anim-kick-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            root.body-anim = true;
        }
    }

    function open-context-menu(file-path: string, cloud-state: int, cloud-only: bool, abs-x: length, abs-y: length) {
        let local-x = abs-x - root.absolute-position.x;
        let local-y = abs-y - root.absolute-position.y;
        let menu-w = 220px;
        let menu-h = 190px;
        root.context-clip-path = file-path;
        root.context-cloud-state = cloud-state;
        root.context-cloud-only = cloud-only;
        root.context-menu-x = clamp(local-x, 8px, max(8px, root.width - menu-w - 8px));
        root.context-menu-y = clamp(local-y, 8px, max(8px, root.height - menu-h - 8px));
        root.context-menu-open = true;
    }

    body-focus := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(ev) => {
            if (ev.text == Key.Escape) {
                if (root.context-menu-open) {
                    root.context-menu-open = false;
                } else {
                    LibraryVM.clear-selection();
                }
                return accept;
            }
            if ((ev.text == "a" || ev.text == "A") && ev.modifiers.control) {
                LibraryVM.select-all();
                return accept;
            }
            reject
        }

        VerticalLayout {
            width: 100%;
            height: 100%;

            // ════════════════ Header ════════════════
            VerticalLayout {
                padding-left: 38px;
                padding-right: 38px;
                padding-top: 30px;

                HorizontalLayout {
                    // Title + storage stats
                    VerticalLayout {
                        horizontal-stretch: 1;

                        Text {
                            text: Tr.t("Library_Title", Tr.rev);
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-page-title;
                            font-weight: Theme.font-weight-bold;
                            color: Theme.text-hi;
                        }

                        HorizontalLayout {
                            padding-top: 8px;
                            spacing: 16px;
                            alignment: start;

                            Text {
                                text: LibraryVM.clip-count-label;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-sm;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }

                            Text {
                                text: LibraryVM.used-space-display;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-sm;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 120px;
                                    height: 5px;
                                    border-radius: 3px;
                                    background: Theme.border-strong;
                                    clip: true;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 5px;
                                        width: clamp(LibraryVM.used-space-bar-width, 0, 120) * 1px;
                                        border-radius: 3px;
                                        background: Theme.accent;
                                    }
                                }
                            }
                        }
                    }

                    // Right-aligned bottom-anchored actions
                    VerticalLayout {
                        alignment: end;

                        HorizontalLayout {
                            spacing: 8px;

                            if LibraryVM.has-selection: RChipButton {
                                danger: true;
                                has-icon: true;
                                icon: Icons.trash-can-outline;
                                icon-size: 15px;
                                text: LibraryVM.delete-selected-label;
                                clicked => { LibraryVM.delete-selected(); }
                            }

                            if LibraryVM.has-selection: RChipButton {
                                has-icon: true;
                                icon: Icons.close-circle-outline;
                                icon-size: 15px;
                                text: Tr.t("Library_ClearSelection", Tr.rev);
                                clicked => { LibraryVM.clear-selection(); }
                            }

                            RChipButton {
                                has-icon: true;
                                icon: Icons.folder-outline;
                                icon-size: 15px;
                                text: Tr.t("Library_OpenFolder", Tr.rev);
                                clicked => { LibraryVM.open-library-folder(); }
                            }
                        }
                    }
                }

                // Filter row: Search + Game chips + Favorites toggle
                if LibraryVM.has-clips: HorizontalLayout {
                    padding-top: 24px;
                    padding-bottom: 4px;
                    spacing: 0px;

                    LagSearchBox {
                        width: 320px;
                        height: 38px;
                        placeholder: Tr.t("Library_Search", Tr.rev);
                        text <=> LibraryVM.search-text;
                        edited(s) => { LibraryVM.search-changed(s); }
                    }

                    // Horizontally scrollable game chips; vertical mouse wheel translates to horizontal scroll
                    chips-area := Rectangle {
                        horizontal-stretch: 1;
                        height: 38px;
                        clip: true;
                        // Chips run between 10px and width-12px. Where more chips hide, they fade out towards a
                        // round arrow that has its own gap (owner, 2026-11-18: no hard-cut chips, no arrows glued
                        // to the search box / Favourites).
                        property <length> view-w: max(0px, self.width - 22px);
                        property <bool> can-left: chips-flick.content-x < -1px;
                        // Smooth scrolling (owner, 2026-11-18: "the game list should move smoothly, not jerk"):
                        // the wheel and the arrows move `target`, `scroll-x` glides to it, the row follows.
                        // Fast wheel turns add up on `target`, so they become one longer glide.
                        property <length> max-x: max(0px, chips-row.preferred-width - self.view-w);
                        property <length> target: 0px;
                        property <length> scroll-x: 0px;
                        animate scroll-x { duration: 260ms; easing: cubic-bezier(0.22, 0.8, 0.3, 1); }
                        function scroll-to(x: length) {
                            self.target = clamp(x, -self.max-x, 0px);
                            self.scroll-x = self.target;
                        }
                        // fewer games / a wider window: keep the row inside its new range
                        changed max-x => {
                            if (self.target < -self.max-x) {
                                self.scroll-to(self.target);
                            }
                        }
                        property <bool> can-right: chips-row.preferred-width + chips-flick.content-x > self.view-w + 1px;

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            scroll-event(ev) => {
                                let delta = ev.delta-x != 0px ? ev.delta-x : ev.delta-y;
                                if (delta != 0px && chips-area.max-x > 0px) {
                                    chips-area.scroll-to(chips-area.target + delta);
                                    return accept;
                                }
                                reject
                            }

                            chips-flick := Flickable {
                                x: 10px;
                                y: 0px;
                                width: chips-area.view-w;
                                height: 38px;
                                // moved only by the wheel and the arrows (a drag would fight the glide)
                                interactive: false;
                                content-x: chips-area.scroll-x;
                                content-width: chips-row.preferred-width;
                                content-height: 38px;

                                chips-row := HorizontalLayout {
                                    x: 0px;
                                    y: (38px - self.preferred-height) / 2;
                                    height: self.preferred-height;
                                    spacing: 7px;

                                    // chips dissolve towards a shown arrow (they fade themselves; nothing
                                    // is drawn over the page background)
                                    for chip in LibraryVM.game-chips: GameChipButton {
                                        text: chip.label;
                                        selected: chip.is-active;
                                        fade-left: chips-area.can-left ? chips-area.absolute-position.x + 10px + 30px + 4px : -100000px;
                                        fade-right: chips-area.can-right ? chips-area.absolute-position.x + 10px + chips-area.view-w - 30px - 4px : 100000px;
                                        clicked => { LibraryVM.set-game-filter(chip.filter-key); }
                                    }
                                }
                            }
                        }

                        // Scroll arrows, only towards hidden chips
                        if chips-area.can-left: LibChipArrow {
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                            icon: Icons.chevron-left;
                            clicked => {
                                chips-area.scroll-to(chips-area.target + chips-area.view-w * 0.7);
                            }
                        }
                        if chips-area.can-right: LibChipArrow {
                            x: 10px + chips-area.view-w - self.width;
                            y: (parent.height - self.height) / 2;
                            icon: Icons.chevron-right;
                            clicked => {
                                chips-area.scroll-to(chips-area.target - chips-area.view-w * 0.7);
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        GameChipButton {
                            text: Tr.t("Library_Favorites", Tr.rev);
                            has-icon: true;
                            icon: LibraryVM.favorites-only ? Icons.star : Icons.star-outline;
                            selected: LibraryVM.favorites-only;
                            clicked => { LibraryVM.toggle-favorites-only(); }
                        }
                    }
                }
            }

            // ════════════════ Body ════════════════
            Rectangle {
                vertical-stretch: 1;
                clip: true;

                // Dual indeterminate loading bars (full-width 3px + inset 2px per LibraryView.axaml:281-283, 499-501)
                IndeterminateBar {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 3px;
                    active: LibraryVM.is-loading;
                }

                IndeterminateBar {
                    x: 38px;
                    y: 0px;
                    width: max(0px, parent.width - 76px);
                    height: 2px;
                    active: LibraryVM.is-loading;
                }

                // Body container with 240ms attach delay + SlideFadeIn (+12px -> 0, 220ms)
                Rectangle {
                    x: 0px;
                    y: root.body-anim ? 0px : 12px;
                    width: 100%;
                    height: 100%;
                    visible: root.body-shown;
                    opacity: root.body-anim ? 1.0 : 0.0;
                    animate opacity, y {
                        duration: Theme.dur-pill;
                        easing: cubic-bezier(0.215, 0.61, 0.355, 1);
                    }

                    scroll-area := LagScrollView {
                        live: MainVM.current-page == Page.library;
                        width: 100%;
                        height: 100%;
                        content-height: max(self.height, LibraryVM.total-content-height * 1px);

                        init => {
                            LibraryVM.viewport-changed(
                                -self.content-y / 1px,
                                self.width / 1px,
                                self.height / 1px
                            );
                        }

                        changed content-y => {
                            LibraryVM.viewport-changed(
                                -self.content-y / 1px,
                                self.width / 1px,
                                self.height / 1px
                            );
                        }

                        changed width => {
                            LibraryVM.viewport-changed(
                                -self.content-y / 1px,
                                self.width / 1px,
                                self.height / 1px
                            );
                        }

                        changed height => {
                            LibraryVM.viewport-changed(
                                -self.content-y / 1px,
                                self.width / 1px,
                                self.height / 1px
                            );
                        }

                        Rectangle {
                            width: scroll-area.width;
                            height: max(scroll-area.height, LibraryVM.total-content-height * 1px);
                            background: transparent;

                            // Empty-space click clears selection (LibraryView.axaml.cs:86-95)
                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    body-focus.focus();
                                    LibraryVM.clear-selection();
                                }
                            }

                            // Virtualized day-group headers + card rows
                            for row in LibraryVM.visible-rows: Rectangle {
                                x: 38px;
                                y: row.y * 1px;
                                width: max(0px, parent.width - 76px);
                                height: row.height * 1px;
                                background: transparent;

                                // Group header (kind == 0)
                                if row.kind == 0: HorizontalLayout {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: 22px;

                                    Text {
                                        text: row.header-label;
                                        font-family: Theme.font-display;
                                        font-size: 15px;
                                        font-weight: Theme.font-weight-semibold;
                                        color: Theme.text-hi;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { width: 13px; }

                                    Text {
                                        text: row.header-sub;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-group;
                                        color: Theme.text-faintest;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 22px;

                                        Rectangle {
                                            x: 13px;
                                            y: (parent.height - 1px) / 2;
                                            width: max(0px, parent.width - 26px);
                                            height: 1px;
                                            background: Theme.border-faint;
                                        }
                                    }

                                    Text {
                                        text: row.header-count;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-group;
                                        color: Theme.text-faintest;
                                        vertical-alignment: center;
                                    }
                                }

                                // Card row (kind == 1)
                                if row.kind == 1: Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    background: transparent;

                                    for card[col] in row.cards: LibraryClipTile {
                                        x: col * 268px;
                                        y: 0px;
                                        data: card;
                                        is-selecting: LibraryVM.has-selection;
                                        card-pressed(shift, ctrl) => {
                                            body-focus.focus();
                                            LibraryVM.card-pressed(card.clip-index, shift, ctrl);
                                        }
                                        play-clicked => {
                                            body-focus.focus();
                                            LibraryVM.card-play(card.clip-index);
                                        }
                                        favorite-clicked => {
                                            body-focus.focus();
                                            LibraryVM.card-favorite(card.clip-index);
                                        }
                                        edit-clicked => {
                                            body-focus.focus();
                                            LibraryVM.card-edit(card.clip-index);
                                        }
                                        select-circle-clicked => {
                                            body-focus.focus();
                                            LibraryVM.card-select-circle(card.clip-index);
                                        }
                                        context-menu-requested(ax, ay) => {
                                            body-focus.focus();
                                            root.open-context-menu(card.file-path, card.cloud-state, card.cloud-only, ax, ay);
                                        }
                                    }
                                }
                            }

                            // No-results state (clips exist, filter hides all)
                            if LibraryVM.has-no-results: Text {
                                x: 0px;
                                y: 60px;
                                width: parent.width;
                                text: Tr.t("Library_NoResults", Tr.rev);
                                horizontal-alignment: center;
                                color: Theme.text-faintest;
                                font-family: Theme.font-ui;
                                font-size: 13.5px;
                            }

                            // Empty library state
                            if !LibraryVM.has-clips: VerticalLayout {
                                x: 0px;
                                y: max(40px, (scroll-area.height - self.preferred-height) / 2 + 35px);
                                width: parent.width;
                                height: self.preferred-height;
                                spacing: 14px;
                                alignment: center;

                                HorizontalLayout {
                                    alignment: center;
                                    LagLogoMark {
                                        size: 44px;
                                        stroke: Theme.empty-icon-brush;
                                    }
                                }

                                Text {
                                    text: Tr.t("Library_EmptyTitle", Tr.rev);
                                    font-family: Theme.font-ui;
                                    font-size: 16px;
                                    font-weight: Theme.font-weight-medium;
                                    color: Theme.text-hi;
                                    horizontal-alignment: center;
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        width: min(430px, max(120px, scroll-area.width - 76px));
                                        text: Tr.t("Library_Empty", Tr.rev);
                                        font-family: Theme.font-ui;
                                        font-size: Theme.font-size-body;
                                        color: Theme.text-muted;
                                        wrap: word-wrap;
                                        horizontal-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    padding-top: 2px;
                                    alignment: center;
                                    spacing: 6px;

                                    for part in LibraryVM.hotkey-parts: RKbdChip {
                                        text: part;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Context menu overlay (right-click on card)
    if root.context-menu-open: Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    root.context-menu-open = false;
                }
            }
        }

        LagContextMenuContainer {
            x: root.context-menu-x;
            y: root.context-menu-y;
            width: 220px;
            height: ctx-layout.preferred-height;
            drop-shadow-offset-x: Theme.shadow-flyout-x;
            drop-shadow-offset-y: Theme.shadow-flyout-y;
            drop-shadow-blur: Theme.shadow-flyout-blur;
            drop-shadow-color: Theme.shadow-flyout-color;

            ctx-layout := VerticalLayout {
                width: 100%;
                padding: Theme.menu-flyout-presenter-theme-padding;
                spacing: 2px;

                if !root.context-cloud-only: LagMenuItem {
                    text: Tr.t("Editor_Edit", Tr.rev);
                    has-icon: true;
                    icon: Icons.movie-edit-outline;
                    clicked => {
                        root.context-menu-open = false;
                        LibraryVM.context-edit(root.context-clip-path);
                    }
                }

                if !root.context-cloud-only: LagMenuItem {
                    text: Tr.t("Library_ShowInFolder", Tr.rev);
                    has-icon: true;
                    icon: Icons.folder-search-outline;
                    clicked => {
                        root.context-menu-open = false;
                        LibraryVM.context-show-in-folder(root.context-clip-path);
                    }
                }

                if root.context-cloud-only: LagMenuItem {
                    text: Tr.t("Library_Cloud_SaveLocal", Tr.rev);
                    has-icon: true;
                    icon: Icons.cloud-download-outline;
                    clicked => {
                        root.context-menu-open = false;
                        LibraryVM.context-save-local(root.context-clip-path);
                    }
                }

                if LibraryVM.cloud-connected && root.context-cloud-state == 0: LagMenuItem {
                    text: Tr.t("Library_Cloud_Upload", Tr.rev);
                    has-icon: true;
                    icon: Icons.cloud-upload-outline;
                    clicked => {
                        root.context-menu-open = false;
                        LibraryVM.context-upload(root.context-clip-path);
                    }
                }

                if root.context-cloud-state == 5: LagMenuItem {
                    text: Tr.t("Library_Cloud_Retry", Tr.rev);
                    has-icon: true;
                    icon: Icons.cloud-alert-outline;
                    clicked => {
                        root.context-menu-open = false;
                        LibraryVM.context-retry();
                    }
                }

                if root.context-cloud-state == 1 || root.context-cloud-state == 2: LagMenuItem {
                    text: Tr.t("Library_Cloud_Open", Tr.rev);
                    has-icon: true;
                    icon: Icons.cloud-outline;
                    clicked => {
                        root.context-menu-open = false;
                        LibraryVM.context-open-cloud(root.context-clip-path);
                    }
                }

                LagMenuItem {
                    text: Tr.t("Library_Delete", Tr.rev);
                    has-icon: true;
                    icon: Icons.trash-can-outline;
                    clicked => {
                        root.context-menu-open = false;
                        LibraryVM.context-delete(root.context-clip-path);
                    }
                }
            }
        }
    }

    // Delete: where from (docs/spec/cloud.md §12). Only shown when a clip is also, or only, in the cloud.
    if LibraryVM.delete-dialog-open: Rectangle {
        background: #000000B0;
        TouchArea { }
        Rectangle {
            width: 520px;
            height: del-layout.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.surface-card;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-offset-y: 12px;
            drop-shadow-blur: 40px;
            drop-shadow-color: #00000080;
            del-layout := VerticalLayout {
                padding: 26px;
                spacing: 14px;
                Text {
                    text: Tr.t(LibraryVM.delete-dialog-cloud-only ? "Delete_CloudOnly_Title" : "Delete_Title", Tr.rev);
                    font-size: 18px; font-weight: 700; color: Theme.text-hi; wrap: word-wrap;
                }
                Text {
                    text: Tr.t(LibraryVM.delete-dialog-cloud-only ? "Delete_CloudOnly_Body" : "Delete_Body", Tr.rev);
                    font-size: 13px; color: LibraryVM.delete-dialog-cloud-only ? #E5B84C : Theme.text-mid; wrap: word-wrap;
                }
                if !LibraryVM.delete-dialog-cloud-only: HorizontalLayout {
                    spacing: 8px;
                    LagCheckBox { checked: root.delete-remember; toggled(v) => { root.delete-remember = v; } }
                    Text { text: Tr.t("Delete_Remember", Tr.rev); font-size: 12.5px; color: Theme.text-mid; vertical-alignment: center; }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    RChipButton {
                        text: Tr.t("Editor_CancelExport", Tr.rev);
                        clicked => { root.delete-remember = false; LibraryVM.delete-cancel(); }
                    }
                    if LibraryVM.delete-dialog-mixed: RChipButton {
                        text: Tr.t("Delete_ThisPc", Tr.rev);
                        clicked => { LibraryVM.delete-choose(0, root.delete-remember); root.delete-remember = false; }
                    }
                    RChipButton {
                        text: Tr.t("Delete_Cloud", Tr.rev);
                        clicked => { LibraryVM.delete-choose(1, false); root.delete-remember = false; }
                    }
                    if LibraryVM.delete-dialog-mixed: RChipButton {
                        text: Tr.t("Delete_Everywhere", Tr.rev);
                        danger: true;
                        clicked => { LibraryVM.delete-choose(2, root.delete-remember); root.delete-remember = false; }
                    }
                }
            }
        }
    }
}
