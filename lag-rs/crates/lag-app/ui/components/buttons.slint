// Ported from Components.axaml (Button.rchip) + SettingsView.axaml (.active) + LibraryView.axaml (danger tint)
export component RChipButton {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <length> icon-size: 15px;
    in property <bool> active: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    min-height: 32px;
    opacity: enabled ? 1.0 : 0.45;

    property <bool> pressed: ta.pressed && enabled;
    property <bool> hovered: ta.has-hover && enabled;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.rad-input;
        background: root.active
            ? Theme.accent
            : (root.hovered ? Theme.surface-hover-2 : Theme.surface-input);
        border-width: 1px;
        border-color: root.active ? Theme.accent : Theme.border-strong;
        animate background { duration: Theme.dur-chip; }


        HorizontalLayout {
            padding-left: 15px;
            padding-right: 15px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 7px;
            alignment: center;

            if root.has-icon: VerticalLayout {
                alignment: center;
                MaterialIcon {
                    source: root.icon;
                    size: root.icon-size;
                    tint: root.active ? #FFFFFF : (root.danger ? Theme.danger-stop : Theme.text-hi);
                }
            }

            Text {
                text: root.text;
                color: root.active ? #FFFFFF : (root.danger ? Theme.danger-stop : Theme.text-hi);
                font-family: Theme.font-ui;
                font-size: Theme.font-size-sub;
                font-weight: Theme.font-weight-semibold;
                vertical-alignment: center;
            }
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Ported from LibraryView.axaml (Button.gamechip & .sel)
export component GameChipButton {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> selected: false;
    // Soft edges (library chip row): window x where the chip is fully transparent, fading in over `fade-len`.
    // The chip's own fill, border, icon and text fade - nothing is painted over the page background, so the
    // GTA VI backdrop stays untouched (owner, 2026-11-18: "you can still see squares on the background").
    in property <length> fade-left: -100000px;
    in property <length> fade-right: 100000px;
    in property <length> fade-len: 44px;
    callback clicked();

    property <color> fill-c: root.selected ? Theme.accent-dim : Theme.surface-card;
    property <color> ink-c: root.selected ? Theme.accent-text : (ta.has-hover ? Theme.text-hi : Theme.text-muted);
    animate fill-c { duration: Theme.dur-fast; }

    // visibility (0..1) at window x
    pure function vis(x: length) -> float {
        min(clamp((x - root.fade-left) / root.fade-len, 0, 1), clamp((root.fade-right - x) / root.fade-len, 0, 1))
    }
    // `c` faded per pixel across an element that spans window x0 .. x0 + w: a linear gradient whose stops sit
    // on the fade's corners, so it reproduces the ramp exactly
    pure function masked(c: color, x0: length, w: length) -> brush {
        if (root.vis(x0) >= 1 && root.vis(x0 + w) >= 1 && x0 >= root.fade-left + root.fade-len && x0 + w <= root.fade-right - root.fade-len) {
            return c;
        }
        let ww = max(1px, w);
        let t1 = clamp((root.fade-left - x0) / ww, 0, 1);
        let t2 = clamp((root.fade-left + root.fade-len - x0) / ww, 0, 1);
        let t3 = clamp((root.fade-right - root.fade-len - x0) / ww, 0, 1);
        let t4 = clamp((root.fade-right - x0) / ww, 0, 1);
        @linear-gradient(90deg,
            c.transparentize(1 - root.vis(x0)) 0%,
            c.transparentize(1 - root.vis(x0 + t1 * ww)) t1 * 100%,
            c.transparentize(1 - root.vis(x0 + t2 * ww)) t2 * 100%,
            c.transparentize(1 - root.vis(x0 + t3 * ww)) t3 * 100%,
            c.transparentize(1 - root.vis(x0 + t4 * ww)) t4 * 100%,
            c.transparentize(1 - root.vis(x0 + ww)) 100%)
    }

    chip-bg := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.rad-input;
        background: root.masked(root.fill-c, self.absolute-position.x, self.width);
        border-width: 1px;
        border-color: root.masked(root.selected ? Theme.accent-ring : Theme.border-card, self.absolute-position.x, self.width);


        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 7px;
            padding-bottom: 7px;
            spacing: 6px;
            alignment: center;

            if root.has-icon: VerticalLayout {
                alignment: center;
                chip-icon := MaterialIcon {
                    source: root.icon;
                    size: 14px;
                    tint: root.masked(root.ink-c, self.absolute-position.x, self.width);
                }
            }

            Text {
                text: root.text;
                color: root.masked(root.ink-c, self.absolute-position.x, self.width);
                font-family: Theme.font-ui;
                font-size: Theme.font-size-sub;
                font-weight: Theme.font-weight-medium;
                vertical-alignment: center;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

