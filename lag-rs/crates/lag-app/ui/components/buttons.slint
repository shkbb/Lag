    height: Theme.nav-height;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.rad-control;
        background: root.active
            ? Theme.card-brush
            : (ta.has-hover ? Theme.nav-hover-brush : transparent);
        animate background { duration: Theme.dur-base; }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;

            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    source: root.icon;
                    size: 16px;
                    tint: root.active ? Theme.accent-brush : Theme.fg-2-brush;
