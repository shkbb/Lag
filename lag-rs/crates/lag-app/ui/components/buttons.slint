import { Theme } from "../theme/tokens.slint";
import { MaterialIcon } from "../theme/icons.slint";

// Ported from MainWindow.axaml (Button.tbar-accent)
export component TbarAccentButton {
    in property <string> text;
    in property <bool> recording: false;
    in property <bool> enabled: true;
    callback clicked();

    height: Theme.tbar-height;
    min-width: 120px;
    opacity: enabled ? 1.0 : 0.45;

    property <bool> pressed: ta.pressed && enabled;
    property <bool> hovered: ta.has-hover && enabled;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.rad-button;
        background: root.recording
            ? (root.hovered ? Theme.danger-hover-brush : Theme.danger-brush)
            : (root.hovered ? Theme.cta-hover-brush : Theme.cta-brush);
        animate background { duration: Theme.dur-base; }


        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 9px;
            alignment: center;

            // Idle dot (9x9 circle) vs Recording stop square (10x10 r2 blinking)
            VerticalLayout {
                alignment: center;
                if !root.recording: Rectangle {
                    width: 9px;
                    height: 9px;
                    border-radius: 4.5px;
                    background: Theme.on-accent;
                }
                if root.recording: Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 2px;
                    background: #FFFFFF;
                    opacity: root.recording ? (0.35 + 0.65 * (0.5 + 0.5 * cos(360deg * mod(animation-tick() / Theme.dur-rec-blink, 1)))) : 1.0;
                }
            }

            Text {
                text: root.text;
                color: root.recording ? #FFFFFF : Theme.on-accent;
                font-family: Theme.font-ui;
                font-size: Theme.font-size-cta;
                font-weight: Theme.font-weight-semibold;
                vertical-alignment: center;
            }
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Ported from MainWindow.axaml (Button.tbar)
export component TbarButton {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <length> icon-size: 15px;
    in property <bool> enabled: true;
    callback clicked();

    height: Theme.tbar-height;
    opacity: enabled ? 1.0 : 0.45;

    property <bool> pressed: ta.pressed && enabled;
    property <bool> hovered: ta.has-hover && enabled;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.rad-button;
        background: root.hovered ? Theme.surface-hover : Theme.surface-input;
        border-width: 1px;
        border-color: Theme.border-strong;
        animate background { duration: Theme.dur-base; }


        HorizontalLayout {
            padding-left: 15px;
            padding-right: 15px;
            spacing: 8px;
            alignment: center;

            if root.has-icon: VerticalLayout {
                alignment: center;
                MaterialIcon {
                    source: root.icon;
                    size: root.icon-size;
                    tint: Theme.text-btn;
                }
            }

            Text {
                text: root.text;
                color: Theme.text-btn;
                font-family: Theme.font-ui;
                font-size: Theme.font-size-body;
                font-weight: Theme.font-weight-semibold;
                vertical-alignment: center;
            }
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Ported from MainWindow.axaml (Button.wctl & Button.wctl.close)
export component WindowCtlButton {
    in property <image> icon;
    in property <length> icon-size: 14px;
    in property <bool> is-close: false;
    callback clicked();

    width: Theme.wctl-width;
    height: Theme.wctl-height;

    Rectangle {
        width: 100%;
        height: 100%;
        background: ta.has-hover
            ? (root.is-close ? Theme.danger-close : Theme.border-faint)
            : transparent;
        animate background { duration: Theme.dur-fast; }

        MaterialIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            size: root.icon-size;
            tint: (root.is-close && ta.has-hover) ? #FFFFFF : Theme.text-faint;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Ported from MainWindow.axaml (Button.railitem & .active)
export component RailItemButton {
    in property <string> label;
    in property <image> icon;
    in property <bool> active: false;
    callback clicked();

    width: Theme.rail-item-width;
    height: Theme.rail-item-height;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.rad-pill;
        background: root.active
            ? Theme.accent-dim
            : (ta.has-hover ? Theme.border-faint : transparent);
        animate background { duration: Theme.dur-chip; }

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            HorizontalLayout {
                alignment: center;
                MaterialIcon {
                    source: root.icon;
                    size: 20px;
                    tint: root.active ? Theme.accent : Theme.text-mid;
                }
            }

            HorizontalLayout {
                alignment: center;
                Text {
                    text: root.label;
                    max-width: 56px;
                    max-height: 22px;
                    color: root.active ? Theme.text-hi : Theme.text-mid;
                    font-family: Theme.font-ui;
                    font-size: Theme.font-size-rail;
                    font-weight: Theme.font-weight-medium;
                    horizontal-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

