// Dropdown chevron that turns up/down WITHOUT transform-rotation (owner, 2026-11-17): a rotated child made
// the GPU renderer draw its whole card as a separate layer at 125 % scale, shifting every label of that card
// by a fraction of a pixel while a list was open ("the grid moves and comes alive"; measured on real-window
// GPU snapshots). The two strokes are computed from the angle instead, so nothing is transformed.
export component ChevronIcon {
    in property <bool> up: false;
    in property <brush> tint;
    in property <length> size: 14px;
    width: root.size;
    height: root.size;

    property <angle> a: root.up ? 180deg : 0deg;
    animate a { duration: 180ms; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }

    // chevron-down in a 24 x 24 box: (7, 10) -> (12, 15) -> (17, 10), rotated about (12, 12.5)
    pure function px(x: float, y: float) -> float { return 12 + (x - 12) * cos(root.a) - (y - 12.5) * sin(root.a); }
    pure function py(x: float, y: float) -> float { return 12.5 + (x - 12) * sin(root.a) + (y - 12.5) * cos(root.a); }

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.tint;
        stroke-width: root.size * 2 / 24;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        MoveTo { x: root.px(7, 10); y: root.py(7, 10); }
        LineTo { x: root.px(12, 15); y: root.py(12, 15); }
        LineTo { x: root.px(17, 10); y: root.py(17, 10); }
    }
}
