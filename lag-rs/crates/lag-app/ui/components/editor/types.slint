// Shared data structs for the Editor view and components.
// Mirrors sub-models in ViewModels/EditorViewModel.cs.

export struct EditorClipItem {
    path: string,
    title: string,
    meta: string,
    thumbnail: image,
    has-thumbnail: bool,
    // position in the clip-merge order (1-based), 0 = not picked
    merge-number: int,
}

// one block of the montage strip
export struct EditorSegmentData {
    id: int,
    title: string,
    duration: string,
    // block position and width in the strip (computed in Rust: montage::block_widths)
    x: length,
    w: length,
    thumbnail: image,
    has-thumbnail: bool,
    selected: bool,
}

export struct EditorAudioTrackData {
    stream-index: int,
    name: string,
    volume: int,
    is-muted: bool,
    is-selected: bool,
    start-sec: float,
    end-sec: float,
    clip-duration-sec: float,
}

export struct EditorFilterData {
    name: string,
    preview: image,
    has-preview: bool,
}

export struct EditorCutBand {
    start-sec: float,
    end-sec: float,
    is-pending: bool,
    cut-index: int, // -1 for pending
}

export struct EditorTextOverlayData {
    text: string,
    nx: float,
    ny: float,
    font-percent: int,
    text-color: color,
    hex: string,
    selected: bool,
}

export struct EditorColorSwatch {
    hex: string,
    swatch: color,
}
