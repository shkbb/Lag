// Theme editor (docs/spec/themes.md, phase 4): the theme being edited runs live in the middle (embedded through a
// component factory), a click picks the element under the pointer, the panel on the right changes it, and every
// change is written into the theme's own .slint files. Lag's own window, not themable.
import { Theme } from "theme/tokens.slint";
import { Tr } from "api/globals.slint";
import { RChipButton } from "components/buttons.slint";
import { LagTextInput } from "components/text_input.slint";
import { LagToggleSwitch } from "components/toggle_switch.slint";
import { LagScrollView } from "components/scrollbar.slint";
import { LagComboBox, DropdownLayer, ComboBoxItemData } from "components/combobox.slint";

export struct EditorRect { x: length, y: length, width: length, height: length }

// One property of the selected element. kind: 0 any expression, 1 colour / brush, 2 length, 3 number, 4 on/off,
// 5 text, 6 one of `options`, 7 picture
export struct EditorProp {
    name: string,
    kind: int,
    type-label: string,
    // what the theme's file says now ("" = not set: the element's default)
    value: string,
    bound: bool,
    // kind 6: the values to choose from, and which one the file says (-1: not set, or an expression)
    options: [ComboBoxItemData],
    option-index: int,
    swatch: color,
    // kind 7: the picture the file names (empty when it is not a plain file)
    picture: image,
}

// The element and the ones around it, for the path above the panel
export struct EditorCrumb { label: string, index: int, current: bool }

// One colour of the theme's palette: what shows in the chosen mode. header: the section title on the first
// colour of a section ("" on the others); index: which colour, for set-token
export struct EditorToken { header: string, name: string, value: string, swatch: color, index: int }

component TokenRow {
    in property <EditorToken> token;
    callback set(int, string);
    callback pick-color(int);
    VerticalLayout {
        spacing: 2px;
        if root.token.header != "": Text {
            text: root.token.header;
            color: Theme.text-mid;
            font-size: 11.5px;
            font-weight: 700;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 8px;
            padding-top: 2px;
            padding-bottom: 2px;
            min-height: 34px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 5px;
                    border-width: token-swatch-ta.has-hover ? 2px : 1px;
                    border-color: token-swatch-ta.has-hover ? Theme.accent : Theme.border-strong;
                    background: root.token.swatch;
                    token-swatch-ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick-color(root.token.index); } }
                }
            }
            Text {
                width: 150px;
                text: root.token.name;
                color: Theme.text-hi;
                font-size: 12.5px;
                vertical-alignment: center;
                overflow: elide;
            }
            LagTextInput {
                horizontal-stretch: 1;
                text: root.token.value;
                accepted(t) => { root.set(root.token.index, t); }
            }
        }
    }
}

component PropRow {
    in property <EditorProp> prop;
    callback set(string, string);
    callback reset(string);
    callback pick-color(string);
    callback choose-image(string);
    // a choice from the list (not set or one of the values; an expression stays a text)
    property <bool> listed: root.prop.kind == 6 && (root.prop.option-index >= 0 || root.prop.value == "");
    min-height: 38px;
    HorizontalLayout {
        spacing: 8px;
        padding-top: 3px;
        padding-bottom: 3px;
        VerticalLayout {
            width: 150px;
            alignment: center;
            Text {
                text: root.prop.name;
                color: root.prop.bound ? Theme.text-hi : Theme.text-faint;
                font-size: 12.5px;
                font-weight: root.prop.bound ? 600 : 400;
                overflow: elide;
            }
            Text { text: root.prop.type-label; color: Theme.text-faintest; font-size: 10.5px; overflow: elide; }
        }
        if root.prop.kind == 1: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 5px;
                border-width: swatch-ta.has-hover ? 2px : 1px;
                border-color: swatch-ta.has-hover ? Theme.accent : Theme.border-strong;
                background: root.prop.swatch;
                swatch-ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick-color(root.prop.name); } }
            }
        }
        if root.prop.kind == 7: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border-strong;
                clip: true;
                Image { width: 100%; height: 100%; source: root.prop.picture; image-fit: contain; }
            }
        }
        if root.prop.kind == 4: VerticalLayout {
            alignment: center;
            LagToggleSwitch {
                checked: root.prop.value == "true";
                toggled(v) => { root.set(root.prop.name, v ? "true" : "false"); }
            }
        }
        if root.listed: LagComboBox {
            horizontal-stretch: 1;
            items: root.prop.options;
            selected-index: root.prop.option-index;
            placeholder: Tr.t("ThemeEditor_Default", Tr.rev);
            selected(i) => { root.set(root.prop.name, root.prop.options[i].text); }
        }
        if root.prop.kind != 4 && !root.listed: LagTextInput {
            horizontal-stretch: 1;
            text: root.prop.value;
            accepted(t) => { root.set(root.prop.name, t); }
        }
        if root.prop.kind == 7: RChipButton {
            text: Tr.t("ThemeEditor_Choose", Tr.rev);
            clicked => { root.choose-image(root.prop.name); }
        }
        if root.prop.kind == 4: Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            Text {
                text: "×";
                color: root.prop.bound ? (reset-ta.has-hover ? Theme.text-hi : Theme.text-faint) : transparent;
                font-size: 16px;
                reset-ta := TouchArea { enabled: root.prop.bound; clicked => { root.reset(root.prop.name); } }
            }
        }
    }
}

// The colour picker: saturation / brightness square, hue and opacity strips, the colour as text, the theme's own
// colours. A change is written when the mouse is released (one undo step each), or on Enter in the text.
component ColorPicker inherits Rectangle {
    in property <string> title;
    in-out property <float> hue;
    in-out property <float> sat;
    in-out property <float> val;
    in-out property <float> alpha;
    in property <color> old;
    in property <[EditorToken]> swatches;
    in property <string> hex;
    callback commit(color);
    callback commit-text(string);
    callback commit-ref(int);
    callback close();
    out property <color> current: hsv(root.hue, root.sat, root.val, root.alpha);
    property <string> hovered;
    width: 336px;
    height: col.preferred-height;
    background: Theme.surface-card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.popup-border-brush;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000080;
    // the card itself takes clicks (they do not close it)
    TouchArea { }
    col := VerticalLayout {
        padding: 12px;
        spacing: 10px;
        HorizontalLayout {
            Text { text: root.title; color: Theme.text-hi; font-size: 14px; font-weight: 700; overflow: elide; horizontal-stretch: 1; }
            Text {
                text: "×";
                font-size: 18px;
                color: close-ta.has-hover ? Theme.text-hi : Theme.text-faint;
                close-ta := TouchArea { clicked => { root.close(); } }
            }
        }
        sv := Rectangle {
            height: 180px;
            border-radius: 6px;
            clip: true;
            background: hsv(root.hue, 1, 1);
            Rectangle { background: @linear-gradient(90deg, #FFFFFF 0%, #FFFFFF00 100%); }
            Rectangle { background: @linear-gradient(180deg, #00000000 0%, #000000 100%); }
            Rectangle {
                x: root.sat * parent.width - 7px;
                y: (1 - root.val) * parent.height - 7px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                border-width: 2px;
                border-color: #FFFFFF;
                drop-shadow-blur: 3px;
                drop-shadow-color: #00000099;
            }
            sv-ta := TouchArea {
                mouse-cursor: crosshair;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.sat = clamp(self.mouse-x / self.width, 0, 1);
                        root.val = 1 - clamp(self.mouse-y / self.height, 0, 1);
                    } else if (e.kind == PointerEventKind.up) {
                        root.commit(root.current);
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.sat = clamp(self.mouse-x / self.width, 0, 1);
                        root.val = 1 - clamp(self.mouse-y / self.height, 0, 1);
                    }
                }
            }
        }
        // hue
        Rectangle {
            height: 14px;
            border-radius: 7px;
            background: @linear-gradient(90deg, #FF0000 0%, #FFFF00 16.67%, #00FF00 33.33%, #00FFFF 50%, #0000FF 66.67%, #FF00FF 83.33%, #FF0000 100%);
            Rectangle {
                x: root.hue / 360 * parent.width - 7px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                border-width: 2px;
                border-color: #FFFFFF;
                background: hsv(root.hue, 1, 1);
            }
            TouchArea {
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.hue = clamp(self.mouse-x / self.width, 0, 1) * 360;
                    } else if (e.kind == PointerEventKind.up) {
                        root.commit(root.current);
                    }
                }
                moved => { if (self.pressed) { root.hue = clamp(self.mouse-x / self.width, 0, 1) * 360; } }
            }
        }
        // opacity
        Rectangle {
            height: 14px;
            border-radius: 7px;
            background: #808080;
            Rectangle {
                border-radius: 7px;
                background: @linear-gradient(90deg, hsv(root.hue, root.sat, root.val, 0) 0%, hsv(root.hue, root.sat, root.val, 1) 100%);
            }
            Rectangle {
                x: root.alpha * parent.width - 7px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                border-width: 2px;
                border-color: #FFFFFF;
            }
            TouchArea {
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.alpha = clamp(self.mouse-x / self.width, 0, 1);
                    } else if (e.kind == PointerEventKind.up) {
                        root.commit(root.current);
                    }
                }
                moved => { if (self.pressed) { root.alpha = clamp(self.mouse-x / self.width, 0, 1); } }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            // was / now
            Rectangle {
                width: 64px;
                height: 32px;
                border-radius: 6px;
                clip: true;
                border-width: 1px;
                border-color: Theme.border-strong;
                HorizontalLayout {
                    Rectangle { background: root.old; }
                    Rectangle { background: root.current; }
                }
            }
            LagTextInput {
                horizontal-stretch: 1;
                text: root.hex;
                accepted(t) => { root.commit-text(t); }
            }
        }
        if root.swatches.length > 0: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                Text { text: Tr.t("ThemeEditor_PickerPalette", Tr.rev); color: Theme.text-mid; font-size: 11.5px; font-weight: 700; }
                Text { text: root.hovered; color: Theme.text-faint; font-size: 11.5px; horizontal-alignment: right; horizontal-stretch: 1; overflow: elide; }
            }
            LagScrollView {
                height: 112px;
                content-height: (floor((root.swatches.length - 1) / 11) + 1) * 28px;
                Rectangle {
                    for t[i] in root.swatches: Rectangle {
                        x: mod(i, 11) * 28px;
                        y: floor(i / 11) * 28px;
                        width: 24px;
                        height: 24px;
                        border-radius: 5px;
                        border-width: sw-ta.has-hover ? 2px : 1px;
                        border-color: sw-ta.has-hover ? Theme.accent : Theme.border-strong;
                        background: t.swatch;
                        sw-ta := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => { if (self.has-hover) { root.hovered = t.name; } }
                            clicked => { root.commit-ref(t.index); }
                        }
                    }
                }
            }
        }
    }
}

export component ThemeEditorWindow inherits Window {
    title: "Lag";
    preferred-width: 1640px;
    preferred-height: 960px;
    background: Theme.surface-app;
    default-font-family: Theme.font-ui;

    // the theme, live
    in property <component-factory> canvas;
    // the theme gets the room there is, as Lag's window of that size (not less than this: then it is cut off)
    in property <length> canvas-min-width: 900px;
    in property <length> canvas-min-height: 600px;
    in property <string> theme-name;
    // the page on the canvas (0 settings, 1 library, 2 player, 3 editor), marked in the toolbar
    in-out property <int> current-page: 1;
    // the selected element (canvas coordinates) and what it is
    in property <[EditorRect]> selection;
    in property <string> selected-name;
    in property <string> selected-where;
    in property <[EditorCrumb]> crumbs;
    in property <[EditorProp]> props;
    in property <string> status;
    in property <bool> status-error;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in-out property <string> filter;
    // the right panel: 0 the picked element, 1 the theme's palette
    in-out property <int> tab: 0;
    in property <[EditorToken]> tokens;
    // the theme has Lag's colour modes (then a colour changes in the chosen one only, unless all-modes)
    in property <bool> has-modes;
    in property <string> palette-mode: "dark";
    in property <bool> all-modes;
    in-out property <string> token-filter;
    callback set-token(int, string);
    callback palette-mode-changed(string);
    callback all-modes-changed(bool);
    callback token-filter-changed(string);
    // the colour picker, for an element's property or a palette colour
    in-out property <bool> picker-open;
    in-out property <float> picker-hue;
    in-out property <float> picker-sat;
    in-out property <float> picker-val;
    in-out property <float> picker-alpha;
    in property <color> picker-old;
    in property <string> picker-title;
    in property <[EditorToken]> picker-swatches;
    callback open-picker-prop(string);
    callback open-picker-token(int);
    callback picker-commit(color);
    callback picker-text(string);
    callback picker-ref(int);
    pure callback hex-of(color) -> string;
    // a picture file for an element's `image` property (system dialog); -file: that file (checks)
    callback choose-image(string);
    callback choose-image-file(string, string);
    callback pick(length, length);
    callback set-prop(string, string);
    callback reset-prop(string);
    callback select-crumb(int);
    callback undo();
    callback redo();
    callback page(int);
    callback filter-changed(string);
    // "delete", "duplicate", "up", "down", "add-rect", "add-text"
    callback structure(string);
    // the selected element dragged by (dx, dy)
    callback drag-end(length, length);
    property <length> drag-dx;
    property <length> drag-dy;
    property <bool> dragging;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        // toolbar
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.theme-name; color: Theme.text-hi; font-size: 16px; font-weight: 700; vertical-alignment: center; }
            Rectangle { width: 10px; }
            RChipButton { text: Tr.t("Nav_Library", Tr.rev); active: root.current-page == 1; clicked => { root.page(1); } }
            RChipButton { text: Tr.t("Nav_Player", Tr.rev); active: root.current-page == 2; clicked => { root.page(2); } }
            RChipButton { text: Tr.t("Editor_Title", Tr.rev); active: root.current-page == 3; clicked => { root.page(3); } }
            RChipButton { text: Tr.t("Nav_Settings", Tr.rev); active: root.current-page == 0; clicked => { root.page(0); } }
            Rectangle { horizontal-stretch: 1; }
            RChipButton { text: Tr.t("ThemeEditor_Undo", Tr.rev); enabled: root.can-undo; clicked => { root.undo(); } }
            RChipButton { text: Tr.t("ThemeEditor_Redo", Tr.rev); enabled: root.can-redo; clicked => { root.redo(); } }
        }
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;
            // canvas
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                stage := Rectangle {
                    x: 0px;
                    y: 0px;
                    width: max(parent.width, root.canvas-min-width);
                    height: max(parent.height, root.canvas-min-height);
                    // selection frames of repeats below the theme's window stay out of sight
                    clip: true;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    ComponentContainer {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        component-factory: root.canvas;
                    }
                    // edit mode: a click picks the element under it, a drag moves the selected one
                    TouchArea {
                        moved => {
                            if (self.pressed && root.selected-name != ""
                                && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px || root.dragging)) {
                                root.dragging = true;
                                root.drag-dx = self.mouse-x - self.pressed-x;
                                root.drag-dy = self.mouse-y - self.pressed-y;
                            }
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                                if (root.dragging) {
                                    root.dragging = false;
                                    root.drag-end(root.drag-dx, root.drag-dy);
                                    root.drag-dx = 0;
                                    root.drag-dy = 0;
                                } else {
                                    root.pick(self.pressed-x, self.pressed-y);
                                }
                            }
                        }
                    }
                    for r in root.selection: Rectangle {
                        x: r.x - 2px + (root.dragging ? root.drag-dx : 0);
                        y: r.y - 2px + (root.dragging ? root.drag-dy : 0);
                        width: r.width + 4px;
                        height: r.height + 4px;
                        border-width: 2px;
                        border-color: #3DDCFF;
                        border-radius: 3px;
                    }
                }
            }
            // properties
            Rectangle {
                width: 440px;
                background: Theme.surface-card;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border-card;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 4px;
                        RChipButton { text: Tr.t("ThemeEditor_TabElement", Tr.rev); active: root.tab == 0; clicked => { root.tab = 0; } }
                        RChipButton { text: Tr.t("ThemeEditor_TabPalette", Tr.rev); active: root.tab == 1; clicked => { root.tab = 1; } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.tab == 0: VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;
                    Text {
                        text: root.selected-name == "" ? Tr.t("ThemeEditor_PickHint", Tr.rev) : root.selected-name;
                        color: Theme.text-hi; font-size: 17px; font-weight: 700; wrap: word-wrap;
                    }
                    if root.selected-where != "": Text { text: root.selected-where; color: Theme.text-faint; font-size: 11.5px; }
                    // the element and the ones around it
                    if root.crumbs.length > 1: Flickable {
                        height: 30px;
                        viewport-width: crumb-row.preferred-width;
                        crumb-row := HorizontalLayout {
                            spacing: 4px;
                            for c in root.crumbs: Rectangle {
                                height: 26px;
                                width: crumb-text.preferred-width + 14px;
                                border-radius: 6px;
                                background: c.current ? Theme.accent : (crumb-ta.has-hover ? Theme.surface-hover-2 : Theme.surface-input);
                                crumb-text := Text { text: c.label; color: c.current ? #FFFFFF : Theme.text-mid; font-size: 11.5px; }
                                crumb-ta := TouchArea { clicked => { root.select-crumb(c.index); } }
                            }
                        }
                    }
                    if root.selected-name != "": HorizontalLayout {
                        spacing: 4px;
                        RChipButton { text: "↑"; clicked => { root.structure("up"); } }
                        RChipButton { text: "↓"; clicked => { root.structure("down"); } }
                        RChipButton { text: Tr.t("ThemeEditor_Duplicate", Tr.rev); clicked => { root.structure("duplicate"); } }
                        RChipButton { text: Tr.t("ThemeEditor_Delete", Tr.rev); danger: true; clicked => { root.structure("delete"); } }
                    }
                    if root.selected-name != "": HorizontalLayout {
                        spacing: 4px;
                        RChipButton { text: Tr.t("ThemeEditor_AddRect", Tr.rev); clicked => { root.structure("add-rect"); } }
                        RChipButton { text: Tr.t("ThemeEditor_AddText", Tr.rev); clicked => { root.structure("add-text"); } }
                    }
                    if root.selected-name != "": LagTextInput {
                        text <=> root.filter;
                        placeholder: Tr.t("ThemeEditor_Search", Tr.rev);
                        edited(t) => { root.filter-changed(t); }
                    }
                    LagScrollView {
                        vertical-stretch: 1;
                        content-height: prop-col.preferred-height;
                        prop-col := VerticalLayout {
                            width: parent.width - 12px;
                            spacing: 2px;
                            for p in root.props: PropRow {
                                prop: p;
                                set(n, v) => { root.set-prop(n, v); }
                                reset(n) => { root.reset-prop(n); }
                                pick-color(n) => { root.open-picker-prop(n); }
                                choose-image(n) => { root.choose-image(n); }
                            }
                        }
                    }
                    }
                    if root.tab == 1: VerticalLayout {
                        spacing: 8px;
                        vertical-stretch: 1;
                        if root.has-modes: HorizontalLayout {
                            spacing: 4px;
                            RChipButton { text: Tr.t("Theme_Dark", Tr.rev); active: root.palette-mode == "dark"; clicked => { root.palette-mode-changed("dark"); } }
                            RChipButton { text: Tr.t("Theme_Light", Tr.rev); active: root.palette-mode == "light"; clicked => { root.palette-mode-changed("light"); } }
                            RChipButton { text: Tr.t("Theme_Neon", Tr.rev); active: root.palette-mode == "neon"; clicked => { root.palette-mode-changed("neon"); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.has-modes: HorizontalLayout {
                            spacing: 8px;
                            LagToggleSwitch {
                                checked: root.all-modes;
                                toggled(v) => { root.all-modes-changed(v); }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: root.all-modes ? Tr.t("ThemeEditor_AllModes", Tr.rev) : Tr.t("ThemeEditor_ThisMode", Tr.rev);
                                color: Theme.text-mid;
                                font-size: 11.5px;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }
                        }
                        if root.tokens.length > 0 || root.token-filter != "": LagTextInput {
                            text <=> root.token-filter;
                            placeholder: Tr.t("ThemeEditor_PaletteSearch", Tr.rev);
                            edited(t) => { root.token-filter-changed(t); }
                        }
                        if root.tokens.length == 0 && root.token-filter == "": Text {
                            text: Tr.t("ThemeEditor_PaletteEmpty", Tr.rev);
                            color: Theme.text-faint;
                            font-size: 12.5px;
                            wrap: word-wrap;
                        }
                        LagScrollView {
                            vertical-stretch: 1;
                            content-height: token-col.preferred-height;
                            token-col := VerticalLayout {
                                width: parent.width - 12px;
                                spacing: 4px;
                                for t in root.tokens: TokenRow {
                                    token: t;
                                    set(i, v) => { root.set-token(i, v); }
                                    pick-color(i) => { root.open-picker-token(i); }
                                }
                            }
                        }
                    }
                    if root.status != "": Text {
                        text: root.status;
                        color: root.status-error ? #FF6B6B : Theme.text-faint;
                        font-size: 11.5px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
    // a click outside the picker closes it
    if root.picker-open: TouchArea {
        clicked => { root.picker-open = false; }
    }
    if root.picker-open: ColorPicker {
        x: root.width - 12px - 440px - 12px - self.width;
        y: 56px;
        title: root.picker-title;
        hue <=> root.picker-hue;
        sat <=> root.picker-sat;
        val <=> root.picker-val;
        alpha <=> root.picker-alpha;
        old: root.picker-old;
        swatches: root.picker-swatches;
        hex: root.hex-of(self.current);
        commit(c) => { root.picker-commit(c); }
        commit-text(t) => { root.picker-text(t); }
        commit-ref(i) => { root.picker-ref(i); }
        close => { root.picker-open = false; }
    }
    DropdownLayer { x: 0; y: 0; width: root.width; height: root.height; }
}

